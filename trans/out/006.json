{
 "2400": "해냈네, 주군！\n축하해！",
 "2401": "아아, 고맙다.",
 "2402": "다마 덕분이다.",
 "2403": "에헤헤.",
 "2404": "입에 발린 말 해도\n아무것도 안 나와.",
 "2405": "그래도,",
 "2406": "조금, 기쁘네！",
 "2407": "이것으로\n중앙 전선은 안전하겠지.",
 "2408": "이제 고지에 포진한 아군이\n움직이면……",
 "2409": "우리가 단연 유리해진다.",
 "2410": "응.",
 "2411": "앗, 그 전에……",
 "2412": "어때？",
 "2413": "역시 내 본진에는\n이 깃발이 있어야 제격이지.",
 "2414": "【シ】소지품・둥글게 만 깃발\n을 되돌려 놓았다.【終】",
 "2415": "【心】（【終】【注】진막【終】【心】 쪽은 역시\n쓸모가 없겠군……）【終】",
 "2416": "【シ】소지품・찢어진 진막\n을 버렸다.【終】",
 "2417": "【心】（이 【終】【注】서장【終】【心】은……\n어떻게 할까）【終】",
 "2418": "【心】（버리기는\n망설여지는군……）【終】",
 "2419": "【心】（뭔가 쓸모 있을지 모르니\n갖고 있을까）【終】",
 "2420": "그럼, 주군――",
 "2421": "보고！　보고드립니다！",
 "2422": "적의 습격입니다！",
 "2423": "상당한 수의 적이\n본진으로 쳐올라옵니다！",
 "2424": "당장이라도 본진――",
 "2425": "으윽！",
 "2426": "왜 그러나！　괜찮은가！？",
 "2427": "큭……。\n유시가 여기까지……！",
 "2428": "바로 코앞까지\n적이 다가온 모양이군.",
 "2429": "주군, 내 곁에서\n떨어지면 안 돼！",
 "2430": "아아, 알았다.",
 "2431": "【心】（무서운 기세로\n본진만 노려 오다니……）【終】",
 "2432": "【心】（……이 적은 대체……）【終】",
 "2433": "주군, 조심하십시오！\n적이 본진에――",
 "2434": "으악",
 "2435": "！　주군, 물러나！",
 "2436": "큭",
 "2437": "이시다 미쓰나리……！",
 "2438": "우리 주군 【注】호소카와\n다다오키【終】님의 뜻을 받들어,",
 "2439": "그 목, 받아 가겠다！",
 "2440": "【心】（【終】【注】호소카와【終】【心】……！）【終】",
 "2441": "각오해라！",
 "2442": "주군！　도망쳐！",
 "2443": "으아악！",
 "2444": "주군！　주군！",
 "2445": "아무리 그래도\n너무 실패했잖아！",
 "2446": "이대로라면 분명――",
 "2447": "이시다 공！",
 "2448": "더는 못 따라가겠소！\n나는 물러나겠소！",
 "2449": "이시다 미쓰나리……\n역시 대장 그릇은 아니었군.",
 "2450": "이에야스 토벌",
 "2451": "돕는다는 것은",
 "2452": "적과 아군",
 "2453": "호소카와 가라샤의 보호",
 "2454": "다른 이유",
 "2455": "……공, ……공,",
 "2456": "이시다 공？",
 "2457": "무슨 일이십니까, 이시다 공.",
 "2458": "아니, 실례했습니다.",
 "2459": "【心】（잠시 멍하니 있었나……。\n피곤한 걸까……）【終】",
 "2460": "곧 납시겠습니다.",
 "2461": "잠시만 기다려 주십시오.",
 "2462": "히데요시 님이 돌아가신 지\n2년……。",
 "2463": "도쿠가와 이에야스 일파와\n우리의 대립은,",
 "2464": "이미 돌이킬 수 없는 곳까지\n와 있었다.",
 "2465": "지금 이에야스는……",
 "2466": "「아이즈 정벌」을 위해\n오사카를 떠나 있다.",
 "2467": "히데요시 님 사후, 이에야스의\n행동에 모반의 조짐을 느껴,",
 "2468": "그것을 막고자 군비를 늘린\n아이즈의 우에스기 가문……。",
 "2469": "그 충의의 인물이……。",
 "2470": "도리어 반역 혐의를 받아\n공격당하고 있는 것이다.",
 "2471": "우에스기 공의 충의는 진짜지만\n대의명분은 이에야스 쪽에……。",
 "2472": "이것이야말로 이에야스의 책략.",
 "2473": "도요토미 가문을 위해\n역적을 친다는 것이다.",
 "2474": "대군을 모을 명분을 얻은\n이에야스 밑으로,",
 "2475": "각지에서\n속속 다이묘들이 모여든다.",
 "2476": "이 대군이 그대로 오사카로\n밀려드는 것만은 막아야……！",
 "2477": "어떤 사건으로 근신 중이던\n나는,",
 "2478": "이에야스가 없는 틈을 타\n대항 세력의 거병을 준비했다.",
 "2479": "그런 와중에……",
 "2480": "나는 「어떤 분」의\n밀사에게 불려,",
 "2481": "오사카성에 와 있었다.",
 "2482": "……이시다 미쓰나리,\n부르심을 받고 왔습니다.",
 "2483": "이시다 공,\n잘 와 주었습니다.",
 "2484": "자, 더 가까이 오세요.",
 "2485": "요도 마님.",
 "2486": "요도도노라고 불리기도\n한다.",
 "2487": "히데요시 님의 부인이자\n적자 히데요리 님의 모친.",
 "2488": "히데요시 님 사후,\n아직 어린 히데요리 님을\n받들어",
 "2489": "도요토미 가문 천하의\n상징이 되셨다.",
 "2490": "이대로 이에야스의 전횡을\n두고 보면, 이분은……",
 "2491": "그 무릎 위의 히데요리 님의\n운명은……",
 "2492": "이에야스의 두툼한 손에 잡혀\n제멋대로 휘둘리게 되리라.",
 "2493": "이시다 공……。",
 "2494": "오늘 그대를 은밀히\n부른 것은 다름 아니라,",
 "2495": "그대에게 부탁이 있어서입니다.",
 "2496": "저는 도요토미 가문에\n충성을 맹세한 몸입니다.",
 "2497": "부디\n무엇이든 말씀해 주십시오.",
 "2498": "………………。",
 "2499": "저도 도쿠가와 이에야스 토벌을\n돕게 해 주세요.",
 "2500": "상좌다.",
 "2501": "저 상좌에서 히데요시 님의\n모습이 사라진 지 2년……",
 "2502": "이리도 빨리 도요토미 천하에\n먹구름이 드리울 줄이야……。",
 "2503": "훌륭한 나무 그림이다.",
 "2504": "유명한 화공이\n그린 것이라 한다.",
 "2505": "그만 나무에 정신이 팔려……。",
 "2506": "으음……무슨 생각을\n하는 거냐, 나는！",
 "2507": "다다미다.",
 "2508": "히데요시 님 아래,",
 "2509": "전국의 다이묘가 한자리에\n모였던 곳이 여기였다.",
 "2510": "지금은……나 혼자다.",
 "2511": "도요토미 군을 이끄는\n이에야스를 치시겠다는\n말씀입니까？",
 "2512": "이시다 공……제게\n둘러댈 필요는 없습니다.",
 "2513": "그대가 이에야스를 치려고\n움직이는 것은 알고 있어요.",
 "2514": "그것이 도요토미 가문을 향한\n참된 충의임도 압니다.",
 "2515": "요도 마님……。",
 "2516": "분명 지금 이에야스는\n「도요토미 가문을 위해」",
 "2517": "아이즈의 우에스기 공을\n치려 하고 있지요.",
 "2518": "명목상으로는 이에야스야말로\n도요토미의 충신이겠지요.",
 "2519": "히데요시 님이 돌아가신 뒤\n이에야스의 행동을 보면,",
 "2520": "이것이 대군을 모으기 위한\n책략임은 분명합니다.",
 "2521": "지금까지의 사정을 아는 이는,",
 "2522": "이에야스가 도요토미를\n해하고 천하를 노리는\n자임을 알겠지요.",
 "2523": "한편 사정을 모르는 이에게는,",
 "2524": "이에야스야말로\n도요토미의 충신으로 보일 터.",
 "2525": "그렇기에\n알 수가 없는 것입니다.",
 "2526": "이에야스 밑으로\n달려가는 자들이,",
 "2527": "이에야스의 정체를 알고도\n자기 이익을 위해\n가는 것인지,",
 "2528": "진실로 도요토미 가문을 위해\n충의로 가는 것인지……。",
 "2529": "누가 적이고 누가 아군인지……\n저로서는 헤아릴 수 없어요.",
 "2530": "그래도,",
 "2531": "저는 히데요시 님의 유지……\n무엇보다 히데요리를\n지키고 싶어요.",
 "2532": "제게는 그대의 충의밖에\n의지할 것이 없습니다.",
 "2533": "돕는다 하심은……\n어떤 일을 말씀하십니까？",
 "2534": "……저 같은 여인 하나가\n무엇을 할 수 있겠냐고……。",
 "2535": "의아하게 여기는 것도\n무리는 아니지요.",
 "2536": "아닙니다！\n겨, 결코 그런……。",
 "2537": "괜찮습니다.",
 "2538": "저라도 할 수 있는 일,\n그것을 생각해 보았어요.",
 "2539": "그것이……",
 "2540": "【注】호소카와 다다오키【終】 공의 아내,",
 "2541": "【注】호소카와 가라샤【終】 님의\n보호입니다.",
 "2542": "호소카와 공의 부인을\n보호……말씀입니까？",
 "2543": "……그렇습니다.",
 "2544": "【心】（호소카와 가라샤 님……인가）【終】",
 "2545": "【心】（분명 굉장한 미인……\n이라는 소문을 들은 적 있지）【終】",
 "2546": "예, 옛！",
 "2547": "【心】（딱히 켕기는 것도 없는데\n당황해 버렸다……）【終】",
 "2548": "이시다 공은 알고 있나요？",
 "2549": "많은 다이묘의 처자가,",
 "2550": "이 오사카에서\n빠져나가고 있다는 것을.",
 "2551": "그……렇습니까.",
 "2552": "네.",
 "2553": "그들은 모두 이에야스 편에 선\n다이묘의 처자입니다.",
 "2554": "그것이 의미하는 바는 하나.",
 "2555": "처자를 빼돌린 다이묘는\n이에야스의 정체를 안다……。",
 "2556": "【心】（그렇군……）【終】",
 "2557": "【心】（그 정체를 알고도\n이에야스 편에 서려는 자는,）【終】",
 "2558": "【心】（말하자면 도요토미의 적……）【終】",
 "2559": "【心】（적의 발밑인 오사카에\n처자를 남겨 둘 리 없다）【終】",
 "2560": "호소카와 공은 이에야스와 함께\n아이즈로 향하고 있습니다.",
 "2561": "그런데도 아직\n오사카에 남아 있는 것이,",
 "2562": "호소카와 가라샤 님입니다.",
 "2563": "【心】（호소카와 공은\n적인가, 아군인가……）【終】",
 "2564": "【心】（지금은 아직 모른다,\n는 것인가……）【終】",
 "2565": "호소카와 공은 도요토미\n가신이나 도쿠가와와도\n친분이 깊지요.",
 "2566": "앞으로 호소카와 공이\n도요토미에 충의를 지킬지,",
 "2567": "도쿠가와와의 친분을 택할지로\n정세는 크게 좌우됩니다……。",
 "2568": "호소카와 공의 동향에 따라,",
 "2569": "지금은 형세만 살피고 있는\n다이묘들이,",
 "2570": "일제히 적이……혹은\n아군이 될지도 모릅니다.",
 "2571": "제가 그녀를 보호하면,",
 "2572": "……호소카와 공이 택할 길은\n하나가 됩니다.",
 "2573": "가라샤 님은 인질……\n이라 해도 과언이 아니지요.",
 "2574": "이런 말을 꺼내다니……",
 "2575": "필시 저를\n경멸하겠지요.",
 "2576": "요도 마님……저는……。",
 "2577": "……괜찮습니다, 이시다 공.",
 "2578": "게다가 다른 이유도 있습니다.",
 "2579": "호소카와 공의 부인을 보호할\n다른 이유란 무엇입니까？",
 "2580": "가라샤 님을 폭도의\n손에서 지키기 위함이오.",
 "2581": "앞서 말했듯이,",
 "2582": "호소카와 공의 동향은\n피아 모두에\n큰 의미를 지닙니다.",
 "2583": "아내인 가라샤 님을 이용하려는\n자는 많겠지요.",
 "2584": "……저를 포함해서……。",
 "2585": "문제는\n그 모든 자들이……",
 "2586": "반드시 온건한 생각을\n지닌 것은 아니라는,",
 "2587": "것입니다.",
 "2588": "상황은 이미 절박합니다.",
 "2589": "저는……",
 "2590": "……제 행동을 정당화하려는\n것뿐일지도 모르지요.",
 "2591": "저는 전국의 세상을 살며\n숱한 슬픔을 겪어 왔습니다.",
 "2592": "전국을 사는 자의 숙명……\n이라 하면 그뿐이지만……。",
 "2593": "지금 또 새로운 슬픔이\n생겨날지도 모릅니다……。",
 "2594": "그것을 못 본 척하고\n싶지 않아요.",
 "2595": "가라샤 님 또한 마찬가지로\n고난의 길을 걸어왔지요.",
 "2596": "제 힘으로 그녀를\n비극에서 구할 수 있다면……",
 "2597": "이시다 공,\n【注】호소카와 저택【終】으로 가서,",
 "2598": "오사카성으로 오도록\n【注】설득【終】해 주지 않겠습니까？",
 "2599": "……알겠습니다.",
 "2600": "되도록 빨리\n호소카와 저택으로 가겠습니다.",
 "2601": "고마워요, 이시다 공.",
 "2602": "누가 적이고\n누가 아군인가……군요.",
 "2603": "도요토미 가신 중에도 적은\n나오겠지요.",
 "2604": "고참 맹장들이,",
 "2605": "이시다 공을 험담하는 것은\n알고 있습니다.",
 "2606": "【心】（윽……！）【終】",
 "2607": "히데요시 님은 그대의 총명함을\n인정하시어,",
 "2608": "천하 통일 후\n요직에 앉히셨지요.",
 "2609": "전쟁 없는 세상을\n다스리는 건 「지」,",
 "2610": "히데요시 님은 그리\n확신하셨던 거겠지요.",
 "2611": "……그렇다.",
 "2612": "나 같은 자를 중용한 탓에,",
 "2613": "무로써 천하 통일을\n도운 자들은,",
 "2614": "입지를 잃었다……\n홀대받았다……며 격노했다.",
 "2615": "결국 도요토미 가신단은\n한 덩어리가 아니게 되었고,",
 "2616": "이에야스는\n거기를 크게 파고들었다……。",
 "2617": "이시다 공은 괴로운 처지지요.",
 "2618": "하지만 티끌 하나 없는\n도요토미 가문에의 충의만은,",
 "2619": "누구보다도 강합니다.",
 "2620": "그대라면……",
 "2621": "저는 진심으로 믿고\n의지할 수 있어요.",
 "2622": "그럼, 저는 이만……。",
 "2623": "지금 이에야스는 제게서\n모든 것을 빼앗으려 합니다.",
 "2624": "도요토미의 천하도……\n히데요시 님과의 추억도……",
 "2625": "그리고 내 아들 히데요리까지.",
 "2626": "이시다 공……맹세해 주세요.",
 "2627": "히데요리를, 도요토미를\n지켜 내겠다고.",
 "2628": "그대는……그대만은,",
 "2629": "우리를 저버리지\n말아 주세요……！",
 "2630": "후우……확 피곤하군.",
 "2631": "일단 【注】내 저택【終】으로\n돌아갈까……。",
 "2632": "호소카와 다다오키의 저택",
 "2633": "이시다 미쓰나리의 저택",
 "2634": "무가 저택의 문이다.",
 "2635": "우리 집과 달리 훌륭하군.",
 "2636": "무심코 나와 버렸다……。",
 "2637": "담장이다.",
 "2638": "돌담 위에\n흰 회반죽으로 지었다.",
 "2639": "잘 정비된 길이다.",
 "2640": "지금은 조용하다.",
 "2641": "나무다.",
 "2642": "담장 위까지\n쑥쑥 뻗어 있다.",
 "2643": "말장난할 생각이……\n없지는 않았다.",
 "2644": "멀리 산이 보인다.",
 "2645": "맑게 갠 여름 하늘이다.",
 "2646": "다짜고짜 호소카와 공의\n저택까지 와 봤지만……。",
 "2647": "문이 닫혀 있어서\n들어갈 수 없을 것 같다.",
 "2648": "일단 【注】내 저택【終】으로 돌아갈까.",
 "2649": "문이다.",
 "2650": "꼭 닫혀 있다.",
 "2651": "굉장한 위압감이다.",
 "2652": "뒷문이다.",
 "2653": "뒷문이니 뒤로\n슬쩍 들어가……。",
 "2654": "볼 수도 없는 노릇이지.",
 "2655": "큰 나무다.",
 "2656": "나무 그늘에서 쉬고 싶어진다.",
 "2657": "못 가는 이유",
 "2658": "그것이란 무엇인가",
 "2659": "오, 주군.\n돌아오셨습니까.",
 "2660": "오랜만의 오사카성은\n어땠습니까？\n즐거우셨습니까？",
 "2661": "……즐겁기는커녕……。\n꽤나 신경이 쓰였다.",
 "2662": "뭐, 그렇겠지요.",
 "2663": "그래서 주군은\n무슨 부탁을 받으셨습니까？",
 "2664": "내가 「부탁받은」 걸\n어떻게 알지？",
 "2665": "높으신 분이 사람을 불러들이는\n건 말이죠,",
 "2666": "귀찮은 일을 떠넘길 때라고,",
 "2667": "그렇게 정해져 있으니까요！",
 "2668": "……과연.",
 "2669": "사콘……。\n미안하지만 그 부탁 때문에,",
 "2670": "지금 당장 나가야\n하게 되었다.",
 "2671": "같이 가 주겠나？",
 "2672": "지금 말입니까？",
 "2673": "이거 곤란한데……。",
 "2674": "오오, 그렇지！",
 "2675": "이런 때야말로 그걸……。",
 "2676": "아니, 하지만……。",
 "2677": "【心】（사콘 녀석, 혼자서 뭘\n중얼거리는 거지？）【終】",
 "2678": "툇마루와 정원이다.",
 "2679": "정원에는 닭 두 마리가……\n없군.",
 "2680": "뭐, 독창성 없는\n말장난이군요.",
 "2681": "장지문이다.",
 "2682": "장지를 찢은 사람은\n장지 말고 정직하게 말하자.",
 "2683": "주군, 바보짓도\n쉴 틈이 없으면\n큰일이군요.",
 "2684": "아차, 별로였나.",
 "2685": "도코노마다.",
 "2686": "도코노마, 도코노마……。",
 "2687": "……말장난이 안 떠오르십니까？",
 "2688": "다 꿰뚫어 보는군！",
 "2689": "기둥이 있으니\n기둥대지 말자……。",
 "2690": "……주군의 감각에는\n비틀기라는 게 없군요.",
 "2691": "이럴 때는,",
 "2692": "「기둥 줄 기둥 몰랐다」\n같은 건 어떻습니까？",
 "2693": "！\n뭐지, 이 패배감은……！",
 "2694": "저택에서 먼 곳을 바라보면\n마음이 놓이는군.",
 "2695": "사콘……。\n왜 못 오는 거지？",
 "2696": "아니,\n좀 볼일이 있어서요.",
 "2697": "굳이 제가 같이 안 가도\n괜찮으시잖습니까？",
 "2698": "어린애도 아니고！",
 "2699": "……뭐, 호소카와 공 저택을\n방문할 뿐이니……。",
 "2700": "호오……。",
 "2701": "뭔가？",
 "2702": "주군도 보통이 아니시군요.",
 "2703": "주인이 없는 틈에,",
 "2704": "규방의 유부녀를\n보러 가려는 속셈입니까？",
 "2705": "절대 아니다！",
 "2706": "나는\n요도 마님의 명으로 말이다！",
 "2707": "핫핫핫！\n압니다요！",
 "2708": "주군에게는\n그런 배짱 없으시니까요！",
 "2709": "【心】（단언하니 허무하군……）【終】",
 "2710": "뭐, 그래도,",
 "2711": "호소카와 다다오키의\n부인 집착은 유명하니까요……。",
 "2712": "아무튼 호기심에 부인 모습을\n엿본 정원사를,",
 "2713": "베어 버렸다던가, 아니라던가.",
 "2714": "뭐, 주군도 조심하십쇼.",
 "2715": "나는 베이고 싶지 않다……。",
 "2716": "그러면 역시 그게 필요할지도\n모르겠군……。",
 "2717": "아까부터 말하는 그것이란\n대체 뭔가？",
 "2718": "그렇지, 이참에\n주군께 보여 드리지요.",
 "2719": "잠깐 실례.",
 "2720": "어이, 사콘.",
 "2721": "【心】（정원으로 나갔군）【終】",
 "2722": "어이～, 어디 갔냐！？",
 "2723": "나와라～！",
 "2724": "【心】（지붕을 올려다보거나\n마루 밑을 들여다보고 있다）【終】",
 "2725": "고양이인가！？",
 "2726": "이거 참,\n지금은 없는 모양입니다.",
 "2727": "자……。",
 "2728": "이러고 있을 것도 없으니\n출발 준비나 해 두십쇼.",
 "2729": "그것도\n곧 나타날 겁니다.",
 "2730": "그러니까, 그것이란……？",
 "2731": "핫핫핫！",
 "2732": "고양이 손도 빌리고 싶은\n주군께는 딱이지요.",
 "2733": "【心】（역시 고양이인가……）【終】",
 "2734": "사콘, 마음은 고맙지만……",
 "2735": "호소카와 공의 저택에는\n나 혼자 가겠다.",
 "2736": "아무래도 그것과 함께\n갈 수는 없으니까.",
 "2737": "어, 그렇습니까？",
 "2738": "이런 말 하긴 뭣하지만……",
 "2739": "나름대로\n쓸모 있을 텐데요？",
 "2740": "【心】（설마 가라샤 님을 고양이로\n꾀어낼 수도 없고……）【終】",
 "2741": "뭐, 주군이 그렇다면\n억지로는 안 하겠습니다만……",
 "2742": "찾으면 주군 뒤를 따르라고\n일러두겠습니다.",
 "2743": "꽤 영리한가 보군.",
 "2744": "예？",
 "2745": "뭐, 제 입으로 말하긴\n뭣하지만 나름대로……。",
 "2746": "【心】（……왜 쑥스러워하지？）【終】",
 "2747": "그렇게까지 말한다면\n좋을 대로 해라.",
 "2748": "……알겠습니다.",
 "2749": "……그럼, 저는 슬슬\n실례하겠습니다.",
 "2750": "자, 나도 슬슬……。",
 "2751": "【シ】달칵……【終】",
 "2752": "방금 무슨 소리가\n난 것 같은데……。",
 "2753": "딱히 달라진 것은 없다.",
 "2754": "뭔가 숨을 곳은 없어 보인다.",
 "2755": "방금 뒤에 그림자가\n보인 듯한데……。",
 "2756": "역시 뭔가 있다！",
 "2757": "거기 서라！",
 "2758": "꺅！",
 "2759": "여, 여자아이！？",
 "2760": "갑자기 호통을 쳐서\n깜짝 놀랐잖아！",
 "2761": "바보 아빠가 주군한테 가라고\n해서 왔는데……。",
 "2762": "너는……？",
 "2763": "처음 뵙겠습니다.",
 "2764": "시마 사콘의 딸, 다마키예요！",
 "2765": "따, 딸이라고？",
 "2766": "【心】（아, 안 닮았다……）【終】",
 "2767": "【心】（그 사콘한테서 어떻게……）【終】",
 "2768": "저기, 다마……。",
 "2769": "다마가 아니라\n다마키라니까！",
 "2770": "【心】（고양이로 믿었던 탓인가…）【終】",
 "2771": "【心】（자꾸 다마라고 부르고 싶다）【終】",
 "2772": "사콘에게 뭐라고 들었지？",
 "2773": "음……",
 "2774": "내가 없는 동안,",
 "2775": "주군 돌보는 건 맡긴다, 래！",
 "2776": "바보 아빠한테\n주군 얘기는 들었는데,",
 "2777": "생각했던 것보다……",
 "2778": "아하하……！",
 "2779": "생각보다, 뭐지？",
 "2780": "【心】（이런……앞말 취소다）【終】",
 "2781": "【心】（틀림없이 사콘의 딸이다）【終】",
 "2782": "자, 호소카와 공\n저택으로 갈까.",
 "2783": "자, 주군, 빨리 가자！",
 "2784": "……？",
 "2785": "왠지 이상하네……。",
 "2786": "오가는 사람도 전혀 없고.",
 "2787": "거리가 조용한 건\n전쟁 전이기 때문이겠지.",
 "2788": "이 거리에 사는 다이묘 중에도\n적과 아군으로 갈린다……。",
 "2789": "전장이 멀어도\n다들 경계하고 있겠지.",
 "2790": "어라？",
 "2791": "저 사람, 어디 가는 걸까？",
 "2792": "【心】（시녀로 보이는 사람이\n이런 시국에 혼자서……？）【終】",
 "2793": "가 버렸네.",
 "2794": "아, 저쪽 방향,\n호소카와 저택이 있는 쪽이야.",
 "2795": "사콘에게 들은 이야기",
 "2796": "그런 눈으로 보지 마라！",
 "2797": "……주군은\n늘 그래？",
 "2798": "아차！\n혼잣말로 한 건데……。",
 "2799": "아까 사콘에게서 내 얘기를\n들었다고 했는데……。"
}