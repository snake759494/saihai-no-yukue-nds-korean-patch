{
 "8800": "자네가 내 입장이었다면\n똑같이 행동했을 걸세.",
 "8801": "그러니 이제\n날 신경 쓰지 말게.",
 "8802": "날 구하려고\n병력을 나누지 말게.",
 "8803": "무슨 일이 있어도\n날 위해 움직여선 안 되네.",
 "8804": "벗의 마지막 부탁일세.",
 "8805": "들어주겠지？",
 "8806": "이제 시간이 없네……。",
 "8807": "뒷일을 부탁하네.",
 "8808": "기다려, 요시쓰구！",
 "8809": "요시쓰구우우우！",
 "8810": "과연！\n우리가 오타니대의 배후를\n치면……！",
 "8811": "도쿠가와 님의 승리는 확실！",
 "8812": "……뭐, 그런 겁니다.",
 "8813": "승리하는 날에는,",
 "8814": "도쿠가와 님도 여러분의\n수고에 보답해 주시겠지요.",
 "8815": "그럼！",
 "8816": "자,\n우리도 도쿠가와 님 편에\n서자！",
 "8817": "미안하군,\n오타니 요시쓰구……。",
 "8818": "저런 놈들에게 당하기엔\n당신은 아까운 사람이야……。",
 "8819": "…………하지만.",
 "8820": "이게 내 방식이다.",
 "8821": "용서하란 말은 안 하겠다.\n귀신이 되어 나올 거면\n나와 줘.",
 "8822": "……그때는\n적이고 아군이고 잊고\n얘기나 나누자고.",
 "8823": "보고！",
 "8824": "아군 네 부대가\n적에게 돌아섰습니다！",
 "8825": "게다가 많은 적이\n마쓰오산 기슭에！",
 "8826": "오타니대, 히라쓰카대,\n도다대 응전 중！",
 "8827": "무인의 최후, 똑똑히 보아라！",
 "8828": "히라쓰카대 괴멸！\n와키자카대 철수！",
 "8829": "히라쓰카！\n이놈들……！",
 "8830": "아카자대 철수！",
 "8831": "하지만 도다대도 함께\n전멸한 모양입니다！",
 "8832": "크…………。",
 "8833": "오타니대의 보고는 어찌 됐나！",
 "8834": "요시쓰구는 무사한가！？",
 "8835": "요시쓰구, 보고해 줘……！",
 "8836": "제발……。",
 "8837": "구쓰키, 오가와, 그 밖의\n마쓰오산의 적……\n모두 철수！",
 "8838": "오타니대도 괴멸한 모양입니다！",
 "8839": "그럴 수가……。",
 "8840": "요시쓰구우우우우！",
 "8841": "（아무래도……\n여기까지인 모양이군……）",
 "8842": "（애초에\n죽음을 기다릴 뿐인\n이 목숨……）",
 "8843": "（미쓰나리……자네를 위해\n쓸 수 있어서 만족하네）",
 "8844": "（나의 죽음은\n나 자신이 바란 것……）",
 "8845": "（바라건대 자네는\n자네의 지휘를 계속\n믿어 주게……）",
 "8846": "（……자네 성격으론\n그건 무리겠지……）",
 "8847": "（……자네는 고민하겠지……\n절망할지도 모르지……）",
 "8848": "（……하지만 나는 믿네……）",
 "8849": "（……자네라면 반드시\n스스로 해야 할 일을\n찾아낼 걸세）",
 "8850": "……미쓰나리……。",
 "8851": "……잘 있게……벗이여……。",
 "8852": "서두르다 실패하는 건 알지만\n이제 한계야……。",
 "8853": "미쓰나리, 이제 한계일세.",
 "8854": "자네의 지휘를 끝까지\n믿고 싶었네만……。",
 "8855": "잘 있게……。",
 "8856": "큭……\n요시쓰구가 적에게\n삼켜져 간다……。",
 "8857": "나는\n대체 뭘 하고 있었던\n거냐……。",
 "8858": "현실감이 전혀 없다.",
 "8859": "조금 전의 믿기 힘든 일이\n꿈이라면 얼마나 좋을까……。",
 "8860": "눈을 뜨면\n모두 악몽이었다고……",
 "8861": "역시 이게 현실이구나……。",
 "8862": "나, 주군에게 할 말이――",
 "8863": "보고 받고 계십니까, 주군！",
 "8864": "어차피 말도 안 나올 만큼\n낙심하셨을 테니……",
 "8865": "하다못해 귓구멍이라도\n제대로 열고 들어\n주십시오！",
 "8866": "오타니 님 일은 들었습니다.",
 "8867": "……그래서 주군은\n앞으로 어쩌실 생각입니까？",
 "8868": "벗의 죽음에 절망해서\n모든 걸 내던지시겠습니까？",
 "8869": "모든 걸 없던 일로 하고……\n모든 걸 잊고……",
 "8870": "조금은\n편해질지도 모르겠군요.",
 "8871": "도망쳐 봤자\n아무 의미도 없습니다.",
 "8872": "그러기는커녕……",
 "8873": "오타니 님의 마음을\n짓밟게 됩니다.",
 "8874": "슬퍼하지 말라곤 안 합니다.",
 "8875": "하지만 생각하십시오.\n생각하길 멈추지\n마십시오.",
 "8876": "여기까지 싸워 온 의미……\n앞으로 싸워 갈 이유……",
 "8877": "……오타니 님의 죽음에 대해.",
 "8878": "…………조금이라면 기다리지요.",
 "8879": "생각해서……",
 "8880": "그 지휘봉을 어떻게 휘두를지\n정하면 지시해 주십시오.",
 "8881": "……사콘……。",
 "8882": "【心】（생각하라, 인가……）【終】",
 "8883": "【心】（나는 지금껏 전쟁에 대해\n생각해 본 적이\n있었던가……？）【終】",
 "8884": "【心】（그 의미나 결과를\n생각했던가？）【終】",
 "8885": "【心】（싸움은 사람의 목숨을\n건 것이라는 걸……！）【終】",
 "8886": "【心】（「질 수는 없다」）【終】",
 "8887": "【心】（그런 말을 그저\n무턱대고 되풀이할 뿐……）【終】",
 "8888": "【心】（……나는……）【終】",
 "8889": "【心】（벗이 죽을 가능성마저\n잊고 있었던 게 아닌가！）【終】",
 "8890": "아까 하려던 말",
 "8891": "여기서 도망칠 수는\n없지만……。",
 "8892": "……그래서 어쨌다는 거냐.",
 "8893": "지금이라면 주군이 뭘 말해도\n웃어 주려 했는데！",
 "8894": "그런 위로는 필요 없다……。",
 "8895": "……그뿐이다……。",
 "8896": "이제……아무것도\n안 떠오르는구나.",
 "8897": "……재치 있는 말을\n못 해서 미안하다……。",
 "8898": "……그러고 보니……",
 "8899": "다마, 나한테 할 말이\n있다고 하지 않았나？",
 "8900": "……응, 저기 있지.",
 "8901": "나, 주군에게――",
 "8902": "듣고 있느냐, 미쓰나리！",
 "8903": "얼간이, 겁쟁이, 무기력한\n놈으로 전락하진\n않았겠지！",
 "8904": "오타니 요시쓰구 일은\n유감이었다……。",
 "8905": "아까운 인물을 잃었구나.",
 "8906": "하지만！",
 "8907": "나는\n히데요시 님이\n돌아가셨을 때……",
 "8908": "우키타의 이름에 부끄럽지\n않도록……양자로서\n걸맞도록……",
 "8909": "허리를 꼿꼿이 펴고\n슬픔을 견뎌 냈느니라！",
 "8910": "뭐, 고바야카와나 도도 놈들은\n내가 따끔하게 혼내 주마！",
 "8911": "그러니 미쓰나리……\n너도 똑바로 서거라！",
 "8912": "【心】（우키타 님……설마……\n격려해 준 건가？）【終】",
 "8913": "말해 두겠는데……",
 "8914": "나는 네가 걱정돼서\n이러는 게 아니니라！",
 "8915": "대장으로서의 책무를\n다하라는 것이니라！",
 "8916": "알겠느냐！",
 "8917": "……우키타 님……。",
 "8918": "【心】（대장으로서의 책무……인가）【終】",
 "8919": "【心】（얼마나 무거운 말인지……）【終】",
 "8920": "【心】（……하지만……）【終】",
 "8921": "【心】（사콘……우키타 님……\n내겐 아직 동료가 있다……）【終】",
 "8922": "【心】（요시쓰구……）【終】",
 "8923": "【心】（네가 그 목숨과 바꿔\n만들어 준 시간……）【終】",
 "8924": "【心】（남겨진 동료들을 위해……）【終】",
 "8925": "【心】（그걸 승리로 잇는 것이\n대장의 책무……）【終】",
 "8926": "【心】（그런 거냐, 요시쓰구……？）【終】",
 "8927": "…………주군…………。",
 "8928": "여기서 지휘를 해야 한다.",
 "8929": "이 위기에 나무 따위……\n나무랄 때가 아니다.",
 "8930": "말해 버렸네……。",
 "8931": "과연 깃발을 보는 게\n의미가 있을까……\n깃발 날리며.",
 "8932": "그거 일부러？\n진심？",
 "8933": "…………하하하…………。",
 "8934": "……그래서……",
 "8935": "아까\n다마가 하려던 말 말인데……。",
 "8936": "아, 맞다.\n아까는 말할 기회를\n놓쳤었지.",
 "8937": "그러니까――",
 "8938": "아-, 이시다 님.",
 "8939": "「【注】나옹　쇼레　소브레\n오　레이테　데라마도【終】」",
 "8940": "이외다！",
 "8941": "…………………………네？",
 "8942": "뭐, 서양 말로,",
 "8943": "「일어나 버린 일은\n어쩔 수 없다」",
 "8944": "라는 뜻이지요.",
 "8945": "……오타니 님 일은 나도\n유감으로 생각하오.",
 "8946": "이제 와서 뭘 어쩌든\n일어난 일은 못 바꾸오.",
 "8947": "이시다 님도 언제까지나\n끙끙 앓고 있으면\n안 되오.",
 "8948": "장사 잘하는 이는\n마음 전환도 잘하오.",
 "8949": "오타니 님은\n「승리의 가능성」이라는\n상품을,",
 "8950": "「제 목숨」이라는 대가로\n산 것이오.",
 "8951": "그 상품을 맡은 건\n당신……",
 "8952": "이시다 님이오！",
 "8953": "그 가치를 높이든\n헐값으로 만들든……",
 "8954": "모든 건 앞으로의\n당신 지휘에 달렸소.",
 "8955": "아-, 이것저것 말했지만……",
 "8956": "뭐, 이시다 님은 대장이니,",
 "8957": "떡하니 버티고 있으면\n되오.",
 "8958": "요컨대 허세요！",
 "8959": "……고니시 님……。",
 "8960": "【心】（요시쓰구가 맡긴 것……）【終】",
 "8961": "【心】（그걸 살리든 죽이든\n모두 나 하기 나름……）【終】",
 "8962": "……………………바보로군.",
 "8963": "……………………바보다, 나는.",
 "8964": "요시쓰구가 벌어 준 시간은……",
 "8965": "지금 이 순간에도\n사라져 가고 있지 않나！",
 "8966": "고바야카와 히데아키를 친다！",
 "8967": "모든 걸 잊는다！",
 "8968": "도쿠가와 이에야스를 친다！",
 "8969": "대장의 자리라고도\n할 수 있다.",
 "8970": "신경 쓰지 않을 수 없는\n나무다.",
 "8971": "또 그런다！\n기운 차린 거야！？",
 "8972": "곁에서 봐도 깃발이다……。",
 "8973": "이제 괜찮은 것 같네.",
 "8974": "걱정해서 손해 봤어！",
 "8975": "【心】（이번에야말로 물어보자）【終】",
 "8976": "다마,\n아까 뭘 말하려던 거냐？",
 "8977": "으, 응……。",
 "8978": "이거 주고 싶어서……。",
 "8979": "？　이건 뭐냐？",
 "8980": "오타니 님이 주군에게 쓴\n【注】서장【終】인 것 같아.",
 "8981": "자기한테 만일의 일이\n생기면 주군에게\n전해 달라고,",
 "8982": "전투가 시작되기 전에\n받았었어……。",
 "8983": "읽어 봐.",
 "8984": "……【注】요시쓰구의 서장【終】인가……。",
 "8985": "【心】（【終】【注】사용【終】【心】해서 읽어 볼까）【終】",
 "8986": "「미쓰나리, 자네가\n이걸 읽고 있다는 건……",
 "8987": "내가 죽을 자리를 얻었다는\n것이겠지.",
 "8988": "알겠지만\n슬퍼하는 건 그만두게.",
 "8989": "병을 이기지 못하고\n썩어 갈 뿐이던 목숨을……",
 "8990": "신념이 다하도록\n바칠 기회를 준 것은,",
 "8991": "다름 아닌 미쓰나리……\n자네이니까」",
 "8992": "「서론은 이쯤 하세.",
 "8993": "이제부터 마지막 조언을\n적겠네.",
 "8994": "빗나갔다면\n웃어도 상관없네.",
 "8995": "내가 없어진다는 건……",
 "8996": "고바야카와 히데아키의\n배반이 일어나고,",
 "8997": "내가 그걸 버텨 내지\n못했다는 것이겠지.",
 "8998": "상정할 수 있는\n최악의 사태라고나\n할까.",
 "8999": "아마 병력도 기세도\n적이 훨씬 앞서 있겠지……",
 "9000": "아닌가？",
 "9001": "그리되면 이제\n취할 방법은 하나.",
 "9002": "【注】직접 도쿠가와 이에야스를\n치는【終】 걸세.",
 "9003": "하지만 그건 쉬운 일이\n아닐 걸세.",
 "9004": "아마 몇 겹으로\n두터운 수비가\n깔려 있겠지.",
 "9005": "칠 상대는 이에야스지만\n자네는 【注】시야를\n넓게 가지게【終】.",
 "9006": "한 전국만이 아니라\n【注】여러 전장에\n눈을 돌리는【終】 걸세.",
 "9007": "그리고……",
 "9008": "지금 일만이 아니라 【注】지금껏\n겪은 일에도 주의를\n기울이게【終】.",
 "9009": "어려움에 부딪혀도\n그것이 해결의 열쇠가\n될 걸세.",
 "9010": "우리의 정의를 내일에\n빛내기 위해……부탁하네.",
 "9011": "자네의 지휘가 선명하기를\n바라고 있네」",
 "9012": "【心】（유언의 서장인데도……）【終】",
 "9013": "【心】（여기서도 요시쓰구는……\n승리의 방책을 찾아\n주고 있다）【終】",
 "9014": "이제 슬슬 됐습니까？",
 "9015": "앞으로 어떻게 할지\n들려주시겠습니까？",
 "9016": "고바야카와의 배반 때문에\n요시쓰구는……。",
 "9017": "그러니 그 원수를 갚는다！",
 "9018": "주군……정말 생각하신\n겁니까？",
 "9019": "오타니 님 죽음의 의미를.",
 "9020": "【心】（감정대로 말해 버렸다.\n나는……）【終】",
 "9021": "주군……냉정해지십시오.\n다시 한번 부탁합니다.",
 "9022": "모든 걸 잊고 싶다……。",
 "9023": "나는 이제 더는\n아무도 잃고 싶지 않다！",
 "9024": "사콘이나 우키타 님,\n고니시 님의 목숨이 걸린\n이 지휘는……",
 "9025": "내게는 너무 무겁다！",
 "9026": "정말 괜찮으시겠습니까？\n후회 안 하시겠지요？",
 "9027": "주군이 그렇게 정했다면\n저는 아무 말 안 합니다.",
 "9028": "오타니 님께 받은 목숨,\n하다못해 소중히\n쓰시지요.",
 "9029": "……아니.",
 "9030": "역시 기다려 줘, 사콘.",
 "9031": "알겠습니다.\n중요한 문제니까요.",
 "9032": "그럼 다시 한번\n부탁합니다.",
 "9033": "사콘……역시 우리는\n이 방법을 관철할\n수밖에 없다！",
 "9034": "그걸 위해 요시쓰구는\n시간을 벌어 준 거니까！",
 "9035": "요시쓰구의 죽음은 슬프지만……",
 "9036": "거기 빠져서 요시쓰구가\n남긴 걸 헛되게\n할 순 없다！",
 "9037": "이거야 원……。",
 "9038": "겨우 부활하셨군요.",
 "9039": "그렇습니다.\n주군은 그거면 됩니다.",
 "9040": "끝까지 하고 싶은 일을\n관철하십시오.",
 "9041": "대장답게 당당히,\n가슴을 펴고.",
 "9042": "그러면 저희는\n안심하고 따라갈 수\n있습니다……。",
 "9043": "좀 바보처럼 보여도\n괜찮습니다.",
 "9044": "뭐니 뭐니 해도\n바보시니까요！",
 "9045": "……농담은 이쯤 하고.",
 "9046": "그럼 저는\n이대로 계속 공격하겠습니다.",
 "9047": "대포로 뚫은 구멍이\n막히기 전에 어떻게든……",
 "9048": "이에야스가 있는 곳까지\n닿아 보이겠습니다.",
 "9049": "……이 목숨을 걸고……。",
 "9050": "그럼 상황이 바뀌면\n또 보고하겠습니다.",
 "9051": "……가능하면 이에야스를\n쓰러뜨렸다고 보고하고\n싶군요！",
 "9052": "……부탁한다, 사콘.",
 "9053": "요시쓰구……\n나는 포기하지 않는다.",
 "9054": "포기해 버리면\n네 죽음이 헛되어지니까.",
 "9055": "이제 이 싸움은……",
 "9056": "히데요시 님과의 약속만을\n위한 게 아니다.",
 "9057": "요시쓰구를 위해서도……",
 "9058": "나는 질 수 없다！",
 "9059": "사콘의 보고를 받을 수\n있도록 본진 안으로\n돌아갈까.",
 "9060": "？　다마？",
 "9061": "【心】（또 【終】【注】다마가 없다【終】【心】！）【終】",
 "9062": "【心】（어디로 간 거지？）【終】",
 "9063": "다마를 찾으러 갈까――",
 "9064": "엇갈리면 귀찮다.",
 "9065": "곧 돌아오겠지.",
 "9066": "안 돌아오는데？",
 "9067": "어디로 간 거지……？",
 "9068": "역시\n다마를 찾으러 갈까――",
 "9069": "다마니까.",
 "9070": "곧 돌아오겠지……。",
 "9071": "안 돌아온다……。",
 "9072": "여기서 기다려도 되나？",
 "9073": "여기서 기다려 봤자\n소용없겠군.",
 "9074": "근처를 찾아볼까.",
 "9075": "다마는 없는 것 같군.",
 "9076": "나무 위에 다마가！",
 "9077": "……없다.",
 "9078": "깃발 뒤에 다마가！",
 "9079": "……있을 리 없다.",
 "9080": "요시쓰구가 내게 쓴 서장이다.",
 "9081": "요시쓰구는 자기 죽음을\n예감하고 이걸 다마에게\n맡겼던 모양이다.",
 "9082": "다시 읽으면 눈물이 날 것\n같다. 지금은 읽지\n말아 두자.",
 "9083": "본진 뒤로 와 봤는데……。",
 "9084": "어이, 다마！",
 "9085": "여기에도 없나？",
 "9086": "【シ】부스럭……【終】",
 "9087": "【心】（【終】【注】풀숲【終】【心】에 뭔가？）【終】",
 "9088": "멀리 산줄기가 보인다.",
 "9089": "저 근처는 이부키산……인가？",
 "9090": "이 위에 다마가！",
 "9091": "……없는 것 같다.",
 "9092": "풀이 잘 자라 있다.",
 "9093": "잘 생각해 보면 아무리\n다마라도 숨을 수 없는\n높이로군.",
 "9094": "다마？",
 "9095": "그런 곳에 숨어 있는 거냐？",
 "9096": "【シ】찍！【終】",
 "9097": "찍？",
 "9098": "【シ】…………………찌익！【終】",
 "9099": "너는 다마의 쥐……。",
 "9100": "「【注】우메다이후쿠【終】」냐！",
 "9101": "【シ】찍……【終】",
 "9102": "너 혼자……아니,\n한 마리로 왜 그러냐？",
 "9103": "다마는？",
 "9104": "아, 기다려！",
 "9105": "【注】시마즈대 진지【終】 쪽으로\n가 버렸다……。",
 "9106": "「우메다이후쿠」를 찾으면\n다마를 만날 수 있을지도\n모른다……。",
 "9107": "【心】（설마 적에게 납치된 건\n아니겠지만……）【終】",
 "9108": "【心】（조금 걱정되기 시작했다）【終】",
 "9109": "……아무도 없다.",
 "9110": "시마즈대는 전선에서\n적을 끌어 주고 있을\n터다.",
 "9111": "덕분에 대포를\n옮길 수 있었지만……。",
 "9112": "다마의 모습은 안 보이는군.",
 "9113": "방금 【注】진지 뒤편【終】으로\n뭔가 달려간 것 같은데……。",
 "9114": "진막 뒤에도\n다마는 없는 것 같다.",
 "9115": "……일 텐데, 이번 전투는\n어쩐지 상황이 이상하다.",
 "9116": "상쾌하게 개어 있다.",
 "9117": "허락 없이 진 안에\n들어와 버렸지만……。",
 "9118": "무기다.",
 "9119": "……라고 퉁명스럽게\n말해 봤다.",
 "9120": "【心】（……조금 쓸쓸하다……）【終】",
 "9121": "갑옷 안에 다마가！",
 "9122": "……있으면 놀랄 거다.",
 "9123": "책상 밑에 다마가！",
 "9124": "……있을 리 없다.",
 "9125": "원 안에 십자 문양이\n가운데 그려져 있다.",
 "9126": "취류기가 힘차게\n나부끼고 있다.",
 "9127": "의외로 바람이 센 모양이다.",
 "9128": "아무도 없다……。",
 "9129": "일단 찾아볼까.",
 "9130": "다마！",
 "9131": "다마, 어디 갔어！？",
 "9132": "대답이 없나……。",
 "9133": "【注】나무 옆【終】에서 소리가 났다.",
 "9134": "높은 산이 우뚝 솟아 있다.\n아마 이부키산이다.",
 "9135": "오르고 싶은 마음은\n굴뚝같지만……。",
 "9136": "나무 그늘엔\n이제 아무도 없다.",
 "9137": "풀투성이다.",
 "9138": "풀 그늘에 다마가！",
 "9139": "……없지만 뭔가 있다！",
 "9140": "설마……！",
 "9141": "아앗, 기다려！\n우메다이후쿠！",
 "9142": "…………또 놓쳤다.",
 "9143": "이번엔 어디로 간 거냐？",
 "9144": "바위 그늘에 다마가！",
 "9145": "없다……。",
 "9146": "아무리 그래도\n이 꽃 그늘에 다마가……",
 "9147": "있을 리 없다.",
 "9148": "나무 뒤에 누가 있다……！",
 "9149": "저, 적의 닌자？",
 "9150": "【心】（……설마 다마는……！）【終】",
 "9151": "다마를 어떻게 했나！\n다마는 무사한가？",
 "9152": "다마？\n고양이……말입니까？",
 "9153": "아니, 아니다！\n나와 함께 있던……",
 "9154": "아아, 그 여자아이 말이군요.",
 "9155": "이번엔\n함께가 아니군요.",
 "9156": "너희가 납치한 게\n아니냐？",
 "9157": "아닙니다.",
 "9158": "그렇다면……。\n아-……그, 미안하다.",
 "9159": "【心】（왜\n적에게 사과하고 있지？）【終】",
 "9160": "어머.",
 "9161": "…………여전하시네요.",
 "9162": "【心】（「여전하다」？）【終】",
 "9163": "【心】（전부터 나를 알고 있나？）【終】",
 "9164": "【心】（그보다, 적의 닌자인데\n왜 나를 치려 하지 않지？）【終】",
 "9165": "다마의 행방",
 "9166": "공격할 의지",
 "9167": "아는 사이",
 "9168": "정말로\n다마에 대해선 모르는 거지？",
 "9169": "네.\n죄송하지만……。",
 "9170": "아니, 딱히\n그쪽이 사과할 일은……。",
 "9171": "【心】（뭐지, 이 어색한\n분위기는……）【終】",
 "9172": "나는 적의 대장이다.",
 "9173": "치지 않아도 되나？",
 "9174": "그런 건\n생각도 안 했어요.",
 "9175": "하지만……。",
 "9176": "그렇네요……。\n나와 당신은 적이군요.",
 "9177": "【心】（일단 당장 해를\n끼칠 생각은 없어 보이는군）【終】",
 "9178": "나와 너는 아는 사이냐？",
 "9179": "…………………………………。",
 "9180": "【心】（미, 미묘하게\n뭔가 기대받는 기분이 든다）【終】",
 "9181": "【心】（잘 【終】【注】살펴볼【終】【心】까……）【終】",
 "9182": "얼굴은 가렸으면서\n왜 여기는 안 가리지？",
 "9183": "……이쪽이 움직이기 편해요.",
 "9184": "……왜, 왜 화를 내지？",
 "9185": "긴 머리로군.",
 "9186": "머리카락에 낯익은 데는……\n없다.",
 "9187": "이런 차림으로 괜찮은가？",
 "9188": "닌자니까요……。",
 "9189": "특이한 모양의 두건이군.",
 "9190": "그런 말은\n처음 들었어요……。",
 "9191": "그 비녀……。",
 "9192": "어디서 본 것 같은데.",
 "9193": "역시 기분 탓이군.",
 "9194": "……후우.",
 "9195": "【心】（한숨을 쉬었다！\n왜지……？）【終】",
 "9196": "……너는……。",
 "9197": "【心】（짚이는 데가 없다……）【終】",
 "9198": "【心】（애초에\n얼굴이 가려져 있으니……）【終】",
 "9199": "【心】（내가 아는 사람……인가？）【終】"
}