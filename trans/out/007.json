{
 "2800": "……왜 갑자기 웃는 거지.",
 "2801": "주군 돌보기는 힘들다고,",
 "2802": "바보 아빠가 이런저런\n얘기를……。",
 "2803": "새, 생각나 버려서……。\n웃겨서……。",
 "2804": "됐다.",
 "2805": "호소카와 가라샤에 대해",
 "2806": "호소카와 다다오키에 대해",
 "2807": "이왕이면 좀 더 독창적인\n말을 하면 좋을 텐데……。",
 "2808": "미안하게 됐군……。",
 "2809": "뭐랄까……\n주군은 그걸로 괜찮아？",
 "2810": "별로였나……？",
 "2811": "아무것도 안 떠오른다……。",
 "2812": "뭘 고민했는지는\n묻지 않을게.",
 "2813": "……고맙다.",
 "2814": "뭔가 비틀기가 부족한\n느낌이란 말이지.",
 "2815": "「기둥 줄 기둥 몰랐다」\n같은 건 어때？",
 "2816": "가라샤 님에 대해,",
 "2817": "아는 게 있으면\n알려 주지 않겠나？",
 "2818": "호소카와 가라샤 님은\n미인으로 유명하지만,",
 "2819": "실제로 본 사람은\n적을 거야.",
 "2820": "어째서지？",
 "2821": "가라샤 님의 아버지\n아케치 미쓰히데 님이,",
 "2822": "주군 오다 노부나가\n님을 배신했잖아……",
 "2823": "그 탓에 오랫동안 저택에\n갇혀 있었대.",
 "2824": "용서받은 뒤에도\n별로 나서지 않는대.",
 "2825": "【心】（남의 눈에 띄지 않으니\n소문만 커진 건가……？）【終】",
 "2826": "다마는 호소카와 다다오키\n공에 대해 아나？",
 "2827": "엄청 풍류를 아는 사람이라고\n들었어.",
 "2828": "노래, 춤, 그림,\n그리고 다도……。",
 "2829": "뭐든지 하고, 초일류래.",
 "2830": "주군하고는 딴판이네！",
 "2831": "……미안하게 됐군,\n무뚝뚝해서！",
 "2832": "호소카와 가라샤에 대해 2",
 "2833": "여기가 호소카와 공 저택이야.",
 "2834": "아까 그 시녀다.",
 "2835": "저택 안으로 들어갔어.",
 "2836": "정말이네.",
 "2837": "뭔가 수상해……。",
 "2838": "일단\n들여보내 달라고 하자.",
 "2839": "계세요～！",
 "2840": "이시다 미쓰나리입니다.\n열어 주세요～！",
 "2841": "대답이 없군, 어쩌지？",
 "2842": "【心】（그건 그렇고, 이 아이……）【終】",
 "2843": "【心】（엉겁결에 데려왔는데\n괜찮은 건가？）【終】",
 "2844": "뭐야, 주군？\n사람을 빤히 보고.",
 "2845": "뭐, 살풍경한 저택보다는,",
 "2846": "귀여운 여자애에게 【注】주목【終】하고\n싶은 마음은 알겠지만……。",
 "2847": "왜 말이 없어！",
 "2848": "【心】（사람에게 【終】【注】주목【終】【心】이라……）【終】",
 "2849": "【心】（그러고 보니 늘 경치에만\n【終】【注】주목【終】【心】했었군……）【終】",
 "2850": "【心】（해 봐도 괜찮겠지）【終】",
 "2851": "그건……뭐지？",
 "2852": "이 아이？",
 "2853": "「【注】매실 찹쌀떡【終】」이야.",
 "2854": "뭐야, 쥐인 줄 알았더니\n과자였나.",
 "2855": "아니야！\n이 아이 이름이라고！",
 "2856": "【心】（……그 이름은 좀 어떤가？）【終】",
 "2857": "의외로 가냘프군.",
 "2858": "……주군, 싸움 거는 거야？",
 "2859": "……아니, 그럴 생각은……。",
 "2860": "큰 머리 장식이군.\n어라, 그 모양……？",
 "2861": "따, 딱히 바보 아빠랑\n맞춘 거 아니거든！",
 "2862": "확실히 사콘 옷자락의\n문장과 똑같군.",
 "2863": "그러니까 아니라니까！",
 "2864": "【心】（아버지와 맞춘 게\n그렇게 싫은가？）【終】",
 "2865": "그 머리 모양은……？",
 "2866": "주군, 여자애 머리 모양에\n관심 있어？",
 "2867": "어, 어음……。\n그런 건 아닌데……。",
 "2868": "……주군 눈은 좀\n신기한 느낌이 들어.",
 "2869": "마음속까지 들킬 것 같아서\n무서운 기분이야……。",
 "2870": "그래도……\n뭐랄까……",
 "2871": "마음속까지 「알아준다」는\n안도감도 있어.",
 "2872": "【心】（……이건\n칭찬받는 건가？）【終】",
 "2873": "【心】（그런데 이 아이……\n정말 사콘의 딸인가……？）【終】",
 "2874": "【心】（전혀 【終】【注】얼굴【終】【心】이\n안 닮았는데……）【終】",
 "2875": "【心】（그리고 저 어깨 위의 【終】【注】쥐【終】【心】는\n대체……）【終】",
 "2876": "【心】（응？　저 【終】【注】머리 장식【終】【心】\n모양……）【終】",
 "2877": "그래서, 주군.",
 "2878": "뭔가 하고 싶은 말 있어？",
 "2879": "아까부터 사람을\n빤히 보고 있잖아！",
 "2880": "아아, 아니, 불안해서……。",
 "2881": "괜찮아, 내가 있잖아！",
 "2882": "……아니,\n불안한 건 너인데……。",
 "2883": "그렇게 생각하고 있었다니！",
 "2884": "좋아, 그렇게 말한다면……",
 "2885": "쓸모 있는 걸 보여 줄게！",
 "2886": "기다려！\n뭘 할 셈이냐！？",
 "2887": "지금 이 담을 기어올라서……\n안에서 문 열고 올게！",
 "2888": "잠깐 기다려！",
 "2889": "아니아니,\n그건 곤란하지.",
 "2890": "이제 와서 당황해도\n늦었거든！",
 "2891": "【心】（아까 그 시녀가 나왔다）【終】",
 "2892": "이시다 님, 이시지요.",
 "2893": "……예.",
 "2894": "마님께서 모시라고 하셨습니다.",
 "2895": "뭐어！？",
 "2896": "【心】（가라샤 님이……？）【終】",
 "2897": "훌륭한 문이다.",
 "2898": "주군, 빨리 안으로 들어가자！",
 "2899": "뒷문이니 뒤로 슬쩍 들어가……",
 "2900": "그런 건 아무래도 좋으니까\n빨리 안으로 들어가자！",
 "2901": "다마는 호소카와 가라샤\n님에 대해 아나？",
 "2902": "또 다마라고 했어……。",
 "2903": "아니, 아무것도 아니야.",
 "2904": "호소카와 다다오키에 대해 2",
 "2905": "요도도노의 전언",
 "2906": "가라샤를 설득하다",
 "2907": "아직인가……가라샤 님.",
 "2908": "아까부터 기다리는데\n전혀 안 오네.",
 "2909": "……그렇군.",
 "2910": "뭐, 이렇게 방에 들여 준\n것만으로도 다행이지.",
 "2911": "그렇네.",
 "2912": "남편이 있었으면\n안 들여 줬을 테니까.",
 "2913": "엄청난 애처가라며.",
 "2914": "호소카와 다다오키 공 말이야.",
 "2915": "【心】（……확실히 주인이 없을 때\n다른 남자를 들이다니……）【終】",
 "2916": "【心】（이상한 소문이 날지도\n모르겠군）【終】",
 "2917": "【心】（다마가 있어서\n들여 준 건가？）【終】",
 "2918": "【心】（……사콘 녀석, 그래서\n자기 딸을……）【終】",
 "2919": "그나저나\n낯선 물건이 잔뜩 있네.",
 "2920": "함부로 만지면 안 돼.",
 "2921": "내가 애냐！",
 "2922": "【心】（……그래도 조금\n흥미가 있군）【終】",
 "2923": "【心】（보기만 하면 괜찮겠지）【終】",
 "2924": "두꺼운 서책이다.",
 "2925": "서양의 가르침이 적혀 있다.",
 "2926": "응？",
 "2927": "여기만 유독 많이 읽었군.\n저절로 펼쳐졌다……。",
 "2928": "어디 보자……。",
 "2929": "「【言】시련을 견디는 사람은\n행복합니다【終】」인가.",
 "2930": "꽤 깊은 말이군.",
 "2931": "아～, 주군.",
 "2932": "아는 척했지？",
 "2933": "윽, 날카롭군……。",
 "2934": "여인 모습의 상이다.",
 "2935": "온화한 표정을 짓고 있다.",
 "2936": "우와～.\n이 관음님 모양이 특이해！",
 "2937": "……그건 아닌 것 같은데.",
 "2938": "처마 밑에 새장이 걸려 있다.",
 "2939": "한 쌍일까？",
 "2940": "새 두 마리를 기르고 있다.",
 "2941": "꽃 한 송이 꽂는 꽃병이다.",
 "2942": "기둥에 달려 있다.",
 "2943": "하얀 꽃이다.",
 "2944": "예쁜 꽃이네.",
 "2945": "서양풍 소품이다.",
 "2946": "재에서 좋은 향이 난다.\n아마 향로대일 것이다.",
 "2947": "귀여워！",
 "2948": "얼마쯤 할까……。",
 "2949": "값의 문제인가？",
 "2950": "정원이다.",
 "2951": "높은 담으로 둘러싸여 있다.",
 "2952": "호오～.",
 "2953": "【心】（이 방, 전통 풍류와는\n취향이 동떨어져 있군……）【終】",
 "2954": "【心】（그럼 이 서양풍\n물건들은……）【終】",
 "2955": "【心】（가라샤 님의 취향……\n이라는 건가）【終】",
 "2956": "오래 기다리셨습니다……。",
 "2957": "호소카와 다다오키의\n처입니다……。",
 "2958": "【心】（이 사람이\n호소카와 가라샤 님……）【終】",
 "2959": "【心】（확실히 미인이다……\n하지만……）【終】",
 "2960": "（주군, 주군！\n……이 사람, 백합을\n짊어졌어！）",
 "2961": "（쉿, 지적하면 안 돼！）",
 "2962": "무슨 일이십니까？",
 "2963": "아, 아뇨.\n아무것도 아닙니다.",
 "2964": "그래서 제게\n무슨 용건이신지요？",
 "2965": "그쪽에 관심이 있으신지요？",
 "2966": "그다지……。",
 "2967": "늘 저를\n지켜봐 주신답니다.",
 "2968": "하아……。",
 "2969": "그 두 마리는\n한 쌍입니다……。",
 "2970": "제가 꽂은 꽃입니다……。",
 "2971": "이 저택 밖……아니,\n이 나라 밖에서 온\n향로입니다……。",
 "2972": "의외로 황폐하다.",
 "2973": "손질이 잘 안 된 모양이다.",
 "2974": "정원사가 없어서요……。",
 "2975": "소문이 사실이었나……！？",
 "2976": "요도 마님께서\n당신께 전언이 있습니다.",
 "2977": "오사카성에서 당신을\n보호하고 싶다고 하십니다.",
 "2978": "저, 저기？",
 "2979": "저는 가지 않겠습니다……。",
 "2980": "【心】（말 붙일 틈도 없이\n거절당했다）【終】",
 "2981": "（주군, 침착해）",
 "2982": "（제대로 이유를 설명하면\n수긍해 줄지도 몰라）",
 "2983": "（그렇군.\n【注】설득【終】해 볼까……）",
 "2984": "어찌 요도 마님의 제안을\n거절하십니까？",
 "2985": "저기？",
 "2986": "【心】（안 되겠다.\n이쪽을 보지도 않는다）【終】",
 "2987": "【心】（어떻게 하면……）【終】",
 "2988": "（주군.\n이쪽을 안 봐 준다면）",
 "2989": "（우리가 봐 보는 것도\n좋을지도）",
 "2990": "【心】（본다……？　【終】【注】주목【終】【心】인가……？）【終】",
 "2991": "등 뒤의 백합――",
 "2992": "（웁웁웁……）",
 "2993": "（왜 갑자기\n입을 막는 거야！）",
 "2994": "（아니, 그게 말이다……）",
 "2995": "（잘 들어라, 다마）",
 "2996": "（세상에는 건드려선 안 되는\n곳이라는 게 있는 법이다）",
 "2997": "특이한 무늬의 옷이다.",
 "2998": "손에 백합을 들고 있다.",
 "2999": "백합을 좋아하나？\n등에도――",
 "3000": "（웁웁……）",
 "3001": "（갑자기 입 막지 마！）",
 "3002": "（이쪽 백합은 괜찮지만\n저쪽 백합은 건드리면 안 돼）",
 "3003": "【心】（눈을 내리깔고\n이쪽을 보지 않는다）【終】",
 "3004": "………………………………………。",
 "3005": "【心】（무슨 생각을 하는 걸까）【終】",
 "3006": "【心】（눈을 맞추지 않는\n이유가 있을 텐데……）【終】",
 "3007": "……제 얼굴에\n뭐라도 묻었나요？",
 "3008": "아뇨……。\n【心】（굳이 말하자면 등에……）【終】",
 "3009": "【心】（아무래도\n【終】【注】백합【終】【心】이 신경 쓰이는군……）【終】",
 "3010": "【心】（이런 곳을 봐서는\n얘기를 들어 줄 것\n같지 않다）【終】",
 "3011": "【心】（눈은 입만큼 말한다……）【終】",
 "3012": "【心】（어쨌든 가라샤 님과\n【終】【注】눈을 맞추고 싶다【終】【心】）【終】",
 "3013": "……。",
 "3014": "【心】（방금 한순간 이쪽으로\n시선이 왔나……？）【終】",
 "3015": "（주군……！）",
 "3016": "（아아. 알고 있다）",
 "3017": "가라샤 님,\n제 이야기를 들어 주시겠지요？",
 "3018": "【心】（이 사람은 우리에게\n무관심한 게 아니다！）【終】",
 "3019": "가라샤 님！",
 "3020": "제 이야기를 들어 주십시오！",
 "3021": "이유를 들려주십시오.",
 "3022": "……그것은……。",
 "3023": "【心】（좋아, 대화에 응했다！）【終】",
 "3024": "……반대로 여쭙겠습니다.",
 "3025": "어찌하여 제가 오사카성에\n가야만 하는 것입니까？",
 "3026": "그것은……",
 "3027": "가라샤 님을 보호하는 것은\n무엇을 위해서지？",
 "3028": "「시련을 견디는 사람은\n행복합니다」지요.",
 "3029": "…………그렇습니다.",
 "3030": "시련을 견디고,",
 "3031": "구원을 구하면 언젠가 반드시\n구원받을 때가 옵니다……。",
 "3032": "마음을 굳게 가지세요……。",
 "3033": "에……죄송합니다.",
 "3034": "이제 괜찮습니다.",
 "3035": "……이런……。\n도리어 걱정을 끼쳤군……。",
 "3036": "그것을 보여 줄 말을\n떠올려 보자.",
 "3037": "알고 계십니까？",
 "3038": "지금 【言】성 밑 거리가 고요하고\n오가는 이가 끊긴【終】 것을.",
 "3039": "무슨 말씀인지 모르겠습니다.",
 "3040": "그것이 어찌하여\n오사카성에 갈 이유가 됩니까？",
 "3041": "곧 전쟁이 일어납니다……\n그 전조입니다.",
 "3042": "그렇다면 남편이\n돌아올 때까지,",
 "3043": "이대로 있는 편이\n안전하겠지요……。",
 "3044": "무엇보다……",
 "3045": "이 저택을 나서는 것을\n남편이 허락하지 않으니……。",
 "3046": "하지만 전쟁이 일어납니다！",
 "3047": "여기 있으면 위험합니다！",
 "3048": "「시련을 견디는 사람은\n행복합니다」",
 "3049": "제게 평안을 주는\n서양의 가르침입니다.",
 "3050": "어떤 시련이라도\n저는 견딜 각오입니다.",
 "3051": "큭……。",
 "3052": "……반론할 말이……\n나오지 않는다！",
 "3053": "젠장,\n내가 좀 더 말을 잘했다면……",
 "3054": "사람의 마음을 움직이는 말을\n할 수 있었다면……！",
 "3055": "【心】（다른 사람의, 말……？）【終】",
 "3056": "【心】（이건 가라샤 님만을\n위한 게 아니다）【終】",
 "3057": "【心】（그분의……도요토미를 위해！）【終】",
 "3058": "고맙다, 다마.",
 "3059": "여러 가지\n중요한 걸 떠올렸다……。",
 "3060": "호소카와 가라샤 님！",
 "3061": "제 이야기를……",
 "3062": "아니.",
 "3063": "요도 마님의 말씀을\n들어 주십시오！",
 "3064": "여기 있으면 위험합니다！",
 "3065": "【心】（그렇다）【終】",
 "3066": "【心】（그 말이\n임박한 위험을 보여 준다！）【終】",
 "3067": "……잠깐……。",
 "3068": "이 말은 분명 위험을\n보여 주지만……。",
 "3069": "동시에 내가 하려는\n일이기도 하다.",
 "3070": "가라샤 님의 마음을\n닫게 하지 않을까？",
 "3071": "다른 방법이 있는 동안은\n이 얘기는 안 하는 게 좋다.",
 "3072": "조금 더 돌려서\n다른 방향으로 생각해 보자.",
 "3073": "이것이 실로 실로\n무서운 위험을 보여 줍니다！",
 "3074": "어머, 무서워라……。",
 "3075": "그렇지요！",
 "3076": "제가 무서운 것은\n당신의 억지 주장입니다.",
 "3077": "아……。\n그, 그렇습니까.",
 "3078": "지금 【言】많은 다이묘의 처자가\n오사카를 빠져나가고\n있다【終】 합니다.",
 "3079": "…………이시다 님.",
 "3080": "당신의 말은 조금\n알기 어렵군요.",
 "3081": "죄송합니다.",
 "3082": "이것은 요도 마님께\n들은 이야기라서요.",
 "3083": "이 이야기가 보여 주는 것은\n당신에게 미칠 위험입니다.",
 "3084": "전쟁이 날지도 모른다……\n이건 이해하셨지요？",
 "3085": "예, 예.",
 "3086": "지금 오사카를\n빠져나가는 것은,",
 "3087": "도쿠가와 이에야스 편 다이묘의\n처자라고 합니다.",
 "3088": "당신의 주인 호소카와 공도\n이에야스 편에 있습니다……。",
 "3089": "즉, 전쟁이 다가오면……",
 "3090": "당신에게도 오사카를 떠나야\n할 만큼의 위험이 닥친다……",
 "3091": "그런 말입니다！",
 "3092": "많은 이가 거처를 옮겨\n피하려는 위험을……",
 "3093": "어찌 저택 안에서\n피할 수 있겠습니까！",
 "3094": "그, 그렇지만……",
 "3095": "그것이 대체 어떤 위험이라고\n말씀하시는 겁니까？",
 "3096": "그것을 모르고서는,",
 "3097": "저택 안에서는 피할 수 없다고\n납득할 수 없습니다.",
 "3098": "그 위험은 요도 마님께\n들었다……。",
 "3099": "하지만 그걸 보여 주면……。",
 "3100": "어쩌지……여기서 위험을\n보여 줄 말을 해야 할까？",
 "3101": "말해서는 안 된다……。",
 "3102": "입에 담으면 분명\n가라샤 님은 마음을\n닫는다……。",
 "3103": "하지만, 하지만……！",
 "3104": "설령 어떤 결과를\n가져오더라도……",
 "3105": "거짓말은 못 한다！",
 "3106": "갈 수 있는 데까지 가자！",
 "3107": "그다음은 그때 생각한다！",
 "3108": "가라샤 님, 당신에게 미칠\n위험이란……！",
 "3109": "이것입니다！",
 "3110": "어느 것인지요？",
 "3111": "어, 어음……。",
 "3112": "망설이지 마라, 나！",
 "3113": "곧장 부딪치는 거다！",
 "3114": "당신의 주인 호소카와 공은\n매우 중요한 처지에 있습니다.",
 "3115": "전쟁이 시작되어\n다다오키 공을 얻기\n위해서라면,",
 "3116": "도쿠가와……도요토미……모두\n수단을 가리지 않겠지요.",
 "3117": "어떤 수를 써서라도,",
 "3118": "당신을 【言】인질【終】로 잡으려 할 게\n틀림없습니다！",
 "3119": "【心】（방금 나는 내 목을\n조르는 말을 했군……）【終】",
 "3120": "역시\n그런 것이었군요.",
 "3121": "조금 전 시녀가 남편\n다다오키의 【注】서장【終】을\n가져왔습니다.",
 "3122": "【心】（우리보다 먼저 저택에\n들어간 시녀 말인가……）【終】",
 "3123": "그 【注】서장【終】에는\n이렇게 적혀 있었습니다……。",
 "3124": "「머지않아 이에야스 공과\n미쓰나리 놈의 전쟁이\n시작된다」",
 "3125": "「전쟁이 다가오면 나를\n한편으로 삼으려\n꾀하는 자들이」",
 "3126": "「네 앞에 나타나\n인질이 되라고\n다그칠 것이다」",
 "3127": "아무리 말을 늘어놓아도\n결국 본심이 나왔군요.",
 "3128": "저를 인질로 잡으려고\n여기 오신 것이지요？",
 "3129": "그, 그런……。",
 "3130": "그리고 【注】서장【終】 끝에는\n이렇게 적혀 있었습니다.",
 "3131": "「인질이 되기 전에 아내로서의\n의무를 다하라」고……。",
 "3132": "당신이 저를 억지로\n데려가려 하신다면……",
 "3133": "저는 죽겠습니다……。",
 "3134": "……그것이\n다이묘 아내의 의무이니까요.",
 "3135": "여기서 내가 포기하면……",
 "3136": "다른 누군가가 가라샤 님을\n힘으로 인질 삼으려 하겠지.",
 "3137": "그때야말로\n그녀의 운명은……！",
 "3138": "절대로 포기할 수\n없게 되었다.",
 "3139": "일어날 줄 아는 비극을\n못 본 척할 수 있겠나！",
 "3140": "이것은 내 마음이자\n요도 마님의 마음이다……！",
 "3141": "비극을 못 본 척 못 한다……\n이 말로 그 마음을 보인다！",
 "3142": "이 말을 봐서라도, 부디！",
 "3143": "가여운 분이로군요……。",
 "3144": "구원을 구하지도\n않으시는 겁니까？",
 "3145": "【心】（동정을 받았다！）【終】",
 "3146": "【心】（……이것저것 생각해도\n소용없다）【終】",
 "3147": "【心】（곧장 요도 마님의\n말씀을 부딪치자）【終】",
 "3148": "가라샤 님……",
 "3149": "요도 마님께서는\n이렇게 말씀하셨습니다.",
 "3150": "「【言】나는 전국의 세상에 태어나\n숱한 슬픔을 겪어 왔다【終】」고.",
 "3151": "알고 있습니다.",
 "3152": "하지만 그것은 무가 여인의\n숙명이겠지요.",
 "3153": "그 고난을 견뎌야\n구원이 찾아오니……。",
 "3154": "요도 마님께서는 이어서\n이렇게 말씀하셨습니다.",
 "3155": "「같은 처지인 가라샤 님을\n구하고 싶다」고.",
 "3156": "분명,",
 "3157": "요도 마님의 제안……\n제가 하는 일……",
 "3158": "이것은 당신에게 인질을\n강요하는 것과\n다를 바 없습니다.",
 "3159": "……여기서 거짓은\n말하지 않겠습니다.",
 "3160": "하지만！",
 "3161": "우리의 목적은 무엇보다 먼저\n당신을 보호하는 것입니다.",
 "3162": "다른 자들이 당신을\n궁지에 몰기 전에！",
 "3163": "당신을 보호하고\n전국의 슬픔에서\n구하고 싶다……",
 "3164": "같은\n슬픔을 알기에……。",
 "3165": "이 요도 마님의 마음을……",
 "3166": "알아주실 수 없겠습니까！",
 "3167": "……참으로……\n고마운 말씀이군요.",
 "3168": "그렇다면……！",
 "3169": "…………아니요.",
 "3170": "역시 저는\n이 저택을 떠날 수 없습니다.",
 "3171": "어째서입니까！",
 "3172": "남편이 이 저택에 머물라고……",
 "3173": "인질이 될 바엔 죽으라고……",
 "3174": "그렇게 말하기 때문입니다.",
 "3175": "아내는 남편을 위해서라면\n제 목숨조차 돌보지 않는다……",
 "3176": "그것이 전국의 숙명……\n아니겠습니까.",
 "3177": "숙명이니 받아들인다,\n는 겁니까……。",
 "3178": "그렇다면",
 "3179": "왜 그렇게 슬픈 얼굴을\n하는 겁니까！",
 "3180": "이시다 님, 그리고\n요도 마님의 배려에\n감사드립니다.",
 "3181": "하지만 어떤 숙명이라도,",
 "3182": "저는 받아들이기로\n결심했습니다.",
 "3183": "자, 이제 돌아가 주십시오.",
 "3184": "……알겠습니다……。",
 "3185": "【心】（정말 이대로 떠나도\n되는 걸까……）【終】",
 "3186": "왜 그러십니까, 이시다 님？",
 "3187": "아니요……아니요！",
 "3188": "…………이시다 님……。",
 "3189": "떼를 쓰며 버텨는\n봤지만……。",
 "3190": "내 말도, 요도 마님의 말씀도\n결국 닿지 않았다……。",
 "3191": "쓸 수단이 없다……。",
 "3192": "주군, 힘내！",
 "3193": "주군이라면……\n그 마음속을 보는 눈이라면…",
 "3194": "알 수 있지 않을까.\n그 사람의 정말\n소중한 부분……。",
 "3195": "【心】（방금 한순간……？）【終】",
 "3196": "다다오키 님을 위해서라면……",
 "3197": "저는 어떤 고난도\n견딜 수 있습니다.",
 "3198": "숙명이나 아내의 의무 따위\n아무래도 좋은 일……。",
 "3199": "다다오키 님을 향한 【言】사랑을\n관철하는【終】 것만이 제 소망……。"
}