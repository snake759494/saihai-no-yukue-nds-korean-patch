{
 "5600": "역시로군, 미쓰나리.",
 "5601": "나도 그리 생각하네.",
 "5602": "그럼 자네 지시대로\n부대를 나아가게 하지.",
 "5603": "주군……이걸로 괜찮겠지？",
 "5604": "복병만 막아 버리면\n부대 수에서 앞서는\n우리가 질 리 없다.",
 "5605": "이대로 동쪽 끝까지 가면\n도도대를 몰아붙일 수\n있을 거다.",
 "5606": "【心】（하지만……\n정말 이걸로 끝일까）【終】",
 "5607": "미쓰나리……\n동쪽 끝까지 부대를 보냈네.",
 "5608": "이로써 도도 다카토라를\n몰아붙인 건 틀림없네.",
 "5609": "……하지만……",
 "5610": "여기서 곤란한 일이 생겼네.",
 "5611": "동쪽 끝 숲을 정찰하려고\n닌자를 풀었는데……",
 "5612": "그 【注】보고가\n둘로 갈려 버렸【終】네.",
 "5613": "내가 푼 닌자는 분명\n「한 명」이었네.",
 "5614": "그런데 돌아온 닌자는\n「두 명」.",
 "5615": "게다가 각자 다른\n보고를 하고 있네.",
 "5616": "한 명은……",
 "5617": "……【言】북쪽 숲에 복병의 기척【終】\n……。",
 "5618": "이라 하고,\n다른 한 명은……",
 "5619": "……【言】남쪽 숲에 복병의 기척【終】\n……。",
 "5620": "이라 하고 있네.",
 "5621": "물론 어느 한쪽이 적의\n닌자인 건 틀림없네.",
 "5622": "둘 다 불러서\n추궁해 보았지만……",
 "5623": "「저쪽이 적의 닌자다」라고\n서로 우길 뿐일세.",
 "5624": "아마 이건……",
 "5625": "궁지에 몰린 도도 다카토라가\n【注】꾸민 함정【終】이겠지.",
 "5626": "즉……",
 "5627": "남북 어느 쪽 숲에\n도도 다카토라가 있다！",
 "5628": "하지만 이 보고의 진위를\n잘못 보면 적의 반격을\n받게 되네.",
 "5629": "부탁하네, 미쓰나리.\n지혜를 빌려 주게.",
 "5630": "큰일 났네.",
 "5631": "그래.\n하지만……",
 "5632": "요시쓰구에게서 「지혜를\n빌려 달라」는 말을\n듣다니……。",
 "5633": "주군……살짝 기뻐하고\n있을 때가 아니야.",
 "5634": "아마 이게 마지막 난관……。",
 "5635": "여길 해결하면\n이길 수 있을 거야！",
 "5636": "【心】（라고는 해도……）【終】",
 "5637": "【心】（어떻게 해야 할지\n전혀 모르겠다！）【終】",
 "5638": "주군, 진정해.\n눈이 흔들리고 있어.",
 "5639": "아무튼……\n한번 상황을 정리해 보자.",
 "5640": "요시쓰구가 푼 닌자는\n한 명……",
 "5641": "그런데 돌아온 건 두 명……。",
 "5642": "게다가 각자\n다른 보고를 하고 있다……。",
 "5643": "그러니 어느 한쪽이\n【注】거짓말하는 적의 닌자【終】다.",
 "5644": "응…………。",
 "5645": "거꾸로 말하면 다른 한 명은\n【注】옳은 말을 하는 아군【終】\n이지.",
 "5646": "【言】거짓말하는 적의 닌자【終】와……",
 "5647": "【言】옳은 말을 하는 아군 닌자【終】\n라……",
 "5648": "거기서\n진실을 끌어낼 방법은……。",
 "5649": "무력",
 "5650": "주력",
 "5651": "시력",
 "5652": "상대가 거짓말을 하는가",
 "5653": "상대가 적의 닌자인가",
 "5654": "상대가 어떤 보고를 할까",
 "5655": "두 닌자는 여전히\n같은 말을 되풀이하고 있네.",
 "5656": "한쪽은 「북쪽 숲에\n복병」이라 하고……",
 "5657": "다른 쪽은\n「남쪽 숲에 복병」이라 하네.",
 "5658": "어느 한쪽이 적의 닌자인\n것은 틀림없네.",
 "5659": "그 닌자가\n거짓말을 하는 것이지.",
 "5660": "하지만 어느 쪽이 그 닌자인지\n판단할 재료가 없네.",
 "5661": "…………아니.",
 "5662": "어느 쪽이 적의 닌자인지\n알 필요는 없는가.",
 "5663": "내가 알고 싶은 건\n적이 어느 숲에 있는가……",
 "5664": "그것뿐일세.",
 "5665": "【注】닌자를 가려낼 필요는\n없네【終】.",
 "5666": "그걸 잊지 말게.",
 "5667": "우리 주위에는\n적의 기척이 없습니다.",
 "5668": "하지만 오타니 님이 앞의\n상황을 알려 주셔야\n움직일 수 있습니다.",
 "5669": "아직 오타니 님에게서\n앞쪽이 안전하다는 보고가\n없습니다.",
 "5670": "움직이지 않는 편이\n좋겠지요.",
 "5671": "왜\n도다 님한테 전령을 보내？",
 "5672": "지금 그런 걸 할 때야？",
 "5673": "그 지시에\n무슨 의미가 있습니까？",
 "5674": "이미 적은\n궁지에 몰려 있습니다.",
 "5675": "굳이 매복할 의미를\n모르겠군요！",
 "5676": "지금으로선\n적의 닌자를 찾을 방도가\n없다……。",
 "5677": "여기선 일단 무시하는\n방향으로！",
 "5678": "……차라리 꾸짖어 줘.",
 "5679": "적의 닌자를 가려내기 위해\n닌자끼리 겨루게 하자！",
 "5680": "…………호오.",
 "5681": "그래서 닌자를 어떤 식으로\n겨루게 한다는 건가？",
 "5682": "당연히 무력……싸움이다！",
 "5683": "이겨서 살아남은 쪽이야말로\n옳은 말을 하는 닌자！",
 "5684": "미쓰나리.\n농담이라기엔 도가 지나치네.",
 "5685": "미, 미안하다……。",
 "5686": "그건 주력……\n발의 빠르기다！",
 "5687": "그걸로 무엇을 알 수\n있단 건가？",
 "5688": "설마 발이 빠른 쪽이\n뛰어난 닌자이고,",
 "5689": "그 보고를 믿을 수 있다고\n말할 셈은 아니겠지.",
 "5690": "어……어떻게 그걸……。",
 "5691": "닌자의 우수함은\n지금 상관없네.",
 "5692": "문제는\n어느 숲에 적이 있는가……",
 "5693": "그것뿐일세.",
 "5694": "그건 시력……\n눈이 좋은 것이다！",
 "5695": "시력 좋은 닌자의 보고야말로\n믿을 수 있다！",
 "5696": "내 이야기를 듣지 않았나？",
 "5697": "내가 푼 닌자는\n「한 명」일세. 다른\n한 명은 적이라고？",
 "5698": "만약 적의 닌자 시력이\n좋다면 그걸 믿을 텐가？",
 "5699": "미안하다！",
 "5700": "진실된 보고를 알기 위해\n닌자에게 질문을 해 줘！",
 "5701": "그래서 닌자에게\n어떤 질문을 하면 되나？",
 "5702": "닌자들에게 상대가 거짓말을\n하고 있는지 물어봐 줘.",
 "5703": "…………알겠네.",
 "5704": "「나는 거짓말을 안 하니\n상대가 하는 것이다」",
 "5705": "똑같은 대답일세.",
 "5706": "여기서 어떻게 진실을\n끌어낸다는 건가？",
 "5707": "미안하다……\n조금 물어보고 싶었을\n뿐이다.",
 "5708": "주군……좀 더 생각하고\n질문하자.",
 "5709": "뭘 알고 싶은지\n잊으면 안 돼.",
 "5710": "닌자들에게 상대가 적의\n닌자인지 물어봐 줘.",
 "5711": "「나는 적의 닌자가 아니니\n상대가 적의 닌자다！」",
 "5712": "이것이 어떻게\n진실로 이어진다는 건가？",
 "5713": "노림수는 나쁘지 않다고\n생각했는데……。",
 "5714": "어느 쪽이 적인지가\n중요할까……。",
 "5715": "알고 싶은 건 좀 다른 거\n같은데……。",
 "5716": "닌자들에게 상대가 어떤\n보고를 할지 물어봐 줘！",
 "5717": "「북쪽 숲에 적이 있다」",
 "5718": "역시 【注】적의 복병은 북쪽에\n있다【終】는 뜻일까？",
 "5719": "그렇다！",
 "5720": "닌자들이 입을 모아 말하니\n틀림없다！",
 "5721": "도도 다카토라는\n북쪽 숲에 있다！",
 "5722": "그럼 북쪽 숲으로 가 볼까.",
 "5723": "이거 놀랍군.",
 "5724": "이런 간단한 계책에\n걸려들어 주다니.",
 "5725": "잘 가라, 오타니 요시쓰구！",
 "5726": "요, 요시쓰구――！",
 "5727": "【心】（뭐……뭐지, 방금 그건）【終】",
 "5728": "왜 그러나, 미쓰나리？",
 "5729": "이대로\n북쪽 숲으로 가도 되겠나？",
 "5730": "아, 아니, 안 된다！",
 "5731": "방금 건 취소다！",
 "5732": "아니.\n【注】북쪽엔 복병이 없다【終】……。",
 "5733": "그게\n방금 증명되었다.",
 "5734": "적의 복병이 있는 건\n【注】남쪽 숲【終】이다！",
 "5735": "적의 수하는 거짓말을 하고,",
 "5736": "아군 닌자는 옳은 말을 한다.",
 "5737": "이를 전제로……",
 "5738": "서로가 어떻게 보고할지\n대답하게 해 본 거다.",
 "5739": "그러면\n어떻게 되느냐……。",
 "5740": "적의 닌자는\n아군 닌자가 답할 진실을……",
 "5741": "【注】거짓으로 바꿔【終】 답한다.",
 "5742": "왜냐하면\n적의 닌자는 【注】거짓말을\n하니까【終】.",
 "5743": "반대로 아군 닌자는\n적의 닌자가 답할 거짓을……",
 "5744": "정직하게 【注】거짓 그대로【終】\n답한다.",
 "5745": "왜냐하면\n아군 닌자는 【注】진실을\n말하니까【終】.",
 "5746": "어느 닌자가 답하든\n【注】나오는 답은 거짓【終】！",
 "5747": "그렇기에,",
 "5748": "【注】그 반대가 진실이 된다【終】！",
 "5749": "대단해, 주군！",
 "5750": "그 결론에 잘 다다라\n주었군.",
 "5751": "…………요시쓰구.",
 "5752": "너, 혹시……\n답을 알고 있었지？",
 "5753": "자, 미쓰나리.\n마지막 전령을 내게！",
 "5754": "미쓰나리……。\n이제 와서 보고가 필요한가？",
 "5755": "적은 남쪽 숲에 있다……",
 "5756": "그렇게 결론 낸 건 자네일세.",
 "5757": "자, 마지막 전령을 내게.",
 "5758": "에……적의 위치는\n알아냈다고 들었습니다만.",
 "5759": "그래도 보고가 필요합니까？",
 "5760": "이제 신호만 주시면\n공격하겠습니다.",
 "5761": "전군에 전령！",
 "5762": "요시쓰구……도다대……\n양쪽에 전령이다！",
 "5763": "북쪽 숲을 공격하라！",
 "5764": "부탁이네……\n잘못 들은 것이길！",
 "5765": "미쓰나리……\n「북쪽 숲」이라 했나？",
 "5766": "하……하하하하하……。",
 "5767": "매복을 실행하라！",
 "5768": "【心】（모두가 못 들은 척\n해 준 것 같다……）【終】",
 "5769": "남쪽 숲을 공격하라！",
 "5770": "쳇……！",
 "5771": "별로\n시간 벌이도 안 됐나.",
 "5772": "뭐, 됐어.\n……목적은 이뤘겠지.",
 "5773": "그럼 이만, 오타니 요시쓰구.\n꽤 즐거웠다고.",
 "5774": "가능하면 한 판 더\n하고 싶은데.",
 "5775": "……후.",
 "5776": "만만찮은 사내로군,\n도도 다카토라.",
 "5777": "나도 재대결을\n기대하고 있지.",
 "5778": "…………목숨이 붙어 있다면.",
 "5779": "돌아왔나……。",
 "5780": "너한테 물어볼 게 있어서.",
 "5781": "잠깐 얼굴 좀 빌리자.",
 "5782": "시마즈 도요히사에게서 받은\n서찰……어디 뒀지？",
 "5783": "…………그건…………",
 "5784": "떨어뜨렸다고？",
 "5785": "이시다 미쓰나리 눈앞에서？",
 "5786": "그 서찰을 회수했다면\n시마즈 공작은 완벽했다……。",
 "5787": "원군이 올 일도 없고\n질 일도 없었어……。",
 "5788": "…………잊지 마라.",
 "5789": "닌자의 배신은……",
 "5790": "곧, 죽음이다.",
 "5791": "뭐, 됐어.",
 "5792": "오타니 요시쓰구를 전선으로\n끌어내는 데는 성공했다.",
 "5793": "이걸로 그 녀석도\n움직이기 쉬워지겠지.",
 "5794": "신호를 보내라.",
 "5795": "【シ】타다당【終】\n【シ】타다당【終】",
 "5796": "저, 적의 총격입니다.",
 "5797": "유독 저희 고바야카와를\n향해 쏘고 있습니다！",
 "5798": "당황할 것 없습니다.\n저건 신호입니다.",
 "5799": "예？　신호 말입니까？",
 "5800": "하지만 저건 적 쪽에서――",
 "5801": "시끄럽네！",
 "5802": "신호라고 했잖아！",
 "5803": "！！！",
 "5804": "지금 최고로 기분이\n좋거든요.",
 "5805": "방해하지 말아 주세요.",
 "5806": "……승리를 눈앞에 두고……",
 "5807": "그 승리를 위한 비장의 패가\n이빨을 드러낸다……",
 "5808": "경악하겠지요……",
 "5809": "절망하겠지요……",
 "5810": "후후……",
 "5811": "후후후후……",
 "5812": "아하하하하하하하하하핫",
 "5813": "최－고다！",
 "5814": "최고의 무대가 시작된다！",
 "5815": "고바야카와대,\n총 1만 5천……\n진군 개시！",
 "5816": "이와 같이……",
 "5817": "「세키가하라 전투」는\n큰 전환점을\n맞이하게 되지요.",
 "5818": "이제부터 싸움은\n격화일로를 걷습니다.",
 "5819": "사람들의 마음은 목숨 걸고\n관철되며 격렬히\n불꽃을 튀기지요.",
 "5820": "그런 가운데\n이시다 미쓰나리의 운명은……\n마음은……",
 "5821": "어떤 길을\n걷게 될까요……。",
 "5822": "미쓰나리……\n상황이 매우 힘들어졌네.",
 "5823": "너무 수세에 몰린 탓에\n병사의 사기가 떨어졌네.",
 "5824": "「미쓰나리에겐　과분한 게\n둘 있으니　시마 사콘과\n사와야마성」",
 "5825": "이런 풍자 노래가\n있습니다.",
 "5826": "희대의 전술가로 이름난\n시마 사콘……",
 "5827": "그 재주에 비해 주군인\n미쓰나리의 그릇은\n어울리지 않는다……",
 "5828": "그런 노래입니다.",
 "5829": "그것이 진실인지 아닌지,",
 "5830": "당사자들 말고 누가\n알 수 있겠습니까.",
 "5831": "눈에 보이는 사실은\n단 하나……",
 "5832": "주군을 위해 시마 사콘은\n목숨을 걸고 싸우고\n있다는 것이지요……。",
 "5833": "그리고 또 한 사람……",
 "5834": "이시다 미쓰나리를 위해\n목숨을 불태우려는\n인물이 있습니다.",
 "5835": "병으로\n이미 두 눈의 빛을 잃고도,",
 "5836": "벗을 위해 「세키가하라」에\n선 의로운 장수……",
 "5837": "그 이름을\n오타니 요시쓰구라 합니다.",
 "5838": "보이지 않기에\n보이는 것이 있지요.",
 "5839": "전장에 흐르는 불온한\n공기를 느끼고,",
 "5840": "온갖 지략을 기울여\n위기를 막으려 하고 있습니다.",
 "5841": "시마 사콘……",
 "5842": "그리고",
 "5843": "모두 천하에 이름난 명장.",
 "5844": "이시다 미쓰나리에게\n마음이 움직인 자들……。",
 "5845": "그럼\n다시 이야기를 시작하지요.",
 "5846": "역풍이 몰아치는 그 땅……",
 "5847": "「세키가하라」의 이야기를.",
 "5848": "……아버님.",
 "5849": "이런 곳으로\n저를 부르시다니……",
 "5850": "무슨 용무이신지요？",
 "5851": "……이봐, 다마키.",
 "5852": "제발\n그 말투는 그만둬라.",
 "5853": "이거 원……。\n……뭐, 됐다.",
 "5854": "도쿠가와 이에야스가\n움직였다.",
 "5855": "지금까지는 안전한\n후방에서 대기했지만……",
 "5856": "세키가하라 중앙으로\n본대를 진군시킨 모양이다.",
 "5857": "우리가 예상 이상으로\n버티니 애가 탄 건지도\n모르지.",
 "5858": "이에야스에게 다가갈 수\n있을지……",
 "5859": "나는 이제부터 한번\n공세를 걸어 보겠다.",
 "5860": "……그게 용무입니까？",
 "5861": "그런 이야기라면\n직접 주군께 하셔야죠？",
 "5862": "……주군과 얼굴을 마주할\n생각은 없다.",
 "5863": "그 바보 주군은 내가\n얼굴을 비추면 나한테\n기대려 할 테지.",
 "5864": "……그럼 전령으로\n끝내셔도 되지 않았나요？",
 "5865": "용무는 그것뿐입니까,\n아버님？",
 "5866": "그럼 저는\n이만 실례하겠습니다.",
 "5867": "……그 어깨……\n왜 그러세요？",
 "5868": "？　무슨 소리냐？",
 "5869": "…………………………아뇨.",
 "5870": "실례합니다.",
 "5871": "…………갔나…………。",
 "5872": "큭……하아……하아……。",
 "5873": "（구로다 철포대에\n맞은 상처……\n생각보다 깊다）",
 "5874": "（다 숨기지 못했나……？）",
 "5875": "…………젠장…………！",
 "5876": "바보냐……나는……。",
 "5877": "「목숨 건 싸움 전에\n딸 얼굴을 보러 왔다」",
 "5878": "그 한마디를\n왜 못 하는 거냐……！",
 "5879": "……훗……\n말할 수 있을 리 없지.",
 "5880": "그런……",
 "5881": "그런 낯간지러운 대사……。",
 "5882": "개전 직후 우키타대의 분전……\n이은 고니시대, 시마즈대의\n활약으로,",
 "5883": "우리는\n싸움을 유리하게 이끌었다.",
 "5884": "중앙 전선은 유지하고 있다.",
 "5885": "여기서 고지에 펼친 모리대……\n그리고 고바야카와대가\n움직이면……",
 "5886": "승리는 우리 것！",
 "5887": "……그럴 터였다.",
 "5888": "하지만 아무리 신호를 보내도,",
 "5889": "모리대는\n돌처럼 침묵한 채……",
 "5890": "고바야카와대 또한\n산꼭대기에서 꿈쩍도 않고……",
 "5891": "전황은 그대로\n교착 상태가 이어지고 있다.",
 "5892": "사콘과 요시쓰구의 분투로\n아직 우리 우세는\n흔들리지 않는다.",
 "5893": "도도 다카토라를 물리쳐\n요시쓰구의 전선에도\n여유가 생겼군.",
 "5894": "전투 중에도\n봉화를 계속 올렸지만……",
 "5895": "여전히 모리대가 움직일\n기색은 없는 듯하다……。",
 "5896": "고바야카와대 쪽도 아직\n움직였다는 보고는 없다.",
 "5897": "고바야카와 님은 시마즈대\n의심이 풀리면 움직이겠다고\n했었지.",
 "5898": "모처럼\n시마즈의 의심을 풀었는데……",
 "5899": "아까 전투 전에는\n만날 수 없었으니까.",
 "5900": "다시 한 번\n찾아가 봐야 할까.",
 "5901": "……어떻게 생각해, 다마？",
 "5902": "…………다마？",
 "5903": "【心】（어쩐지 허전하다 했더니……）【終】",
 "5904": "【心】（【終】【注】다마가 없다【終】【心】）【終】",
 "5905": "【心】（이럴 때\n어디 간 거지？）【終】",
 "5906": "이 안에 다마는 없었다.",
 "5907": "모두가 한 사람을 위해,\n한 사람이 모두를 위해\n산다면……。",
 "5908": "그것이 나의 이상이다.",
 "5909": "저 나무……\n별로 신경 쓰이지 않는다.",
 "5910": "아마 저 나무 위에\n다마는 없다.",
 "5911": "앞으로의 일을\n다마와 상의하고 싶었는데……。",
 "5912": "이런 데서 혼잣말을\n중얼거려 봤자 소용없지.",
 "5913": "일단 나 혼자서라도\n고바야카와 님께 가 볼까.",
 "5914": "다마는 본진 뒤편에라도\n있는 걸까.",
 "5915": "갑자기 전장이 소란스러워졌다！",
 "5916": "보고！　보고입니다！",
 "5917": "고바……고바야카와대가……",
 "5918": "고바야카와대가……\n아군을 향해 공격을\n시작했습니다！",
 "5919": "뭐, 뭐라고！",
 "5920": "【心】（……고바야카와대가……\n……우리 주력이……）【終】",
 "5921": "【心】（【終】【注】배신했다【終】【心】！？）【終】",
 "5922": "【心】（크, 큰일이다……）【終】",
 "5923": "크……젠장……！",
 "5924": "【心】（마음만 급해서 어찌해야\n할지 생각이 정리되지\n않는다……！）【終】",
 "5925": "정신 차려！",
 "5926": "다, 다마！",
 "5927": "……미안.\n말없이 사라져서.",
 "5928": "아, 그래. 그보다――",
 "5929": "응, 상황은 알고 있어.",
 "5930": "아무튼 본진 안으로 돌아가자.",
 "5931": "【注】고바야카와대의 배신【終】……",
 "5932": "이건 분명 싸움의 흐름을\n바꿔 버릴 거야……。",
 "5933": "어찌할지 생각하려면\n【注】전장의 정보【終】가 필요해！",
 "5934": "【心】（확실히 고바야카와대엔\n수상한 데가 있었지만……）【終】",
 "5935": "【心】（설마 정말로 배신할\n줄이야……）【終】",
 "5936": "【心】（아니）【終】",
 "5937": "【心】（생각해 보면 요시쓰구는\n처음부터 고바야카와를\n의심했다……）【終】",
 "5938": "【心】（……내가 진짜 바보였다……\n는 건가）【終】",
 "5939": "……젠장！",
 "5940": "낙담은 나중에도 할 수 있어！",
 "5941": "지금은 아무튼 전장에서\n정보를 모아야 해！",
 "5942": "……본진에 있어 주었나……。\n좋은 판단일세.",
 "5943": "이미 들었겠지만\n【注】고바야카와대가\n도쿠가와 쪽으로 돌아섰네【終】.",
 "5944": "……다행히 내 포진은\n고바야카와대가 있는\n마쓰오산 기슭일세.",
 "5945": "놈은 내가 막겠네.",
 "5946": "【心】（……설마, 요시쓰구……）【終】",
 "5947": "【心】（고바야카와대의 배신까지\n읽고 포진 위치를\n정했던 건가……？）【終】",
 "5948": "【心】（하지만……）【終】",
 "5949": "【心】（요시쓰구의 병력은\n5천도 안 됐을 텐데……）【終】",
 "5950": "【心】（아무리 요시쓰구라도\n【終】【言】세 배 이상의 적【終】【心】을\n상대하는 건……！）【終】",
 "5951": "내 목숨이 붙어 있는 한……",
 "5952": "자네에겐 배신자를\n단 한 명도 보내지 않겠네.",
 "5953": "【心】（……요시쓰구……너……）【終】",
 "5954": "이 상황에서\n각 부대가 멋대로 움직이면,",
 "5955": "아군의 연계가 무너지고 마네.",
 "5956": "……그야말로 적의 뜻대로지.",
 "5957": "자네는 그대로 【注】본진에\n남아 아군을 모아 주게【終】.",
 "5958": "부탁하네.",
 "5959": "주군……오타니 님은……。",
 "5960": "……다마, 네 말대로\n낙담할 때가 아니군.",
 "5961": "요시쓰구를 위해서라도\n빨리 대처를 생각해야 한다.",
 "5962": "헤헤……주군은\n역시 바보네！",
 "5963": "후……칭찬해 줘서 고맙다.",
 "5964": "우선 전장 정보를 모르면\n아무것도 할 수 없겠군.",
 "5965": "요시쓰구에게 자세한\n【注】보고【終】를 청할까.",
 "5966": "요시쓰구에게 전령이다！",
 "5967": "요시쓰구, 후퇴를！",
 "5968": "미쓰나리,\n갑자기 무슨 소린가！？",
 "5969": "진정하고 내 말을 들어 주게.",
 "5970": "주군, 우선 보고로\n오타니 님 상황을 듣자.",
 "5971": "오타니 님도 먼저 전하고\n싶은 게 분명 있을 거야.",
 "5972": "미쓰나리, 냉정해지게.",
 "5973": "자네가 지금 할 일은\n내게서 정보를 끌어내는\n것일세.",
 "5974": "내가 화내기 전에\n오타니 님한테 혼나네……。",
 "5975": "……그런 눈으로 보지 마.",
 "5976": "요시쓰구, 보고해 줘！",
 "5977": "그래.\n우리 부대 상황을 알리지.",
 "5978": "도도 다카토라와 싸운\n직후의 연전이지만……",
 "5979": "승리 뒤라서 오히려\n사기가 높네.",
 "5980": "충분히\n고바야카와대를\n【言】막아 낼 수 있을【終】 걸세.",
 "5981": "아니, 【言】막아 보이겠네【終】.",
 "5982": "하지만――",
 "5983": "이 보고가 전해졌습니까！",
 "5984": "큰일,\n큰일이 났습니다！",
 "5985": "적입니다, 적입니다,\n적이에요！",
 "5986": "막 쫓아냈는데 벌써\n【注】태세를 다시 갖췄【終】어요！",
 "5987": "아직 거리는 있지만……。",
 "5988": "이, 이시다 님,\n저는 도망치겠습니다.",
 "5989": "이런 식으로 적이 공격해\n오면 도저히 못 막아요.",
 "5990": "거리가 있을 때\n후퇴하겠습니다.",
 "5991": "【心】（요시쓰구에게 아군을\n모으라는 말을 듣자마자\n……이건가！）【終】",
 "5992": "고, 고니시 님！\n잠깐 기다려 주십시오！",
 "5993": "이봐, 미쓰나리！",
 "5994": "고바야카와가 돌아섰다는\n게 사실인가？",
 "5995": "우, 우키타 님！",
 "5996": "【心】（또 골칫거리가……）【終】",
 "5997": "아니, 됐다.\n다 말하지 마라.",
 "5998": "그런 괘씸한 놈은\n내가 처리해 주마！",
 "5999": "【注】중앙에 잔챙이가 있는【終】 모양\n이다만, 아카시에게나 맡기면\n충분해！"
}