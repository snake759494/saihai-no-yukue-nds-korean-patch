{
 "4000": "나는 이제 무엇을 위해\n싸워야 하는가……。",
 "4001": "나는 이제 어찌해야……。",
 "4002": "위험했네, 주군.",
 "4003": "그래도 어떻게든 헤쳐 나와서\n다행이야.",
 "4004": "【心】（전장에 선 누구나 싸울\n이유를 지니고 있다……）【終】",
 "4005": "【心】（사랑하는 이를 위해……\n믿는 것을 위해……）【終】",
 "4006": "【心】（저마다에게\n소중한 이유를……）【終】",
 "4007": "【心】（……그 가운데 나는……）【終】",
 "4008": "어두운 얼굴이네.",
 "4009": "호소카와 님 일, 신경 쓰여？",
 "4010": "…………알겠어, 주군？",
 "4011": "몇 번이나 말하지만 주군의\n장점은 바보라는 거야.",
 "4012": "곧이곧대로 바보.",
 "4013": "그러니까……",
 "4014": "무슨 일이 있어도 자기가\n옳다고 생각하는 걸 관철하면\n돼.",
 "4015": "그야, 바보니까！",
 "4016": "…………미안하다, 다마.",
 "4017": "【心】（위로받은……건가）【終】",
 "4018": "【心】（호소카와 공의 사정은\n분명 딱했다……）【終】",
 "4019": "【心】（내게도 양보할 수 없는\n이유가 있다！）【終】",
 "4020": "싸움은 아직 안 끝났어.\n정신 차려！",
 "4021": "산 넘어 산입니다.",
 "4022": "좋아, 적 본진이 눈앞이다！",
 "4023": "이시다 미쓰나리, 각오해라！",
 "4024": "【注】가토 요시아키【終】가\n그 목을 받아 가겠다！",
 "4025": "아군은 사콘 한 부대뿐인데\n적은 두 부대가 되었나……。",
 "4026": "호소카와대는 전의를 잃었다.",
 "4027": "실제 전력으로는 호각인가……。",
 "4028": "바보 아빠라면 밀어붙일지도\n몰라――",
 "4029": "이번엔 한 고비 넘기기도 전에\n또 한 고비입니다.",
 "4030": "호소카와 공……홀로 앞서\n달려가선 아니 되오.",
 "4031": "이 【注】구로다 나가마사【終】가\n힘을 보태겠소.",
 "4032": "호소카와대가 전의를 잃었다지만\n하나 대 셋이라니……。",
 "4033": "솔직히 힘들겠군요.",
 "4034": "어쩌지, 주군！",
 "4035": "이대로라면 바보 아빠한테\n승산이 없어！",
 "4036": "…………읏！",
 "4037": "【心】（싸움은 끝나지 않았기는커녕\n궁지에 몰렸나…！）【終】",
 "4038": "【心】（호소카와 공을\n물리쳤는데……）【終】",
 "4039": "【心】（이대로라면……진다！）【終】",
 "4040": "【心】（뭐……뭐지？）【終】",
 "4041": "어쩌지……어쩌지……",
 "4042": "이대로라면……！",
 "4043": "여기가 뚫리면 본진은\n바로 눈앞이다.",
 "4044": "주군을 죽게 둘 수는 없다.",
 "4045": "여기가 목숨 걸 자리인가……！",
 "4046": "【心】（이건……\n다마와 사콘의 마음인가……？）【終】",
 "4047": "으으……머리가……아프다……。",
 "4048": "【心】（뭐지……이건……）【終】",
 "4049": "【心】（지금까지의 감각과는\n다르다！）【終】",
 "4050": "나는……나는……！",
 "4051": "……싸울 이유를 잃은 나는\n어디로 가야 하는가……？",
 "4052": "전장에 내 자리 따위……없다.",
 "4053": "큭……！",
 "4054": "【心】（이번엔 호소카와 공의\n마음이……！）【終】",
 "4055": "이 싸움, 질 수는 없소.",
 "4056": "그렇다면 이 호기에\n시마 사콘을 쳐야 하오！",
 "4057": "적 본진을 지키는 건 시마\n사콘인가.",
 "4058": "천하에 이름 높은 시마 사콘을\n치면……큰 공이다！",
 "4059": "으으으으으으……。",
 "4060": "【心】（온갖 마음이……\n밀려온다！）【終】",
 "4061": "시마 사콘을 쳐야 하오！",
 "4062": "큰 공이다！",
 "4063": "으으으으으으으으으으으……",
 "4064": "우와아아아아아악！",
 "4065": "하아, 하아, 하아……。",
 "4066": "…………주군？",
 "4067": "왜 그래？　괜찮아？",
 "4068": "뭐지, 이 【注】지도【終】……。",
 "4069": "응？　【注】지도【終】가 왜？",
 "4070": "【心】（밀려오던 마음은\n이제 보이지 않는다……）【終】",
 "4071": "【心】（하지만 뭐지 이건……？\n【注】지도【終】【心】가 미묘하게 달라 보인다）【終】",
 "4072": "【注】지도【終】 보고 싶어, 주군？",
 "4073": "그럼, 자.",
 "4074": "【心】（다마에겐 이 【終】【注】지도의 변화【終】【心】가\n안 보이는 건가？）【終】",
 "4075": "말을 움직이고 싶으면 【鋭音】【注】십자\n버튼【終】으로 옮길 곳을 골라.",
 "4076": "옮길 곳을 고르고 【鋭音】【注】Ａ버튼【終】을\n누르면 움직일 수 있어.",
 "4077": "말 움직이는 법, 알겠어？",
 "4078": "미안하다, 다마.",
 "4079": "한 번 더 알려 주겠나？",
 "4080": "응, 알았어.\n잘 들어.",
 "4081": "아아, 알았다.\n고맙다, 다마.",
 "4082": "【心】（어쨌든 말을 움직여서……）【終】",
 "4083": "【心】（뭐지, 이건……）【終】",
 "4084": "알겠다……。",
 "4085": "알겠어……다마.",
 "4086": "【注】전장의 움직임을 알 수 있다【終】！",
 "4087": "아군이 어떻게 움직이면\n적이 어떻게 움직일지……",
 "4088": "지금이라면 그걸 알 수 있다！",
 "4089": "주군, 그거 정말？",
 "4090": "【心】（이 【終】【注】지도의 변화【終】【心】……내\n머릿속에서 일어나는 일이다！）【終】",
 "4091": "【心】（밀려온 마음들이\n지도 위에서 정리되고 있다）【終】",
 "4092": "【心】（전장에 있는 모두의 마음이\n보이니까,）【終】",
 "4093": "【心】（【終】【注】전장의 움직임을 예측할 수\n있다【終】【心】！）【終】",
 "4094": "【心】（머리를 부딪친 탓인가……）【終】",
 "4095": "【心】（적인 호소카와 공의 마음을\n읽은 탓인가……）【終】",
 "4096": "【心】（계기는 모르지만……마음을\n읽는 능력이 성장했다！）【終】",
 "4097": "별로 믿기지는 않지만……。",
 "4098": "만약 그게 정말이라면\n이 상황을 뒤집을 수 있겠네！",
 "4099": "……그렇군.",
 "4100": "이걸 이용해 【注】작전을 쓸 수\n있는 진형【終】을 알면……。",
 "4101": "안 돼도 본전.\n해 보자！",
 "4102": "좀 더 기대해도 벌은\n안 받을 텐데.",
 "4103": "【心】（어쨌든）【終】",
 "4104": "【心】（아군 말을 움직여 적의 말을\n유도하자）【終】",
 "4105": "【心】（【終】【注】작전을 쓸 수 있는 진형【終】【心】을\n이끈다！）【終】",
 "4106": "보였다！",
 "4107": "사콘……",
 "4108": "이것이 승리로 가는 길이다！",
 "4109": "이……이런！\n언제 꾀여 들어온 것이냐！",
 "4110": "누아아아아앗！",
 "4111": "내가 여기서 쓰러질 수는\n없다！",
 "4112": "으으으음……",
 "4113": "시마 사콘……무섭구나！\n과연 천하에 알려진 전술가다.",
 "4114": "후퇴다, 후퇴하라！",
 "4115": "놀랐습니다, 주군……。",
 "4116": "언제 이런 통찰력을\n익히셨습니까？",
 "4117": "하지만\n덕분에 살았습니다.",
 "4118": "이제 제가 시끄럽게 참견할\n필요는 없겠군요.",
 "4119": "주군은 훌륭한 대장이\n됐습니다.",
 "4120": "…………그렇다고는 해도.",
 "4121": "여전히\n바보라고는 생각합니다만！",
 "4122": "뭐……",
 "4123": "저는 전장에서\n제 역할을 다하겠습니다.",
 "4124": "주군은 본진에서\n주군의 역할을 다해 주십쇼.",
 "4125": "…………반드시 이깁시다.",
 "4126": "하아……하아……하아……",
 "4127": "……기세 좋게\n호소카와 공을 구하러 갔건만,",
 "4128": "도망쳐 오다니……\n내가 생각해도 한심하군.",
 "4129": "나는 여기서 죽을 수는\n없다.",
 "4130": "질 수도 없다.",
 "4131": "그렇지 않으면……",
 "4132": "도요토미에 등을 돌리고\n도쿠가와 공 편에 선 의미가\n없다！",
 "4133": "그렇기에.",
 "4134": "어떤 수단을 써서라도\n승리의 장애는 없애겠다.",
 "4135": "철포대, 사격 준비！",
 "4136": "시마 사콘을 노려 쏴라！",
 "4137": "쏴라, 쏴라！",
 "4138": "맞을 때까지 쏴라！",
 "4139": "깊이 쫓지 마라！",
 "4140": "우선 본진 주변에서\n적을 일소하라！",
 "4141": "조금씩 조금씩 밀어 올려라！",
 "4142": "아얏！",
 "4143": "으, 응……괜찮아.",
 "4144": "뾰족한 돌을 좀 밟았을\n뿐이야.",
 "4145": "아, 이 돌이다.",
 "4146": "영차.",
 "4147": "이런저런 일이 있었지만……",
 "4148": "드디어\n이기기 위한 포진이 갖춰졌네.",
 "4149": "설마 싶지만……",
 "4150": "이기기 위한 포진의 의미를\n모르는……건 아니지？",
 "4151": "……미안, 모르겠다.",
 "4152": "아니, 그게,",
 "4153": "본진이 습격당하고 머리를\n부딪치고 이런저런 일이\n있어서……。",
 "4154": "머리가 좀 혼란스러워서……。",
 "4155": "……뭐, 됐어.",
 "4156": "알겠지？",
 "4157": "아니, 알고 있다.",
 "4158": "하지만 그 뒤로\n이런저런 일이 있었으니까.",
 "4159": "한번 돌아보며 생각하고 싶다.",
 "4160": "응, 그렇네.\n알았어.",
 "4161": "우리 군은 지금\n「세키가하라」의 고지를 잡고\n있어.",
 "4162": "게다가 적을 포위하듯이.",
 "4163": "첫 싸움에서 중앙의 우키타대가\n적의 공격을 받아 냈어.",
 "4164": "다음 싸움에선 고니시대와\n시마즈대가 중앙 방비를 두텁게\n했지.",
 "4165": "이걸로 적은 「세키가하라」\n중앙에 묶여 있어.",
 "4166": "게다가 방금 싸움으로\n본진의 안전을 확보했고.",
 "4167": "남은 건……",
 "4168": "고지에 포진한 아군이\n움직이기만 하면 적을 포위해서\n격파할 수 있어.",
 "4169": "그 열쇠가 되는 게,",
 "4170": "마쓰오산에 포진한",
 "4171": "【注】고바야카와 히데아키【終】\n님과,",
 "4172": "난구산에 포진한",
 "4173": "【注】모리 히데모토【終】 님\n이야.",
 "4174": "【心】（고바야카와대, 모리대 모두\n1만이 넘는 병력을 지녔다）【終】",
 "4175": "【心】（틀림없이 우리 군의\n주력이다）【終】",
 "4176": "【心】（즉……）【終】",
 "4177": "【心】（우리는 최선의 상황에서\n주력을 투입할 수 있다！）【終】",
 "4178": "자, 주군.\n신호 봉화를 올리자！",
 "4179": "맑게 갠 하늘로 신호\n봉화가 피어오른다.",
 "4180": "우리의 기세를\n상징하기라도 하듯이.",
 "4181": "모든 게 잘되고 있다.",
 "4182": "그때의 나는 우리의 승리를\n의심하지 않았다.",
 "4183": "그것이 잘못임을 곧\n깨닫게 되는데……。",
 "4184": "……이제……됐다.",
 "4185": "역시 네놈의 말에\n귀 기울일 가치 따위 없다！",
 "4186": "순순히 목을 내놓아라,\n이시다 미쓰나리！",
 "4187": "으, 우와앗！",
 "4188": "이대로라면――",
 "4189": "주군……곤란한 상황이군요.",
 "4190": "병사들 사기가 바닥입니다.\n싸우지도 않고 도망치는\n자도……。",
 "4191": "더 이상은\n버틸 수 없습니다……。",
 "4192": "호오호오, 잘 왔구나……。",
 "4193": "너는 내 친척 중에서 가장\n영리해 보이는 눈을 한\n아이로다.",
 "4194": "어떠냐？내 양자가 되어 보지\n않겠느냐？",
 "4195": "후계자로서의 장래를 약속하마.",
 "4196": "……쓸모가 있을지\n불안하지만,",
 "4197": "있는 힘껏 열심히 하겠습니다！",
 "4198": "핫핫핫！\n그 겸손함도 사랑스럽구나.",
 "4199": "모두 잘 들어라！",
 "4200": "이 아이는 내 친자식이나\n다름없다.",
 "4201": "소홀히 대하는 자는\n이 내가 용서치 않으리！",
 "4202": "알겠느냐！",
 "4203": "사내아이 탄생이오！",
 "4204": "후계자다！",
 "4205": "「진짜」 후계자 탄생이다！",
 "4206": "쉿, 그분이 오셨다.",
 "4207": "어떤 의미론 가장 딱한\n분이지.",
 "4208": "……킥킥……키득키득……。",
 "4209": "……경하드립니다.",
 "4210": "오오, 잘 왔다.",
 "4211": "네겐 무리하게 부탁해\n양자가 되어 달라 했지만,",
 "4212": "이제 고생시키지 않아도\n되겠구나.",
 "4213": "……………………고생이라니……。",
 "4214": "보잘것없지만 말이다,",
 "4215": "고바야카와 가문에서 너를\n당주로 맞이하도록 준비해\n두었다.",
 "4216": "머지않아\n그쪽으로 옮겨 편히 지내거라.",
 "4217": "아버님……\n저는……。",
 "4218": "아니, 오랫동안 미안했다.",
 "4219": "아니요, 저는……。",
 "4220": "물러가도 좋다.",
 "4221": "……………………예.",
 "4222": "보고！\n출격 요청 봉화입니다！",
 "4223": "드디어 우리 고바야카와대가\n나설 차례입니다！",
 "4224": "자, 주군！　출격 호령을！",
 "4225": "주군？",
 "4226": "지금은\n그때가 아닙니다.",
 "4227": "잠시 형세를 지켜봅시다.",
 "4228": "……하아.",
 "4229": "괜찮으시겠습니까？",
 "4230": "이대로 우리가 적의 배후를\n치면 승리는 틀림없습니다.",
 "4231": "같은 말을 하게 할 셈입니까？",
 "4232": "아직 움직여선 안 됩니다.",
 "4233": "……알겠지요？",
 "4234": "봉화가 올랐습니다！",
 "4235": "돌격 신호입니다.",
 "4236": "자자！　이제부터는 모리 가문의\n솜씨를 보일 때……",
 "4237": "히데모토 님……\n어서 가십시다！",
 "4238": "그, 그렇군. 에케이 공.",
 "4239": "모두들, 출격――",
 "4240": "기다리시오오오오옷！",
 "4241": "가, 갑자기 큰 소리 내지\n마라.깜짝 놀랐잖으냐.",
 "4242": "끄으으……히데모토 님……。",
 "4243": "뭐, 뭐냐？",
 "4244": "여기서 움직이는 건\n절대 안 됩니다！",
 "4245": "어, 어째서냐？",
 "4246": "무슨 소리를 하는 게요！",
 "4247": "중은 입 다물고 있어！",
 "4248": "뭣……！",
 "4249": "아시겠습니까……",
 "4250": "나는 여기서 안 움직입니다.",
 "4251": "자, 잠깐.",
 "4252": "우리 대 앞에 포진한 그대가\n움직이지 않으면……",
 "4253": "나도 못 움직이지 않느냐！",
 "4254": "그러면 되는 겁니다！",
 "4255": "깃카와 히로이에 공…",
 "4256": "이 절호의 기회에\n이유도 없이 움직이지 말라니,",
 "4257": "아무리 그래도\n너무 횡포가 심하오！",
 "4258": "하지만 이시다 공에게는\n뭐라고 변명하면……。",
 "4259": "기운을 북돋우려 도시락을 먹고\n있다고나 하시면 됩니다.",
 "4260": "마침 점심때이기도 하니.",
 "4261": "…………그, 그건 좀……",
 "4262": "아앙？",
 "4263": "아, 알았다.",
 "4264": "히로이에 일이다.\n분명 깊은 생각이 있겠지.",
 "4265": "음, 틀림없다.",
 "4266": "이시다 공에겐 히로이에 말대로\n전하자.",
 "4267": "…………좋습니다.",
 "4268": "과연 히데모토 님.\n잘 결단하셨습니다！",
 "4269": "（여기서 우리 모리가 움직이면\n도쿠가와 이에야스의 배후를 칠\n수 있거늘）",
 "4270": "（깃카와 공……。\n대체 무슨 생각인가……？）",
 "4271": "………………어찌 된 거냐！？",
 "4272": "신호 봉화는 분명 올랐다.",
 "4273": "하지만 고바야카와대도 모리대도\n전혀 움직일 기색이 없다.",
 "4274": "이대로라면\n모처럼의 우세도……。",
 "4275": "주군, 절대 이상해.",
 "4276": "이렇게 날씨도 좋으니까,",
 "4277": "봉화가 안 보인다는 건\n아닐 것 같은데……。",
 "4278": "직접 상황을 보러 가 볼까.",
 "4279": "……으음.",
 "4280": "고바야카와 님이 있는\n마쓰오산은 「세키가하라」의\n이쪽이니까……",
 "4281": "만나러 가려면\n갈 수 있지만.",
 "4282": "모리 님이 있는 난구산은\n본진과는 「세키가하라」를\n사이에 둔 반대편이야.",
 "4283": "아무래도 적진을 가로질러야\n하니까……。",
 "4284": "불평 한마디도 못 하겠네……。",
 "4285": "【注】모리 히데모토【終】 님의 서장\n입니다！",
 "4286": "모리 공의 서장！？",
 "4287": "뭔가 못 움직이는 이유가\n있어서 그걸 알려 온 걸까？",
 "4288": "얼른 읽어 보자.",
 "4289": "내게는 「도시락을 먹고 있어서\n못 움직인다」",
 "4290": "고 적혀 있는 걸로밖에\n안 보이는데……。",
 "4291": "응……。",
 "4292": "아니,\n멍하니 있을 때가 아니다.",
 "4293": "서둘러 진군을 재촉하는 답장을\n써야……。",
 "4294": "…………………………앗！",
 "4295": "왜 그래, 주군？",
 "4296": "모리 공의 서장이……。",
 "4297": "위에 겹쳐서 답장을 쓴 게\n실수였다……。",
 "4298": "아～아, 밑의 서장 글씨가\n번져 버렸네.",
 "4299": "다마, 그런 눈으로 보지\n마라！",
 "4300": "아～, 모리 공에겐 전언을\n부탁한다.",
 "4301": "「도시락은 나중에 해 달라」",
 "4302": "「지금은 진군이\n우선이다」라고.",
 "4303": "예, 알겠습니다.",
 "4304": "……일단,",
 "4305": "모리대에 대한 대처로는\n이 정도밖에 못 한다.",
 "4306": "그럼 【注】고바야카와 님한테【終】\n가 보자.",
 "4307": "고바야카와대 진지",
 "4308": "앞으로의 일",
 "4309": "본진이다.",
 "4310": "방금 전엔 이 안까지\n적이 침입했다.",
 "4311": "실은 꽤 위험했지……。",
 "4312": "제대로 갖춰져 있다.",
 "4313": "「대일대만대길」이라 적힌\n깃발이다.",
 "4314": "「대」는 천하를 나타낸다.",
 "4315": "모두가 한 사람을 위해,\n한 사람이 모두를 위해 살면",
 "4316": "천하는 태평……。",
 "4317": "그것이 나의 이상이다.",
 "4318": "저 나무,\n점점 마음에 들기 시작했다.",
 "4319": "말장난할 생각은\n아니었는데……。",
 "4320": "고심해서\n이 전황을 만들었는데……",
 "4321": "이렇게 될 줄이야……。",
 "4322": "주군, 실망하기엔 일러.",
 "4323": "전부 생각대로 되면\n그게 더 무섭지 않아？",
 "4324": "하긴, 그렇군.",
 "4325": "아, 주군이 그 정도라고\n말하는 건 아니니까.",
 "4326": "………………고, 고맙다.",
 "4327": "천만에요！",
 "4328": "【心】（위로받은 건가……？）【終】",
 "4329": "【心】（이건 적 닌자에게서 손에\n넣은 서장이군）【終】",
 "4330": "【心】（도요히사 공이 직접 쓴\n것이다）【終】",
 "4331": "【心】（……깃발은 되돌렸고 진막은\n버렸지만……）【終】",
 "4332": "【心】（이 서장은 어떻게 할까）【終】",
 "4333": "【心】（시마즈대는 믿을 수 없다……\n인가）【終】",
 "4334": "【心】（무엇이\n진실일까……？）【終】",
 "4335": "자, 주군.",
 "4336": "서장만 뚫어지게 보지 말고.\n지금은 행동뿐이야.",
 "4337": "【心】（이 서장의 글씨와 아까의\n【終】【注】배신 승낙 서장【終】【心】의 글씨）【終】",
 "4338": "【心】（보면 볼수록 똑같다）【終】",
 "4339": "【心】（「우리 시마즈」라는 문구는\n완전히 같잖아）【終】",
 "4340": "【心】（이건 아까 찾은\n배신 승낙 서장이다……）【終】",
 "4341": "시마즈대는\n배신 같은 거 안 했지.",
 "4342": "아아. 그건 보증할 수 있다.",
 "4343": "【心】（고바야카와 공에게 받은\n포진도다）【終】",
 "4344": "【心】（마쓰오산 기슭의 상황이\n자세히 적혀 있다）【終】",
 "4345": "【心】（합전 때 쓸모 있겠군）【終】",
 "4346": "예감이란",
 "4347": "모리대에 대해",
 "4348": "고바야카와대에 대해",
 "4349": "시마즈대에 대해",
 "4350": "오타니대 진지에 와\n봤는데……。",
 "4351": "요시쓰구는 어디 있지？",
 "4352": "아, 주군, 여기야 여기！",
 "4353": "어, 어이.\n잠깐 기다려！",
 "4354": "후후……。",
 "4355": "여전히 시끌벅적하군.",
 "4356": "목소리가 너무 커서 진\n밖에서도 들린다.",
 "4357": "요시쓰구……。",
 "4358": "미안하다.\n또 네 지혜를 빌리고 싶다.",
 "4359": "실은――",
 "4360": "아아……\n보고는 들었다.",
 "4361": "시마즈대뿐 아니라 모리대,\n고바야카와대까지 불참이라니.",
 "4362": "역시 내 예감은\n틀리지 않은 건가……。",
 "4363": "예감……？\n무슨 말이지？",
 "4364": "인기척이 없다.\n모두 나가 있는 모양이다.",
 "4365": "별로 신경 쓰이지 않는\n나무군.",
 "4366": "……하아……。",
 "4367": "따, 딱히\n말장난한 건 아니다！",
 "4368": "딱히 이상은 없다.",
 "4369": "오타니 가문의 문장을 새긴\n깃발이다.",
 "4370": "깃발 표식은 따로 있다.",
 "4371": "오타니 가문의 문장이다.",
 "4372": "한 쌍의 나비는 「화」를\n나타내는 문양이라고 한다.",
 "4373": "요시쓰구……。\n네가 말하는 예감이란 뭐지？",
 "4374": "……미쓰나리.",
 "4375": "이 싸움은 상상 이상으로\n복잡한 사정이 얽혀 있다.",
 "4376": "최악의 경우 여러 부대가\n【注】도쿠가와 편과 내통【終】하고\n있을지도 모른다……。",
 "4377": "설마……。",
 "4378": "의심만 하다가 꼼짝 못 하게\n되는 건 바라는 바가\n아니지만,",
 "4379": "주의는 게을리하지 말아 다오.",
 "4380": "특히 공격할 때 공격하지 않는\n고바야카와대와 모리대를 보면,",
 "4381": "【注】움직임이 둔한 부대는\n경계【終】해야 한다.",
 "4382": "그런 점에선\n시마즈대 또한……。",
 "4383": "시마즈？",
 "4384": "그들의 오해는 풀렸을 텐데.",
 "4385": "이 전황에 움직이지 않는\n모리대……요시쓰구는 어떻게\n보나？",
 "4386": "음.",
 "4387": "이 싸움에 뭔가\n속셈이 있는 것이겠지.",
 "4388": "진정 이에야스 타도를\n생각한다면 이 호기를 놓칠 리\n없다.",
 "4389": "그럼 모리대는\n적과 내통하고 있는 건가？",
 "4390": "성급하게 그 결론에 뛰어드는\n건 좋지 않다.",
 "4391": "확증은 전혀 없으니까.",
 "4392": "미쓰나리.",
 "4393": "모리대에는 어쨌든\n신호를 계속 보내 다오.",
 "4394": "그들은 우리 군의 주력이자\n비장의 수다.",
 "4395": "어떻게 해서든 움직여야……",
 "4396": "손닿는 곳에 있는 승리가\n달아나 버린다.",
 "4397": "고바야카와대의 움직임……\n요시쓰구는 어떻게 생각하지？",
 "4398": "……함부로 말해서 혼란스럽게\n하고 싶진 않지만……。",
 "4399": "【注】고바야카와 히데아키【終】 공……"
}