{
 "17200": "아니, 확인입니다.",
 "17201": "여기서 나쓰카대가 데려올\n적을 기다리는 것\n아니었습니까?",
 "17202": "조령모개 같은\n지시로는 신용을 잃습니다.",
 "17203": "정말 그 말대로야.",
 "17204": "적에게 사방을 포위당한 뒤,",
 "17205": "조소카베대가 나타나자마자\n혼다 다다카쓰대만\n움직였다.",
 "17206": "재빨리\n위험을 감지한 모양이군.",
 "17207": "내가 꼼짝 못 하는 건\n변함없지만……",
 "17208": "이 진형이라면\n아직 활로가 있다.",
 "17209": "나 혼자로는 적이 경계해서\n못 했던 일이……",
 "17210": "【注】조소카베대와 연계【終】하면\n가능해지겠지.",
 "17211": "이시다 님, 원군과 우리 대의\n【注】연계【終】를 노리게.",
 "17212": "그 끝에는 반드시\n광명이 보일 게야.",
 "17213": "주군, 조소카베대를 보낸\n이유를 떠올리면……",
 "17214": "시마즈대와 잘\n연계할 수 있을 거야.",
 "17215": "어떻게 해야 좋은 결과가\n나올지 잘 생각해 봐.",
 "17216": "【心】（조소카베대에게\n무엇을 시킬 것인가）【終】",
 "17217": "【心】（그렇다면\n망설임 없이 지시할 수\n있을 터）【終】",
 "17218": "오우!\n내 보고를 들어 줘!",
 "17219": "남쪽 전장에 도착해 보니……",
 "17220": "눈앞에 적에게 포위된\n시마즈 요시히로 님이\n있었던 거다.",
 "17221": "혼다 다다카쓰대가\n겁먹고 도망쳤는데,",
 "17222": "놈을 쫓지 않아도 되겠나?",
 "17223": "주군, 초심을 잊지 마.",
 "17224": "조소카베대에게\n뭘 시키고 싶은지……",
 "17225": "요시히로 님과 어떤\n【注】연계【終】를 시킬지\n잘 생각해 봐.",
 "17226": "아아……그렇군……",
 "17227": "그렇다면 버텨 보이지.",
 "17228": "요시히로 님이 버티는 동안,\n자, 주군!",
 "17229": "……【注】지금은 아직【終】.",
 "17230": "【心】（지금은 아직……?）【終】",
 "17231": "……그래서, 어떻게 할 거냐?",
 "17232": "그게 말이죠……",
 "17233": "의미 없는 작전 지시는\n주군의 신용만 떨어뜨려.",
 "17234": "대기라고!?",
 "17235": "내 힘이 필요했던 게\n아니었나?",
 "17236": "맥이 빠지는군……",
 "17237": "조소카베 님이니까\n옮겨 달라고 한 거잖아?",
 "17238": "서두르지 않으면\n적이 움직여 버려!",
 "17239": "혼다대를 쫓으라는 건가?",
 "17240": "그렇다면 전진은 곤란하다……",
 "17241": "시마즈대와 함께\n적에게 포위될 게\n뻔하다.",
 "17242": "조소카베대까지\n위험하게 해서 어쩌려고?",
 "17243": "조소카베대, 지금이다!\n이나바대에 강습을\n실행하라!",
 "17244": "이것이 시코쿠의 영웅……",
 "17245": "조소카베의 실력이다!",
 "17246": "누오……!",
 "17247": "힘 덩어리가\n덮쳐 온다……!",
 "17248": "배신자의 졸개 따위\n얼마든지 밀어붙여 주마!",
 "17249": "쳇……아직 저항할 기력이\n남아 있었나.",
 "17250": "밟아도 밟아도\n시들지 않는 잡초 놈들……!",
 "17251": "슬슬\n제대로 베어 주마……",
 "17252": "자, 주군,\n시마즈대에 전령을 보내자!",
 "17253": "이럴 리가……!",
 "17254": "더는 못 버틴다……",
 "17255": "히데아키 님의 분노를 각오하고\n철수한다!",
 "17256": "물러나라아!\n목숨이 있어야 뭐든 하지!",
 "17257": "어이 이나바! 히라오카!",
 "17258": "하나같이\n쓸모없는 놈들……!",
 "17259": "너희 같은 무능한 놈들한테\n발목 잡힌 끝에……",
 "17260": "미쓰나리 같은 어설픈 놈한테\n못 이긴다는 거냐!?",
 "17261": "젠장……젠장……\n젠장!",
 "17262": "흥……애송이가 짖는구나.",
 "17263": "가신들 근성이\n글러 먹은 건……",
 "17264": "모두 주군인 네놈의\n책임이 아니더냐.",
 "17265": "망할 영감이\n나한테 설교하겠다는 거냐?",
 "17266": "가신은 주군을 위해 애쓰는 게\n당연하잖아!",
 "17267": "어리석은 놈.",
 "17268": "사람 사이의 관계에\n당연이라는 말은\n없느니라.",
 "17269": "믿어 주지 않는 주군에게\n어느 가신이 충의를\n다하겠느냐?",
 "17270": "아앙?",
 "17271": "고바야카와 히데아키……",
 "17272": "네놈은 그저 제멋대로인\n응석받이일 뿐이다.",
 "17273": "자기는 남을 위해\n일하지도 않으면서……",
 "17274": "남이 자기에게 애써 주는 걸\n당연하다 여기겠지.",
 "17275": "결국,",
 "17276": "그 제멋대로인 기대가 어긋나면\n상대를 원망하지……",
 "17277": "착각도 정도껏 해라!",
 "17278": "너……너 따위가,\n내 뭘 안다고!",
 "17279": "나는……나는……!",
 "17280": "어릴 적 배신당한 기억을\n아직도 끌어안고 있느냐……",
 "17281": "아직도 어린애인 줄 아느냐?",
 "17282": "네놈은 자라지 않은 게냐?",
 "17283": "닥쳐, 닥쳐, 닥쳐,\n망할 영감!",
 "17284": "좋다.",
 "17285": "그렇다면\n이 몸이 버릇을 고쳐 주마.",
 "17286": "귀신의 훈육은 엄하다!",
 "17287": "우오오오오오!\n방향을 돌려\n혼다 다다카쓰를 노려라!",
 "17288": "놈을 쓰러뜨리면 이에야스는\n알몸이나 마찬가지다!",
 "17289": "조소카베 님인가.\n과연 무인다운 분이로다.",
 "17290": "그렇다면\n전력으로 응할 뿐!",
 "17291": "이에야스는 아직\n움직임이 없나.",
 "17292": "두 부대를 잃고도\n끄떡없다는 느낌이네.",
 "17293": "【心】（아직……\n무슨 계책을 남겨 둔\n건가……?）【終】",
 "17294": "우리 대는 남하하여\n【注】옆 전장으로 이동【終】하려\n한다.",
 "17295": "어떻게든 적을 떨치고 싶지만\n좀처럼 떨어지지 않는다.",
 "17296": "어떻게든 틈을 만들어……",
 "17297": "내게서\n【注】적을 떼어 낼 준비【終】를\n부탁한다.",
 "17298": "옮겨 갈 곳의 준비는\n이미 됐으니까,",
 "17299": "이제 나쓰카 님 도착을\n기다리기만 하면 돼.",
 "17300": "내게서 【注】적을 떼어 낼 준비【終】는\n돼 있겠지!",
 "17301": "뭐라고 하든\n뛰어들 테다!",
 "17302": "【心】（누구든 뭐라고 좀 해 줘!）【終】",
 "17303": "미쓰나리!\n간신히 전장을 넘었다!",
 "17304": "물론……\n놈들도 같이지만……",
 "17305": "자, 무리인 줄 알고\n돌진한다!",
 "17306": "음, 아직 도망치나!",
 "17307": "여, 여기는 내가\n지나가게 두지 않겠소!",
 "17308": "음……?\n모리대가 이런 곳에?",
 "17309": "뭐라!\n아사노대가 발이 묶였나……",
 "17310": "우리 대만이라도 추격한다!",
 "17311": "왔다……왔다!",
 "17312": "차, 창벽이라고……!",
 "17313": "으아아아아아!",
 "17314": "어이쿠……",
 "17315": "쓰쓰이대는 괴멸,\n아사노대는 모리대에\n발이 묶였다고?",
 "17316": "이대로 나아가 봤자",
 "17317": "나쓰카대 철포대의 반격을\n맞을 뿐이다.",
 "17318": "일단 물러난다.",
 "17319": "도도 님!",
 "17320": "이……이 이상\n우리 대만으로는\n어쩔 수가 없소.",
 "17321": "여기선 북쪽 전장으로\n돌아가오!",
 "17322": "이건 볼 것도 없이\n절호의 반격 기회 아닌가?",
 "17323": "모두, 추격한다!",
 "17324": "우리도 함께 가겠소!",
 "17325": "어쩐지 불길한 예감이\n드는군요. 승려의\n감이라는 것입니다.",
 "17326": "……이시다 님.\n저는 여기 남겠습니다.",
 "17327": "【心】（에케이 님은\n싸우기 싫은 건가……?）【終】",
 "17328": "【心】（아니면 감이 진짜인가?）【終】",
 "17329": "이시다 님,\n내 보고를 들어 줘!",
 "17330": "적의 증원이다!\n놈은――",
 "17331": "도쿠가와 이에야스의 가신\n【注】이이 나오마사【終】,\n숱한 시련을 넘어……",
 "17332": "여기에 부・활!",
 "17333": "거기 있는 악의 화신이여……",
 "17334": "나의 정의의 칼날에\n꿰뚫려라!",
 "17335": "이이……나오마사……!",
 "17336": "도요히사 님이 목숨 걸고\n막아 준 상대가……!",
 "17337": "주군, 낙담하지 마!",
 "17338": "도요히사 님이 여기까지\n시간을 벌어 줬으니까……",
 "17339": "아직 승산이 있는 거야!",
 "17340": "이이 나오마사가 나타났나……",
 "17341": "도요히사의 원수 갚기,\n그대의 지휘로\n이뤄 주게.",
 "17342": "……그뿐이다.",
 "17343": "……요시히로 님.",
 "17344": "예, 반드시!",
 "17345": "또다……",
 "17346": "【心】（이번에도 전장이……\n조종된다!）【終】",
 "17347": "주군……\n이번엔 역시\n【注】북쪽 전장【終】?",
 "17348": "【注】북쪽 전장【終】의 풍경이\n단편적으로 보였어.",
 "17349": "【注】보고【終】……\n들어 보는 게 좋겠네.",
 "17350": "작전: 창벽을 실행하시오!",
 "17351": "딱히 달라진 건 없습니다.",
 "17352": "간소한 보고네……",
 "17353": "더 이상의 답은\n끌어낼 수 없을 것 같군.",
 "17354": "……에케이 님한테\n신경 쓰기보다",
 "17355": "【注】북쪽 전장의 보고【終】를\n듣는 게 낫지 않아?",
 "17356": "그건 무슨 뜻입니까?\n북쪽 전장으로 가라고?",
 "17357": "소승의 감이 빗나간 이상,\n따르는 건 마다하지\n않습니다만……",
 "17358": "【注】북쪽 전장의 상황【終】은\n알고 계십니까?",
 "17359": "먼저 【注】북쪽 전장【終】……\n모리 님네 【注】보고【終】를\n들어 보자.",
 "17360": "적도 없는데\n창벽이라니 이 무슨?",
 "17361": "이유 없이 작전을 지시해도\n따라 주지 않아.",
 "17362": "아니면 이유……있어?",
 "17363": "윽……\n【注】북쪽 전장의 보고【終】를\n듣자.",
 "17364": "보고……보고 말이군요.",
 "17365": "움직일 계기를 놓쳤기에\n이쪽 전장에서……",
 "17366": "히데모토 님과 나쓰카 님의\n전장을 감시하고 있습니다.",
 "17367": "우리 바로 북쪽 즈음에\n야마노우치대와 도도대의\n움직임이 보입니다.",
 "17368": "특히 도도대의 움직임이……",
 "17369": "분명\n【注】기마 돌격【終】을\n실행할 셈입니다!",
 "17370": "곤란하군요……\n뭔가 손을 써야……",
 "17371": "북쪽 전장 모습을\n안다는 건……",
 "17372": "에케이 님은 당장이라도\n【注】북쪽 전장에\n달려갈 수 있다【終】는 거지.",
 "17373": "혹시 북쪽 상황을\n해결할 열쇠는……",
 "17374": "【心】（그래……）【終】",
 "17375": "【心】（그 힘은 【終】【注】전장끼리의 연계【終】【心】를\n놓친다……）【終】",
 "17376": "【心】（에케이 님이야말로\n어쩌면……）【終】",
 "17377": "【心】（에케이 님에게 보낼\n【終】【注】전령 내용【終】【心】을\n다시 생각해 보자）【終】",
 "17378": "허허, 그거면 되겠습니까?",
 "17379": "아무래도 걸리는 게 있어서……",
 "17380": "에케이 님은 뭔가\n신경 쓰이는 게 있나 봐.",
 "17381": "보고를 들어 보는 게 좋겠어.",
 "17382": "그건\n전혀 상관없습니다만……",
 "17383": "한번 제 【注】보고【終】를\n들어 주시겠습니까?",
 "17384": "윽……\n좀 더 생각해 볼게.",
 "17385": "……동쪽……이라고요?",
 "17386": "참으로 엉뚱한 방향이군요.",
 "17387": "주군……\n길치도 정도가 있지.",
 "17388": "에케이 님한테 시킬 일,\n이제 알고 있지?",
 "17389": "……서쪽……이라고요?",
 "17390": "그건 남쪽 전장 엄호를\n우선하라는 말씀입니까?",
 "17391": "제 【注】보고【終】는\n아무래도 좋다고……?",
 "17392": "정말 괜찮으시겠습니까?",
 "17393": "에, 【注】보고【終】를 무시한 건\n아닙니다만……",
 "17394": "적은 모리대, 나쓰카대를\n몰아붙이는 데 정신이 팔려",
 "17395": "옆 전장에 있는 당신을\n잊고 있습니다.",
 "17396": "거기서 당신이\n북쪽 전장에 뛰어들면",
 "17397": "적은 동요할 수밖에 없습니다.",
 "17398": "에케이 님, 【注】기마 돌격【終】을 막고\n아군을 구할 수 있는 건……",
 "17399": "당신뿐입니다!",
 "17400": "이시다 님 말씀은\n알겠습니다만……",
 "17401": "이대로 북상한들 과연\n도도대를 막을 수\n있을지……?",
 "17402": "예, 그러니\n이걸 전령하지요.",
 "17403": "에케이 님, 기마 돌격입니다!",
 "17404": "어째서 갑자기\n그런 지시가 나옵니까?",
 "17405": "우리 대에는\n기마대가 없습니다!",
 "17406": "그만 당황해 버렸다……",
 "17407": "에케이 님, 철포 사격입니다!",
 "17408": "우리 대에는\n철포대가 없습니다!",
 "17409": "진정하자, 주군.\n진정하면 괜찮을 거야.",
 "17410": "창벽을 갖춘 채\n북상하면……",
 "17411": "야마노우치대나 도도대를\n확실히 쓰러뜨릴 수\n있습니다.",
 "17412": "만약 적이 당신의 접근을\n눈치채고 후퇴하더라도……",
 "17413": "【注】기마 돌격【終】을\n저지한다는 목표는……",
 "17414": "반드시 달성할 수 있습니다!",
 "17415": "이시다 님께서\n그렇게까지 말씀하신다면",
 "17416": "저도 미력이나마\n다하지 않을 수 없군요.",
 "17417": "맡겨 주십시오!",
 "17418": "그럼 창벽, 갖춰라!",
 "17419": "이대로 북상하라!",
 "17420": "잘돼 줘……!",
 "17421": "……모두가 연계하면\n분명……",
 "17422": "고바야카와 히데아키……\n가련한 애송이로다.",
 "17423": "두 부대 한꺼번에 올 테면\n와라!",
 "17424": "조소카베대와 연계해서\n이나바대와 히라오카대를\n쫓아 버렸다.",
 "17425": "아까보다 전황은\n안정됐지만……",
 "17426": "이이 나오마사가 나타났군.",
 "17427": "조소카베대와 합쳐도\n역시 부대 수는 밀린다……",
 "17428": "불리함은 어쩔 수 없다.",
 "17429": "어쨌든 나는 고바야카와\n히데아키를 치기로 하지.",
 "17430": "놈의 썩어 빠진 근성을……",
 "17431": "단단히\n뜯어고쳐야겠다!",
 "17432": "요시히로 님, 고바야카와\n히데아키한테 화났었구나.",
 "17433": "그 배신 때문에\n많은 목숨을 잃었으니까……",
 "17434": "이이 나오마사와\n혼다 다다카쓰 양쪽에서\n공격받고 있지만……",
 "17435": "내 강함은 진짜다.",
 "17436": "이 정도로는 아직 안 당한다!",
 "17437": "누오오오오오오오오오!\n신나기 시작했다!",
 "17438": "대단한 기백이네.",
 "17439": "조소카베 님의 말……\n여기선 믿어 보지.",
 "17440": "요시히로 님,\n지금은 대기입니다!",
 "17441": "이대로 고바야카와 히데아키와\n싸우라는 거라면\n받아들이지.",
 "17442": "역시\n요시히로 님은 든든해……",
 "17443": "이이 나오마사와 혼다\n다다카쓰는 내게 맡겨라!",
 "17444": "적의 맹장 둘을 상대로\n이 자신감……",
 "17445": "든든한 것 같기도……\n걱정되는 것 같기도……",
 "17446": "지금은\n그를 믿을 수밖에 없겠지.",
 "17447": "나는 이 정도론 안 진다!",
 "17448": "절대 물러나지 않겠다!",
 "17449": "……두 부대 사이에 끼여\n꼼짝 못 하는 게\n실정이지만……",
 "17450": "이대로 버텨 주는 게\n좋겠네.",
 "17451": "그래, 무리는\n하지 말아 달라 하자.",
 "17452": "또……인가?",
 "17453": "어떻게 된 거지……?",
 "17454": "주군.\n전장이 조종당하는 거지?",
 "17455": "전령 말고\n【注】보고【終】를 들어야지!",
 "17456": "아아……보고하지……",
 "17457": "아사노대, 도도대를 쫓아……",
 "17458": "북쪽 전장으로\n돌아온 것까진 좋았는데……",
 "17459": "순식간에\n야마노우치대가 남쪽으로\n돌아 들어왔다!",
 "17460": "북서쪽 도도대의\n움직임도 조심하지\n않으면 언젠가……",
 "17461": "하지만……\n왜 이런 사태가 된 거지?",
 "17462": "우리에게\n잘못이 있었다곤\n생각되지 않는데……",
 "17463": "으……움직이기 시작했다……",
 "17464": "그게……\n다시 북쪽 전장에 오자마자",
 "17465": "또\n알 수 없는 사태가 됐다……",
 "17466": "전장이 누군가에게 조종되듯\n변해 가는 거다……",
 "17467": "우리는\n우리 뜻으로 움직였을 텐데.",
 "17468": "하지만……어느새\n야마노우치대는 남쪽으로\n돌아 들어왔고,",
 "17469": "텅 빈 나쓰카대 측면에선\n【注】기마 돌격의 위험【終】이……",
 "17470": "도도대가 움직이기 시작하면……",
 "17471": "이렇게 연달아\n전장을 움직여 오다니……",
 "17472": "좀 너무 서두르는 거\n아닙니까,\n도쿠가와 이에야스 님.",
 "17473": "아무리 이시다 미쓰나리가\n바보라도……",
 "17474": "과연\n이것저것 눈치챌 겁니다.",
 "17475": "하지만 예상 밖인 건\n이시다 미쓰나리의 끈기다……",
 "17476": "이건 어쩌면……",
 "17477": "아니, 뭐 됐어.",
 "17478": "일단\n맡은 일이나 해 볼까.",
 "17479": "주군, 이대로면\n【注】기마 돌격【終】을 당하겠어!",
 "17480": "도도대가 태세를 갖추기 전에",
 "17481": "이쪽도 대항책을 세우자!",
 "17482": "우리는 야마노우치대와\n교전 중이다.",
 "17483": "거기에\n측면에서 도도대가 나타나……",
 "17484": "【注】기마 돌격【終】 준비를\n시작하고 있다.",
 "17485": "한시라도 빨리 이를 피하지\n않으면 우리는……",
 "17486": "【注】기마 돌격을\n피할 방법【終】 말이지?",
 "17487": "그렇게\n어렵진 않을 것 같은데……",
 "17488": "【心】（……과연 그럴까?）【終】",
 "17489": "【心】（안이한 방법으로\n해결하려 해 봤자）【終】",
 "17490": "【心】（또 이에야스가\n같은 힘을 쓰면……）【終】",
 "17491": "현재 아사노대와 교전 중이다.",
 "17492": "하지만……어느새\n야마노우치대는 남쪽으로\n돌아 들어왔다.",
 "17493": "어서 【注】기마 돌격을 피할\n【終】지시를 부탁한다!",
 "17494": "【注】기마 돌격을 피하는【終】 거라면\n바로 될 것 같은데……",
 "17495": "【心】（그저 기마 돌격을\n피하기만 하면 될까……）【終】",
 "17496": "【心】（【終】【注】이에야스의 힘에 맞설【終】【心】 때\n나는 어떻게 했었지……?）【終】",
 "17497": "【心】（그저 피하기만 해서는\n뭔가 부족할 터）【終】",
 "17498": "나쓰카대, 대기하라!\n곧 상황을 타개해 보이겠다!",
 "17499": "아, 알았으니까 서둘러라!",
 "17500": "【注】기마 돌격【終】을 당하고 나서는\n늦는다고!",
 "17501": "지시할 상대가\n정말 나쓰카 님이면 돼?",
 "17502": "그러고 보니……\n왜 나쓰카지?",
 "17503": "어쨌든\n【注】기마 돌격【終】 저지를\n우선한다!",
 "17504": "아아……내게 이견은 없다.",
 "17505": "곧바로 후퇴하지.",
 "17506": "좋아, 이걸로 【注】기마 돌격【終】은\n막을 수 있을 거다.",
 "17507": "이에야스……또인가……!",
 "17508": "【心】（전장이……원래대로\n돌아간다……!）【終】",
 "17509": "뭐지……?\n싸우는 사이에\n원래 자리로……!",
 "17510": "…………………………안 돼.",
 "17511": "어……?\n뭐가 안 되는데?",
 "17512": "아무리 북쪽 전장 부대에\n지시를 내려 봤자",
 "17513": "이에야스의 힘으로\n곧 되돌려지고 만다.",
 "17514": "아마 몇 번을 해도\n그 반복이야……",
 "17515": "…………주군, 아까 말했지?",
 "17516": "「혼자서는\n한 전장밖에 볼 수 없다」",
 "17517": "「그래서\n【注】전장끼리의 연계【終】를\n놓친다」고.",
 "17518": "그렇다면 또……",
 "17519": "의지할 동료는\n그 밖에도 있을 거다.",
 "17520": "나쓰카대, 철포 사격을\n실행해 줘!",
 "17521": "무리를 넘어서 바보로군!",
 "17522": "【注】정보【終】를 보고 다시 와라!",
 "17523": "이번만큼은\n주군을 감쌀 말이 없어.",
 "17524": "모리대, 대기하시오!",
 "17525": "으음……인내로군.",
 "17526": "【注】기마 돌격【終】의 공포를\n견디라는 말이로군……?",
 "17527": "……알겠소.\n최선을 다하지!",
 "17528": "어쨌든 【注】기마 돌격【終】\n저지를 우선합시다!",
 "17529": "과연, 이시다 님 말에\n틀림은 없는 듯하오.",
 "17530": "후퇴한다!",
 "17531": "이, 이상하오.\n우린 물러났을 텐데……!",
 "17532": "모리대,\n기마 돌격을 실행합시다!",
 "17533": "북쪽 전장에 도착했습니다!",
 "17534": "지금부터 더 북상하겠습니다!",
 "17535": "창벽을 갖춘 원군이라고?",
 "17536": "하아……꽤 살벌한 손님이군.",
 "17537": "……물러나. 당장.",
 "17538": "으으으음!\n아, 안 돼!",
 "17539": "밀어라, 밀고 또 밀어라!",
 "17540": "창벽이 다가온다!",
 "17541": "누오, 야마노우치대에게\n엄청난 힘으로\n밀린다!",
 "17542": "적은\n우리 창벽이 두려워",
 "17543": "접촉하기 전에\n옮긴 모양입니다.",
 "17544": "놓치긴 했습니다만\n일단은 대기하지요.",
 "17545": "【注】기마 돌격【終】은 피했지만\n적은 못 쓰러뜨렸네.",
 "17546": "그래도 이건……",
 "17547": "나쓰카대! 보고하라!",
 "17548": "아아……보고하지!",
 "17549": "아까 에케이 님이 나타나서",
 "17550": "야마노우치대에 밀려\n후퇴하고 말았다.",
 "17551": "그건 그렇다 치고\n도도대까지 북상해서……",
 "17552": "우리 대는 도도, 야마노우치\n두 부대를 상대하게 됐다.",
 "17553": "이래선 【注】꼼짝할 수 없다【終】.",
 "17554": "야마노우치대를 밀어내\n창벽에 부딪히게 하는 것도,",
 "17555": "물러나서\n진형을 바꾸는 것도\n불가능하다.",
 "17556": "나쓰카 님 부대는\n움직이기 힘들어 보이네.",
 "17557": "【心】（여기선 야마노우치대를\n막아 주는 것만으로도\n고마운가……）【終】",
 "17558": "음, 보고인가!",
 "17559": "아직 아사노대와 교전 중이오.",
 "17560": "아사노대의 기세는\n꺾일 줄을 모르오.",
 "17561": "우리 대에 【注】달라붙어\n떨어질 기색이 없소【終】.",
 "17562": "내 기마 돌격으로\n역전을 노리고 싶건만……",
 "17563": "적이 따라온다면\n【注】기마 돌격은 못 할 것【終】\n같네.",
 "17564": "모리 님이 달리\n할 수 있는 건 없을까?",
 "17565": "【心】（【終】【注】연계【終】【心】를 노린다면……）【終】",
 "17566": "【心】（누가 무엇을 할 수 있고\n없는지 가려내야겠군）【終】",
 "17567": "……보고로군요.",
 "17568": "창벽을 갖춘 채\n대기하고 있습니다.",
 "17569": "더 다가가면\n또 도망치겠지요.",
 "17570": "이쯤에서 방관……아니아니,",
 "17571": "적의 동태를\n살피는 중입니다.",
 "17572": "이젠 시원할 정도로\n소극적이네……",
 "17573": "뭐, 에케이 님은 일단……\n아니, 진짜 승려니까.",
 "17574": "되도록\n나서서 싸우고 싶지 않겠지.",
 "17575": "나쓰카대, 대기하라!",
 "17576": "야마노우치대와 도도대가\n못 움직이게 막아 줘!",
 "17577": "알고 있다!",
 "17578": "그보다……\n그것밖에 할 수 있는 게\n없다……",
 "17579": "나쓰카대를 움직이기보다",
 "17580": "다른 부대를 움직이는 게\n좋을 것 같네.",
 "17581": "야마노우치대를 전진시켜\n철포 사격 태세로\n끌고 가는 거다!",
 "17582": "미쓰나리, 내 【注】보고【終】를\n들었나?",
 "17583": "우리 대는\n두 부대를 상대로\n혼전 중……",
 "17584": "【注】이동은 불가능하다【終】.",
 "17585": "적 세 부대 모두\n철포 사격으로\n쓰러뜨릴 줄 알았는데……",
 "17586": "발상은 나쁘지 않아.",
 "17587": "하지만 나쓰카 님은 지금\n못 움직이는 것 같아.",
 "17588": "나는 지금 바쁘다!",
 "17589": "헛소리는 나중에 해라!",
 "17590": "꼭\n철포 사격을 하고 싶으면",
 "17591": "상황을 갖춘 다음에 하자.",
 "17592": "미안,\n마음이 급했다……",
 "17593": "이대로 적을 견제하고 있으면\n되는 거지요?",
 "17594": "알겠습니다.",
 "17595": "섣불리 에케이 님을\n전진시켜 봤자",
 "17596": "창벽을 두려워한 적이\n도망칠 뿐이다.",
 "17597": "여기선 대기가\n가장 무난하겠지.",
 "17598": "야마노우치대와 도도대를\n몰아붙입시다!",
 "17599": "그러면\n나쓰카대도 몰아붙이게\n된다, 이거군."
}