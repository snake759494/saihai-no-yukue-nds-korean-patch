{
 "7600": "지금 해야 할 일",
 "7601": "대포를 어떻게 할까",
 "7602": "대포를 옮기는 방법",
 "7603": "사콘을 물리면 된다",
 "7604": "대포를 쏘면 된다",
 "7605": "대포를 옮기면 된다",
 "7606": "소수의 병사가\n자리를 지키고 있다.",
 "7607": "깃발이 펄럭이고――",
 "7608": "저 나무가\n자꾸 신경 쓰인다.",
 "7609": "진심이다！",
 "7610": "지금 내가 해야 할\n일은 뭘까？",
 "7611": "다마는 알겠나？",
 "7612": "으음……",
 "7613": "가끔은 주군이\n직접 생각해 보든가！？",
 "7614": "방금 건 말장난 아니거든！",
 "7615": "【注】대포【終】를 어떻게 할지인데……。",
 "7616": "실은 아무것도\n떠오르지 않는다……。",
 "7617": "좀 더 여러 곳에서\n【注】정보를 모으고【終】\n생각하자.",
 "7618": "주군, 【注】대포【終】를 못 쓰는\n이유는 알았지？",
 "7619": "그래, 【言】대포의 사정거리가\n모자라【終】기 때문이다.",
 "7620": "사콘이 있는 전선까지는……",
 "7621": "도저히\n쏘아 넣을 수가 없다……。",
 "7622": "그걸 어떻게 할지인데……。",
 "7623": "주군 생각은 어때？",
 "7624": "대포의 사정거리가\n모자라다면――",
 "7625": "사콘을 물려서\n【注】대포【終】 사정거리에\n넣으면 된다.",
 "7626": "……그러면 모처럼\n바보 아버지가 밀고 있는데,",
 "7627": "의미가 없어지잖아！",
 "7628": "무엇 때문에 바보 아버지가\n애쓰고 있는지……",
 "7629": "좀 더 제대로 생각해！",
 "7630": "【心】（어쩐지 엄청난\n기세로 혼났군……）【終】",
 "7631": "그냥 쏘아 넣어 버리면\n어떨까？",
 "7632": "사정거리는\n모자랄지도 모르지만……",
 "7633": "적을 혼란시킬 수\n있을지도 모른다.",
 "7634": "주군……\n그럼 적뿐만 아니라",
 "7635": "아군도\n혼란스러워질 것 같은데……。",
 "7636": "정말, 정신 좀 차려！",
 "7637": "【言】대포를 이동【終】시키자.",
 "7638": "전선에 조금 더 가까이……",
 "7639": "사콘이 나아갈 곳을\n【注】대포【終】 사정거리\n안에 두면……。",
 "7640": "맞아！",
 "7641": "……그런데\n어떻게 옮기지……。",
 "7642": "다시 한번\n【注】여기저기 돌아【終】볼까.",
 "7643": "옮겨 달라고 부탁해 보자.",
 "7644": "【注】여유가 있어 보이는 부대【終】도\n몇 군데 있었잖아.",
 "7645": "【注】대포【終】를 옮기는\n방법 말인데……。",
 "7646": "……아직 짐작이 안 간다……。",
 "7647": "【注】여기저기 돌아보고【終】\n생각하는 게\n좋겠네.",
 "7648": "누구에게 옮겨 달라고\n할지는 정했다.",
 "7649": "그런데 다들\n거절했던 것 같은데……。",
 "7650": "뭐, 그렇긴 한데……。\n모두의 얘기를 종합하면……",
 "7651": "딱 한 명\n부탁할 만한 인물이 있었다.",
 "7652": "대포 이동을 부탁할\n만한 인물은――",
 "7653": "시마즈 도요히사 님이다.",
 "7654": "그 도요히사 님이 왜？",
 "7655": "그렇게 딱 잘라\n거절당했는데……。",
 "7656": "감이다！",
 "7657": "뭐야, 그게？",
 "7658": "좀 진지하게 생각해！",
 "7659": "시마즈 요시히로 님이다.",
 "7660": "그는 무척 한가해 보였다.",
 "7661": "그러니까――",
 "7662": "한가하다고 협력해 준다는\n보장은 없을 텐데……。",
 "7663": "그럼 이 사람은 어떠냐？",
 "7664": "다마, 너다！",
 "7665": "네엣！？",
 "7666": "주군, 잠깐 괜찮아？",
 "7667": "읏！　크헉！",
 "7668": "머리가 좀 맑아졌어？",
 "7669": "네……。",
 "7670": "【注】가모 사토이에【終】 말고는\n없겠지.",
 "7671": "가모 님……\n싫다고 하지 않았었나.",
 "7672": "확실히 그렇긴 한데……。",
 "7673": "가모에게 옮겨 달라는 게\n제일이겠지.",
 "7674": "가모가 옮기길 거부한\n이유를 없애 주면 된다.",
 "7675": "……앗！",
 "7676": "다시 【注】시마즈 진지【終】로 가자.",
 "7677": "대포에 대해",
 "7678": "대포를 움직이려면",
 "7679": "우와, 가까이서 보니\n역시 크네！",
 "7680": "이걸 콰앙！　하고\n적에게 쏘아 넣으면……。",
 "7681": "그런데……바보 아버지는\n【注】쓰기 불편하다【終】고\n했어.",
 "7682": "왜일까？",
 "7683": "대포다.",
 "7684": "기술의 정수를 모아 만든\n신병기……일 텐데,",
 "7685": "지금까지 한 번도\n실전에서 쓰인 적이 없다.",
 "7686": "대포를 관리하는 병사다.",
 "7687": "유난히 한가해 보이는군……。",
 "7688": "주군, 언제까지 여기서\n하염없이 기다려야\n합니까？",
 "7689": "여기선 공격하려 해도\n【言】사정거리가 모자라【終】\n니까요.",
 "7690": "아침부터 내내\n출전이 없어요.",
 "7691": "모처럼 가져왔는데\n못 쓰다니……。",
 "7692": "주군은 마무리가\n허술하다니까……。",
 "7693": "……면목 없다……。",
 "7694": "망루가 흔들흔들……。",
 "7695": "……어중간하다……。",
 "7696": "일도양단인가！",
 "7697": "이 【注】대포【終】 말인데……。",
 "7698": "일단 지금 그대로면\n【注】대포【終】는 못 쓰는\n거지？",
 "7699": "그 이유를 조사해 볼\n수밖에 없지 않아？",
 "7700": "【心】（여러 가지 【終】【注】살펴【終】【心】볼까）【終】",
 "7701": "【注】대포【終】를 움직이고 싶은데……\n대체 어떻게 하면……。",
 "7702": "보다시피 엄청 크고,",
 "7703": "주군 혼자선 도저히\n못 옮기겠지……。",
 "7704": "나는 보다시피\n연약한 여자애고……。",
 "7705": "그런 이상하다는 눈으로\n보지 마！",
 "7706": "【心】（여기서 섣불리 말했다간\n대참사다……）【終】",
 "7707": "누군가의 【注】부대를 움직여\n옮겨 달라는【終】 게\n제일일 거야.",
 "7708": "……옮겨 줄 만한 사람\n없었으려나？",
 "7709": "【心】（지금 들을 수 있는 얘기는\n다 들었나……？）【終】",
 "7710": "【注】대포를 어떻게 할지【終】\n판단이 설 것 같으면……",
 "7711": "한번 【注】본진【終】으로 돌아가서\n얘기를 정리해 보자.",
 "7712": "【注】본진【終】에서 【注】대포를\n어떻게 할지【終】 생각해\n보자.",
 "7713": "【心】（일단 모두의 얘기는\n들었으려나……？）【終】",
 "7714": "어때, 주군？",
 "7715": "【注】대포를 옮길 방법【終】\n떠오를 것 같아？",
 "7716": "문제는 많아 보이지만……",
 "7717": "【注】본진【終】으로 돌아가서\n어떻게 할지 생각해 보자.",
 "7718": "【注】본진【終】으로 돌아가서\n어떻게든 【注】대포를\n옮길 방법【終】을 생각하자.",
 "7719": "상황은 어떠냐？",
 "7720": "사콘의 상황",
 "7721": "대포에 대해 2",
 "7722": "대포를 못 움직이는 이유",
 "7723": "본진 뒤편 사사오산까지\n와 봤는데……。",
 "7724": "주군, 무슨 일이십니까？",
 "7725": "【注】가모【終】인가.",
 "7726": "여기에 무슨 볼일이라도？",
 "7727": "풀이 많구나.\n풀이 죽을 만큼.",
 "7728": "……한심해……。",
 "7729": "바, 방금 건 없던 걸로 해！",
 "7730": "어딘가 마음을 졸이게\n하는 나무다. 나무 졸려.",
 "7731": "나는 주군 쪽이\n더 조마조마해지는데.",
 "7732": "산이 보인다.",
 "7733": "……오를 틈은 없겠군.",
 "7734": "지금 상황을 알려 줘.",
 "7735": "아까 호소카와 다다오키에게\n본진 침입을\n허용했으니까요.",
 "7736": "다시는 그런 일이 없도록\n여기서 경계하고 있습니다.",
 "7737": "그리고 봉화도 팍팍\n올리고 있습니다.",
 "7738": "그런데 전혀 반응이 없는 건\n어떻게 된 걸까요？",
 "7739": "전선에서 싸우는 사콘 님께도\n면목이 없습니다……。",
 "7740": "사콘의 상황은 어떠냐？",
 "7741": "적을 밀고는\n있는 것 같습니다.",
 "7742": "다만……수비가 단단해서\n돌파에는 이르지 못하고……。",
 "7743": "밀었다 물러났다, 물러났다\n밀었다…이를 반복하고\n있습니다.",
 "7744": "어떻게 안 되겠습니까？",
 "7745": "【注】대포【終】 말인데……。",
 "7746": "아아, 주군이 필요하다며\n가져온 그거 말이군요.",
 "7747": "거창한 모양새지만\n사정거리가 너무 짧아서……",
 "7748": "여기서 쏴 봤자\n아군에게 맞는 게\n고작이겠지요.",
 "7749": "설마 저희더러 옮기라고\n하실 생각은 아니겠지요？",
 "7750": "【心】（그렇다……\n고는 말 못 할 분위기군）【終】",
 "7751": "【心】（하지만 여기서 사양해 봐야\n소용없다）【終】",
 "7752": "【注】대포【終】를\n사콘이 있는 전선까지\n옮겨 줬으면 한다.",
 "7753": "………………주군.",
 "7754": "그건 봐주시면 안 되겠습니까？",
 "7755": "너희에게 이동을 맡기면\n【注】곤란한 이유【終】라도\n있나？",
 "7756": "아이고, 설마요.",
 "7757": "그, 그렇지요！",
 "7758": "왜 【注】대포【終】를 못 움직이나？",
 "7759": "부대를 움직이면\n옮길 수는 있잖나？",
 "7760": "아니, 물론 옮기는 건\n가능합니다.",
 "7761": "가능합니다만……。",
 "7762": "지금 【注】대포【終】를\n움직이려 했다간……",
 "7763": "저희는\n【言】틀림없이 적의 먹잇감【終】이\n됩니다.",
 "7764": "…………아시겠지요, 주군？",
 "7765": "전선에 가까워질수록\n적의 공세는 거세집니다.",
 "7766": "그에 비해 저희는\n제대로 반격도 못 하고……。",
 "7767": "왜냐하면 【注】대포【終】를\n옮기는 데 집중해야\n하니까요.",
 "7768": "결국 저희도 격파당하고\n【注】대포【終】도 잃는 게\n고작입니다.",
 "7769": "【心】（그렇다 해도\n누군가 옮겨 줘야……）【終】",
 "7770": "무엇을 하고 있나",
 "7771": "대포에 대해 3",
 "7772": "시마즈대 진지 뒤편이다.\n높은 산이 저편에 보인다.",
 "7773": "아, 저 사람……！",
 "7774": "시마즈 요시히로 님……。",
 "7775": "자네들인가.",
 "7776": "이런 곳에서 무얼 하는가？",
 "7777": "기운찬 나무다.\n나무 기운차다.",
 "7778": "…………나쁘진 않은데？",
 "7779": "마음이 안 담겼어！",
 "7780": "풀이 잔뜩 나 있다.",
 "7781": "풀이 이만큼 있으니\n풀 죽을 것 같다……",
 "7782": "하아……。",
 "7783": "방금 건 그만……。",
 "7784": "높은 산이 우뚝 솟아 있다.",
 "7785": "아마 이부키산일 것이다.",
 "7786": "띄엄띄엄 바위가 늘어서 있다.",
 "7787": "바위처럼 입을 다물자.",
 "7788": "작지만 아름다운 꽃이다.",
 "7789": "나 같네！",
 "7790": "【心】（아무 말 않는 게\n무난하겠지）【終】",
 "7791": "요시히로 님은 이런 곳에서\n무엇을 하고 계십니까？",
 "7792": "나는……산책을 하고 있네.",
 "7793": "네……？\n산책 말입니까？",
 "7794": "그렇다.\n시마즈대 진에는 도요히사가\n있네.",
 "7795": "내가 없어도 문제없네.",
 "7796": "【心】（꽤나 여유롭군……）【終】",
 "7797": "저, 【注】대포【終】에 대해\n부탁이 있는데……。",
 "7798": "시마즈대가 옮기는 걸\n도와주실 수 없겠습니까？",
 "7799": "……우리가 왜\n도와야 한단 말인가？",
 "7800": "진을 떠나 이런 곳을\n산책하고 계시니,",
 "7801": "손이 비신 줄 알고……。",
 "7802": "이 사람, 더는 대답할\n생각이 없나 봐……。",
 "7803": "【心】（거절당했다는 건가）【終】",
 "7804": "다시 시마즈대 진지 뒤편으로\n가 봤지만…………。",
 "7805": "아무도 없네.",
 "7806": "현재 상황",
 "7807": "요시히로는 어디에？",
 "7808": "대포에 대해 4",
 "7809": "대포 이동에 대해",
 "7810": "적과 싸워 주었으면 한다",
 "7811": "대포를 옮겨 주었으면 한다",
 "7812": "굉장히 조용해……。",
 "7813": "여기는\n적이 별로 안 오나 봐.",
 "7814": "누구냐！！",
 "7815": "꺅！",
 "7816": "수상한 자인 줄 알았더니\n또 당신들인가……。",
 "7817": "도요히사 님밖에 없습니까？",
 "7818": "나도 요즘\n무서워지기 시작했다……。",
 "7819": "해가 높다……。\n점심은 미뤄야겠군.",
 "7820": "깃발이 내걸려 있다.",
 "7821": "시마즈 가문에 초대부터\n전해 내려오는 것이라 한다.",
 "7822": "상황에\n무슨 변화라도 있습니까？",
 "7823": "당신이 왜 그런 걸\n묻는지 모르겠지만……。",
 "7824": "우리 시마즈의 결속은\n단단합니다.",
 "7825": "고바야카와대가 배반했다는\n소식에도 동요하지 않고……",
 "7826": "흘러들어 온 적군을\n각개격파하고 있습니다.",
 "7827": "……또 아군이 적을\n부추기지만 않는다면……",
 "7828": "우리에게 사각은 없습니다.",
 "7829": "【心】（……또 비아냥이군……\n내가 그렇게 미움받나）【終】",
 "7830": "（주군, 여기가 조용한 것도\n아직 전선이 아니라서구나）",
 "7831": "【心】（그렇다면 【終】【注】시마즈대에는\n여유가 있다【終】【心】……는\n건가）【終】",
 "7832": "【注】대포【終】에 대한\n얘기입니다만……。",
 "7833": "【注】대포【終】……？",
 "7834": "그 덩치만 큰\n쓸모없는 병기 말입니까？",
 "7835": "확실히 【注】대포【終】는……",
 "7836": "옮기는 데 일손이 들고\n사정거리도 짧습니다.",
 "7837": "하지만……\n그만큼 파괴력은 발군입니다.",
 "7838": "저는 이 【注】대포【終】를 써서……",
 "7839": "도쿠가와 이에야스에게\n이르는 길을 열 생각입니다.",
 "7840": "흥……。",
 "7841": "시마즈대는 【注】여유가 있는【終】\n것으로 보입니다.",
 "7842": "【注】대포【終】를 전선까지\n옮겨 주실 수 없겠습니까？",
 "7843": "………………………………흥.",
 "7844": "……거절하겠습니다.",
 "7845": "말이 안 되는군요.",
 "7846": "무슨 의리가 있어서\n일부러 위험을 무릅쓰고……",
 "7847": "우리가 전선에 【注】대포【終】를\n옮겨야 한단 말입니까.",
 "7848": "병사의 목숨이 헛되이\n잃게 될 걸 알면서……",
 "7849": "그런 일에 찬성할 바보가\n어디 있습니까？",
 "7850": "그, 그런 뜻은……。",
 "7851": "【心】（……시마즈대의 협력은\n얻을 수 없는 걸까……？）【終】",
 "7852": "요시히로 님은 어디에？",
 "7853": "백부님 계신 곳을 알아서\n어쩌시려는 겁니까？",
 "7854": "……아니요, 딱히……。",
 "7855": "근처에 계실 겁니다.",
 "7856": "뭐, 용건도 없이 찾아가시면\n폐가 될 뿐이지만……。",
 "7857": "【心】（여전히\n가시가 돋쳤군……）【終】",
 "7858": "【心】（【終】【注】진 뒤편【終】【心】이라도 찾아볼까？）【終】",
 "7859": "시마즈대에 부탁드리고\n싶은 것이 있습니다.",
 "7860": "【注】대포【終】에 관한 일입니다만……。",
 "7861": "시마즈대에는――",
 "7862": "시마즈대에는 【注】대포【終】를\n옮겨 주셨으면 합니다.",
 "7863": "아까 한 얘기를\n잊으셨습니까？",
 "7864": "우리는 병사의 목숨을\n헛되이 잃는 일은\n하지 않는다.",
 "7865": "그렇게 말씀드렸을 텐데……。",
 "7866": "주군, 무슨 부탁을\n하러 왔는지\n침착하게 생각해！",
 "7867": "시마즈대에는 적과\n싸워 주셨으면 합니다.",
 "7868": "……무슨 말씀입니까？",
 "7869": "【注】대포【終】에 관한 부탁이라고……\n그렇게 들었습니다만？",
 "7870": "그렇습니다.",
 "7871": "제 부하가 전선까지\n【注】대포【終】를 옮기는\n동안……",
 "7872": "시마즈대는\n적을 끌어들여\n주셨으면 합니다.",
 "7873": "…………흐음？",
 "7874": "지금 시마즈대 외의 아군은\n눈앞의 적을 상대하기도\n벅찹니다.",
 "7875": "새로 적을 끌어들여 주의를\n돌릴 수 있는 아군은……",
 "7876": "당신들뿐입니다.",
 "7877": "………………흥.",
 "7878": "여기까지\n최소한의 손해로 왔거늘……",
 "7879": "그런 위험한 역할을……。",
 "7880": "（시마즈대는 용맹하기로\n유명하지 않았어？）",
 "7881": "（아침부터 줄곧\n생각했는데……）",
 "7882": "（왜 이렇게\n소극적인 걸까？）",
 "7883": "【心】（시마즈대를 배신자로\n몰려던 적의 계략……）【終】",
 "7884": "【心】（그 덕에 오히려 시마즈대는\n믿을 수 있다고 생각했다）【終】",
 "7885": "【心】（하지만 의혹이 풀려도……）【終】",
 "7886": "【心】（시마즈대의 둔한 움직임은\n변함없다……）【終】",
 "7887": "【心】（대체 왜？）【終】",
 "7888": "【心】（시마즈대의 수장 요시히로\n님께 직접 얘기를 듣고\n싶다……）【終】",
 "7889": "요시히로 님은 어디 계십니까？",
 "7890": "잠시 얘기를 나누고 싶은데요.",
 "7891": "확실히 백부님을 제쳐 두고\n제가 판단할 순 없지요.",
 "7892": "백부님은 【注】진 안【終】에 계십니다.",
 "7893": "직접\n만나 보시는 게 좋겠지요.",
 "7894": "대포 이동에 대한 협력",
 "7895": "시마즈대의 목적",
 "7896": "이에야스를 치기 위해",
 "7897": "아군을 위해",
 "7898": "시마즈대 진지 안으로\n들어가게 해 주었는데……。",
 "7899": "저, 저기？\n요시히로 님？",
 "7900": "저……\n설마 주무시는 중입니까……？",
 "7901": "바보 같은 소리 마라.",
 "7902": "깨어 있네.",
 "7903": "서툰 사람에겐\n다루기 힘들어 보이는\n무기로군.",
 "7904": "나는\n주군이 더 다루기 힘든데……。",
 "7905": "이 갑옷, 무거워 보인다.",
 "7906": "갑옷 입고 비틀거리다니\n갑갑하기 짝이 없다……。",
 "7907": "갑갑한 건\n주군 쪽이야……。",
 "7908": "책상이다.",
 "7909": "책상에서 책 상상……\n좋아, 이건 어떠냐？",
 "7910": "어떠냐고 해도……억지인데다\n하나도 재미없어.",
 "7911": "으윽……가혹하다……。",
 "7912": "십자 문양이\n크게 그려져 있다.",
 "7913": "취류기가 바람에 나부낀다.",
 "7914": "깃발과 마찬가지로\n시마즈대 고유의 기치다.",
 "7915": "【注】대포【終】 이동을 위해\n시마즈대의 협력을\n부탁드릴 수 없겠습니까？",
 "7916": "제 부하가 【注】대포【終】를\n전선까지 옮기는 동안만\n도와주시면 됩니다.",
 "7917": "시마즈대의 힘으로\n적을 막아 주십시오！",
 "7918": "………………그런가.",
 "7919": "………………？",
 "7920": "【心】（그게 다냐！）【終】",
 "7921": "에, 그러니까요……",
 "7922": "지금 상황을 타개하려고……\n사콘이 도쿠가와 이에야스를\n칩니다.",
 "7923": "그 공격을 성공시키려면\n【注】대포【終】가 꼭 필요합니다.",
 "7924": "【心】（또 그게 다인가？）【終】",
 "7925": "자네는……",
 "7926": "자네는\n어느 쪽을 목적으로 하는가？",
 "7927": "「이에야스를 치기 위해」인가.",
 "7928": "아니면……",
 "7929": "「아군을 위해」인가.",
 "7930": "제 목적은――",
 "7931": "물론\n이에야스를 치기 위해서입니다！",
 "7932": "이대로라면 점점\n적군이 밀고 들어올 겁니다.",
 "7933": "그러니 그 전에 어떻게든――",
 "7934": "이제 됐네.",
 "7935": "……네？",
 "7936": "이제 됐다고 하지 않나！",
 "7937": "주군의 대답……\n마음에 안 들었나 봐.",
 "7938": "하지만 포기할 수는\n없어.",
 "7939": "다시 한번 얘기해 보자.",
 "7940": "결국은 아군을 위해서……\n라고 생각합니다.",
 "7941": "지금의 저희는……",
 "7942": "고바야카와의 배반으로\n우세에서 일전,\n아슬아슬한 전황입니다.",
 "7943": "이 정세가 계속되면……",
 "7944": "언젠가 저희 쪽이\n밀려나고 말 겁니다.",
 "7945": "그렇기에 직접\n이에야스를 치는 데\n걸고 싶습니다.",
 "7946": "걸 수밖에 없습니다……。",
 "7947": "그렇다고 해서 허무하게\n사콘을 사지로 몰 순\n없습니다.",
 "7948": "사콘을 위해 【注】대포【終】가\n필요합니다. 하지만……",
 "7949": "그 【注】대포【終】를 옮기려면\n부하에게 위험을\n강요하게 되니…。",
 "7950": "사콘을 비롯한 제 부하……\n그리고……",
 "7951": "세키가하라에 선\n모든 아군을 위해……",
 "7952": "시마즈대의 협력을 바랍니다！",
 "7953": "자네 생각은 잘 알았네.",
 "7954": "그럼……협력을……。",
 "7955": "그건 그거고\n또 다른 얘기일세……。",
 "7956": "줄곧\n마음에 걸리던 게 있습니다.",
 "7957": "어째서 당신들은\n적극적으로 싸우려 하지\n않습니까？",
 "7958": "애초에 싸울 생각이\n없었으니 어쩔 수 없지.",
 "7959": "………………네？",
 "7960": "그럴 수가！",
 "7961": "싸울 생각이 없다니……\n무슨 말씀입니까！",
 "7962": "…………그렇다.",
 "7963": "모든 게 나의 불찰 탓이네.",
 "7964": "무엇이 진실이고 거짓인지\n가려내지 못한 채……",
 "7965": "적은 병력으로\n전장에 서고 말았지.",
 "7966": "……요시히로……님……？",
 "7967": "………………이시다 공.",
 "7968": "자네에게 협력하겠네.",
 "7969": "단！",
 "7970": "자네의 지휘에\n조금이라도 흐림이 있으면……",
 "7971": "우리는 일절 따르지 않겠네.",
 "7972": "똑똑히 명심하게！",
 "7973": "좋아, 이걸로 사콘을\n원호할 수 있다！",
 "7974": "봐, 주군！\n이제 【注】대포【終】가\n전장에 닿을 거야.",
 "7975": "본진으로 돌아가서\n지휘를 해야지！",
 "7976": "【心】（요시쓰구……\n아직 무사하겠지……？）【終】",
 "7977": "【心】（사콘……\n나는 너를 믿는다……！）【終】",
 "7978": "【心】（그러니 반드시……！）【終】",
 "7979": "적은 무작정\n돌격해 올 뿐이다.",
 "7980": "침착하게 각개격파하라！",
 "7981": "예, 알겠습니다！",
 "7982": "주군, 고바야카와대가\n산꼭대기로 물러갑니다！",
 "7983": "……방심하지 마라.",
 "7984": "다시 공격해 오는 건\n시간문제다.",
 "7985": "역시\n공격해 오지 않는가,\n도도 다카토라……。",
 "7986": "그만한 지략가가\n눈치채지 못했을 리 없지……。",
 "7987": "쉽사리 뜻대로 되게\n두지는 않겠다.",
 "7988": "사콘 님이 이에야스를\n칠 때까지의 시간……\n벌어 보이겠다！",
 "7989": "과연 오타니 요시쓰구.",
 "7990": "잘도 막아 내는군.",
 "7991": "이시다 미쓰나리 따위에\n붙지만 않았어도……。",
 "7992": "그러니까 재미있는 건가.",
 "7993": "………………………자, 그럼.",
 "7994": "산을 올라 볼까.",
 "7995": "……저것이 오타니\n요시쓰구……。 뛰어난\n군략가라 들었는데……。",
 "7996": "……그만둬라……。",
 "7997": "……중병에 걸려\n살날이 얼마 안\n남았다던가……。",
 "7998": "……나쁜 말 안 할 테니\n엮이지 않는 게 좋아……。",
 "7999": "【シ】…………………………………………【終】"
}