{
 "4400": "그는 믿지 않는 게 좋다.",
 "4401": "고바야카와 공은 히데요시 님의\n후계자 후보였던 분이다.",
 "4402": "다른 누가 배신하든\n그만은……。",
 "4403": "후……。",
 "4404": "정말이지, 너라는 사내는……。\n좋은 의미로 바보로군.",
 "4405": "잘 들어라, 미쓰나리.",
 "4406": "너 자신도 방금 말했을 터.",
 "4407": "후계자 후보「였다」고.",
 "4408": "고바야카와 공은\n적자 히데요리 님의 탄생으로,",
 "4409": "일개 친척\n다이묘로「강등」되었다고 할\n수도 있다.",
 "4410": "그것이 의미하는 바는……。",
 "4411": "……！",
 "4412": "그럼\n이 일련의 둔한 움직임도……？",
 "4413": "무언가 속사정이 있다……\n고 생각할 수도 있다.",
 "4414": "왜 시마즈대 얘기를？",
 "4415": "다소 억지였지만 그들의 협력은\n얻어 냈다？",
 "4416": "아아.\n과연 미쓰나리다운 지휘였지.",
 "4417": "하지만 그 뒤 【注】시마즈대는\n적극적으로 움직이지 않고\n있다【終】.",
 "4418": "그럼――",
 "4419": "미쓰나리,\n오해하지 마라.",
 "4420": "나는 시마즈대 내통의 증거를\n쥐고 있는 게 아니다.",
 "4421": "다만 그들이 내통하지 않았다는\n확증도 가질 수 없는 거다.",
 "4422": "시마즈대의 전력은\n대략 1500……。",
 "4423": "56만 석의 대다이묘가 보낸\n병력치고는 너무 적다.",
 "4424": "정예라 하면 그럴듯하지만\n전력이 아닌 건 분명하다.",
 "4425": "무슨 이유가 있다고\n생각하는 편이 좋겠지.",
 "4426": "과연……。\n주의해서 나쁠 건 없겠군.",
 "4427": "요시쓰구……나는 어떻게 하면\n되지？",
 "4428": "미쓰나리……。",
 "4429": "네가 고바야카와와 시마즈의\n정체를 가려내 주었으면 한다.",
 "4430": "모리대는 괜찮나？\n똑같이 움직임이 둔한데……",
 "4431": "모리대는 전장 너머 남동쪽\n산꼭대기에 포진해 있다.",
 "4432": "의심이 사실이 되더라도\n대응할 시간은 있겠지.",
 "4433": "고바야카와대와 시마즈대가\n동시에 배신하면……",
 "4434": "인접한 우리는\n퇴로가 끊긴다.",
 "4435": "【心】（시마즈와 고바야카와 일은\n급하다는 건가……）【終】",
 "4436": "겁을 줘 버렸나……？",
 "4437": "내통 의심 따위\n내 억측이면 좋겠지만……。",
 "4438": "하지만 상황에 따라선\n이 포진도 바꿔야 한다.",
 "4439": "…………미쓰나리.",
 "4440": "【注】고바야카와대, 시마즈대가\n배신하지 않는다는 증거【終】를\n찾아서,",
 "4441": "다시 한 번 【注】내게\n와 주지【終】 않겠나？",
 "4442": "……알았다.\n기다려 줘.",
 "4443": "움직이지 않는 이유",
 "4444": "불안이란",
 "4445": "협력이란",
 "4446": "있다",
 "4447": "없다",
 "4448": "모리대에 대해",
 "4449": "시마즈대에 대해",
 "4450": "오타니대에 대해",
 "4451": "헉헉……。",
 "4452": "아무리 고바야카와 님 진지가\n산 위에 있다지만,",
 "4453": "그렇게까지 숨이 차다니……。",
 "4454": "………………헉헉.",
 "4455": "아무리 그래도\n너무 단련이 부족해！",
 "4456": "…………이제 됐어.",
 "4457": "……여기는……。",
 "4458": "중앙 전장이 손에 잡힐 듯\n내려다보인다……。",
 "4459": "정말이네. 경치가 엄청 좋아.",
 "4460": "그러니 봉화도 보였을 터다.",
 "4461": "봉화는 보였습니다.",
 "4462": "고바야카와 공…………。",
 "4463": "고바야카와 히데아키 공……。",
 "4464": "돌아가신 히데요시 님의\n조카이자 한때는 양자이기도\n했던 분.",
 "4465": "지금은 지쿠젠 30여만 석의\n대다이묘이며,",
 "4466": "우리 군의 주력이 될 1만\n5천 병력을 이끌고 있다.",
 "4467": "어째서 봉화를 알아차리고도\n움직이지 않았는가.",
 "4468": "우선 그것을 묻고 싶다.",
 "4469": "대장께서 몸소 이런 곳까지\n걸음해 주시다니,",
 "4470": "이 어찌 황송한 일인지요.",
 "4471": "제게 불찰이 있음은\n잘 알고 있습니다.",
 "4472": "부디\n거리낌 없이 말씀해 주십시오.",
 "4473": "（주군, 이 사람……\n왜 이렇게 공손해？）",
 "4474": "（내가 아는 한 옛날부터다）",
 "4475": "고바야카와 공의 진이다.",
 "4476": "산꼭대기에 진을 쳤다.",
 "4477": "고바야카와 가문의 문장이다.",
 "4478": "이거, 풀 베는 낫이\n한 쌍으로 돼 있네……。",
 "4479": "재밌는 가문 문장이네.",
 "4480": "딱히 별것 없다.",
 "4481": "망루다.",
 "4482": "산꼭대기 망루라면\n전망이 아주 좋겠군.",
 "4483": "나무 울타리다.",
 "4484": "이 울타리, 누가 울타리……。",
 "4485": "미안하게 됐군！",
 "4486": "해자가 파여 있다.",
 "4487": "말해 두지만……。",
 "4488": "네네, 말장난할 생각은\n아니었다는 거지.",
 "4489": "가볍게 넘겨졌다！",
 "4490": "아까 봉화는 보였다고\n말씀하셨지요？",
 "4491": "그렇다면 어째서\n당신은 움직이지 않았습니까？",
 "4492": "저는 도요토미 가문에 연이\n닿는 자.",
 "4493": "어찌 협력을 아끼겠습니까.",
 "4494": "지금 할 수 있는 일이라면,",
 "4495": "가능한 한 무엇이든\n할 생각입니다.",
 "4496": "하지만 지금\n이 마쓰오산을 내려가,",
 "4497": "싸움에 참가하기에는\n【注】불안【終】이……。",
 "4498": "【注】불안【終】이란 대체……？",
 "4499": "…………………………。",
 "4500": "【心】（동그란 눈으로 마주 본다）【終】",
 "4501": "【心】（……뒷말은 없는 건가？）【終】",
 "4502": "이 절호의 기회에\n움직이지 못할 만큼의 【注】불안【終】……",
 "4503": "그것은 어떤 것입니까？",
 "4504": "그걸 입에 담으면 근거 없는\n중상이 될 것 같아서……。",
 "4505": "도저히 제 입으로는\n말씀드릴 수 없습니다.",
 "4506": "（주군, 고바야카와 님의\n【注】불안【終】에 짚이는 거 있어？）",
 "4507": "고바야카와 공의 【注】불안【終】에 짚이는\n건……",
 "4508": "……떠오르지 않는군.",
 "4509": "중상이 된다는 건\n다른 사람 얘기겠지.",
 "4510": "그런 얘기\n들은 적 없었나？",
 "4511": "어땠더라……。",
 "4512": "…………그럼 다른 사람한테\n얘기 들으러 가 볼래？",
 "4513": "전장 전체 사정에 밝을 것\n같은 【注】머리 좋은 사람【終】이라든가.",
 "4514": "【心】（이 절호의 기회에 움직이지\n못할 만큼의 【終】【注】불안【終】【心】……）【終】",
 "4515": "【心】（게다가\n중상에 해당한다면……）【終】",
 "4516": "있는 것 같았는데\n역시 떠오르지 않는다……。",
 "4517": "【心】（하나\n짚이는 게 있는데……）【終】",
 "4518": "……대장인 이시다 공이라면,",
 "4519": "제 가슴에 소용돌이치는 불안\n따윈 다 꿰뚫어 보시겠지요,",
 "4520": "그렇지 않을까요……？",
 "4521": "괜찮으시다면\n들려주시지 않겠습니까？",
 "4522": "（이 사람, 자기 입으로는\n말 못 한다더니）",
 "4523": "（주군한테 말하게 하려고\n해！）",
 "4524": "（내가 아는 한 옛날부터\n그렇다）",
 "4525": "당신이 움직이지 못하는 이유,\n제가 알려 드리지요.",
 "4526": "그것은――",
 "4527": "모리대 때문이군요？",
 "4528": "모리 공이\n어떻게 되셨습니까？",
 "4529": "저로서는\n짚이는 바가 없습니다만……。",
 "4530": "주군……모리대는 전장을 사이에\n두고 반대편에 있잖아？",
 "4531": "별로 고바야카와 님하곤\n상관없지 않아？",
 "4532": "죄송합니다, 고바야카와 공.\n다시 말하겠습니다.",
 "4533": "오타니대 때문이군요？",
 "4534": "【心】（환각……인가？　방금\n한순간……）【終】",
 "4535": "……어찌 오타니 공을\n불안히 여기겠습니까.",
 "4536": "오타니 공은 의리가 두텁고\n뛰어난 군재도 지니셨지요.",
 "4537": "그런 분이 우리 군 앞에\n포진해 주시니……",
 "4538": "든든하게 여길지언정\n불안이라니요……。",
 "4539": "이시다 공……다른 말씀이\n있으신 건 아닌지？",
 "4540": "아……예.\n잠깐 다시 말하겠습니다.",
 "4541": "【注】시마즈대 때문【終】이군요？",
 "4542": "………………과연이십니다.",
 "4543": "겁쟁이라\n여기실지 모르지만,",
 "4544": "저는 두렵습니다.",
 "4545": "그들의 진의가 보이지 않는\n것이……。",
 "4546": "……「진의」라 하심은？",
 "4547": "시마즈대는 맹장 일색으로 그\n용맹함이 천하에 알려져\n있지요.",
 "4548": "그런 그들이 이 싸움에선\n유난히 소극적이라 들었습니다.",
 "4549": "아침 싸움에서도\n고니시대에 협력하지 않고,",
 "4550": "제 몸에 튀는 불똥만 털어\n내는 듯한 싸움이었다고요.",
 "4551": "어째서 시마즈대는 스스로\n전선을 열어 가려 하지\n않는가……。",
 "4552": "그 불안이 걷히지 않는 한,",
 "4553": "시마즈대 근처에\n뛰어들 수는 없습니다.",
 "4554": "저는 1만 5천 대군을 맡은\n몸.",
 "4555": "어찌\n경솔한 행동에 나서겠습니까？",
 "4556": "돌아가신 아버님……아니,\n히데요시 님도,",
 "4557": "제 말을\n이해해 주시겠지요……。",
 "4558": "………………과연.",
 "4559": "그렇다면 시마즈대를 믿을 수\n있게 된다면,",
 "4560": "함께 싸워 주신다고\n여겨도 되겠습니까？",
 "4561": "…………물론이고말고요.",
 "4562": "【注】시마즈대에 대한 의심【終】,",
 "4563": "부디 당신의 힘으로\n풀어 보여 주시지 않겠습니까？",
 "4564": "협력해 주신다 함은\n대체 어떤……？",
 "4565": "아아, 불안으로 머리가\n가득해서,",
 "4566": "움직이지 못하는 대신 준비한\n것을 건네 드리지 못할\n뻔했군요.",
 "4567": "이런 것이 큰 도움이 될 것\n같진 않아 송구하지만,",
 "4568": "이것을\n받아 주시지 않겠습니까？",
 "4569": "……이것은……？",
 "4570": "이 마쓰오산 꼭대기에서 본\n【注】포진도【終】입니다.",
 "4571": "【注】오타니대【終】와 【注】도도대【終】를\n중심으로 적어 두었습니다.",
 "4572": "이 마쓰오산 기슭은\n지형이 복잡하지요……。",
 "4573": "그 지략가인\n도도 다카토라가,",
 "4574": "병사를 매복시켰을지도\n모릅니다.",
 "4575": "주제넘은 짓인가\n싶었지만,",
 "4576": "조금이라도 도움이 되었으면\n해서……。",
 "4577": "이시다 공 같은 전략가께서\n보시면,",
 "4578": "어린애 장난과 같겠지만\n말입니다……。",
 "4579": "아뇨, 당치도 않습니다！",
 "4580": "받겠습니다！",
 "4581": "그렇습니까.\n도움이 되어 기쁩니다！",
 "4582": "말씀은 잘 알았습니다.",
 "4583": "시마즈대에는\n제가 가겠습니다.",
 "4584": "이시다 공.\n이 얼마나 든든한 말씀인지요.",
 "4585": "그 말씀을 믿고\n저도 출격에 대비하겠습니다.",
 "4586": "그럼……。",
 "4587": "오타니 님은 고바야카와 님도\n믿을 수 없다고 했는데,",
 "4588": "고바야카와 님은 고바야카와\n님대로 시마즈대가\n수상하다고……。",
 "4589": "이제 누굴 믿어야 할지\n모르겠어……。",
 "4590": "하지만 누가 거짓말을 하든\n함정을 놓든,",
 "4591": "진실이 아니라면 어딘가에\n구멍이 있을 거다.",
 "4592": "역시 주군.\n맷집이 좋네.",
 "4593": "……그 정도는 아닌 것\n같은데.",
 "4594": "아하하하.",
 "4595": "그럼 얼른\n【注】시마즈대 진지【終】로 가 보자！",
 "4596": "고바야카와 히데아키에 대해",
 "4597": "오타니대 진지에\n돌아와 봤는데……。",
 "4598": "오타니 님, 바빠 보였어.",
 "4599": "시마즈대 정보도 모은 다음에\n다시 오자.",
 "4600": "그렇군.",
 "4601": "다마, 고바야카와 히데아키\n공에 대해 눈치챈 게 있나？",
 "4602": "도련님 같아 보였지만\n그렇지도 않은 것 같아……。",
 "4603": "왜냐면\n고바야카와대가 포진한 곳,",
 "4604": "엄청 유리한 곳에 있어.",
 "4605": "아군으로서도……무엇보다\n적이 됐을 때도……。",
 "4606": "여러모로 마음에 새겨 두자.",
 "4607": "시마즈대 진중",
 "4608": "인기척이 없군.",
 "4609": "누구 없소～！",
 "4610": "아무도 없습니까～！",
 "4611": "아무도 없는 것 같네.",
 "4612": "진 안으로 【注】이동【終】해 보자.",
 "4613": "지금 보니 한층 더\n압도되는 분위기가 있군.",
 "4614": "바라건대 우리도 적이\n되고 싶지 않은데……。",
 "4615": "점심 무렵이 되어\n점점 밝아졌다.",
 "4616": "깃발이 잔뜩 있다.",
 "4617": "명문 시마즈 가문의 문장이다.",
 "4618": "어디 있었는가",
 "4619": "도요히사의 용건이란",
 "4620": "직접 얼굴을 마주하지 않았다",
 "4621": "직접 만났다",
 "4622": "여기에도 아무도 없다……。",
 "4623": "시마즈대 사람들\n어디 가 버린 걸까.",
 "4624": "일단 조금 기다려 볼래？",
 "4625": "아아, 그러자.",
 "4626": "【心】（시마즈대 진중인가……\n꽤 흥미로운 것이 있군）【終】",
 "4627": "【心】（그냥 기다리기도 무료하다.\n이것저것 【終】【注】살펴볼까【終】【心】）【終】",
 "4628": "무기가 잔뜩 늘어서 있다.",
 "4629": "무기라서 그런가 으스스……。",
 "4630": "나는 주군 쪽이 더\n으스스해……。",
 "4631": "갑옷이다.",
 "4632": "장식이 아니라\n실제로 쓸 수 있는 것 같다.",
 "4633": "나무 책상이다.",
 "4634": "꽤 오래 써 온 것 같다.",
 "4635": "진막이다.",
 "4636": "이쪽에도 십자 문장이 있다.",
 "4637": "후키나가시다.",
 "4638": "깃발 장식의 하나로\n부대를 구별하는 데 쓴다.",
 "4639": "이 책상 위에 아무렇게나\n놓인 종이는……",
 "4640": "……이런 곳에\n내팽개쳐 두다니……。",
 "4641": "……읽어 달라고 말하는\n거나 마찬가지 아닌가？",
 "4642": "아닌 것 같은데？",
 "4643": "…………신경 쓰이는군.",
 "4644": "그럼 읽어 버리면？",
 "4645": "우리는 시마즈대를 믿을 수\n있는지 조사하고 있다.",
 "4646": "그러니 이건 호기심이 아니다.",
 "4647": "즉, 켕기는 것 따윈――",
 "4648": "아이 참, 답답해！\n읽고 싶으면 읽으면 되잖아！",
 "4649": "어디 보자……………………。",
 "4650": "「우리 시마즈는 도쿠가와\n이에야스 공에게……",
 "4651": "【注】편이 될 것을 약속한다【終】」",
 "4652": "！！！！！！！",
 "4653": "주군, 왜 그래？",
 "4654": "이리 줘 봐！",
 "4655": "시마즈대가 배신한다……\n그런……。",
 "4656": "다마, 성급하게 굴지 마라！",
 "4657": "이 서장이 진짜라고\n정해진 건 아니……。",
 "4658": "그치만 이 서장……",
 "4659": "【注】도요히사 님의 진언 서장과\n같은 필체야【終】！！",
 "4660": "무얼 떠드느냐！",
 "4661": "수상한 자인가 했더니……。",
 "4662": "이시다 공, 대장인 그대가\n우리 진에 무슨 볼일인가？",
 "4663": "요시히로 공……。",
 "4664": "시마즈 요시히로 공.",
 "4665": "수많은 명지휘와 무훈으로\n「귀신 시마즈」라 불리는\n영웅.",
 "4666": "긴 역사를 지닌 시마즈\n가문에서도 걸출한 존재다.",
 "4667": "조카 도요히사 공을 비롯해\n가중에는 그를 숭배하는 자가\n많다.",
 "4668": "……얼핏 보면\n온화한 인물 같지만……。",
 "4669": "……방금 그 기백……\n역시 보통 인물이 아니다.",
 "4670": "그대,\n방금 뭔가 숨기지 않았나？",
 "4671": "아, 아니요！",
 "4672": "【心】（허둥지둥 숨겨 버렸지만……\n이제 와서 되돌릴 수도……）【終】",
 "4673": "……그런가.",
 "4674": "뭐, 훔칠 가치가 있는 물건\n따위 아무것도 없을 게다.",
 "4675": "그래서, 내게 무슨 볼일인가？",
 "4676": "일부러 대장이 걸음했다면\n어지간한 용건이겠지.",
 "4677": "몰래 진중을 캐고 다니지 말고\n말해 보게.",
 "4678": "【心】（뭔가 확인할 방법은\n없을까）【終】",
 "4679": "【心】（요시히로 공께 보여 볼까）【終】",
 "4680": "요시히로 공,\n이것을 본 기억이 없으십니까？",
 "4681": "본 기억은 없네.",
 "4682": "그것뿐입니까？",
 "4683": "그렇네.",
 "4684": "하, 하지만 이 내용은――",
 "4685": "그런 것은 본 기억이 없네.",
 "4686": "내가 말할 수 있는 건\n그것뿐일세.",
 "4687": "【心】（시치미를 떼는 건가……\n정말 본 적이 없는 건가……）【終】",
 "4688": "【心】（반응이 너무 적어서\n판단할 수 없다……！）【終】",
 "4689": "단도직입적으로 용건을\n말씀드리겠습니다.",
 "4690": "오늘 아침 전투 개시 이래\n시마즈대는 적극적으로 싸우지\n않으시는 듯합니다.",
 "4691": "그 이유를 여쭙고 싶습니다.",
 "4692": "시마즈에는 시마즈의 방식이\n있네.",
 "4693": "……그것뿐입니까？",
 "4694": "【心】（과묵할 뿐인가……\n뭔가 숨기는 건가……）【終】",
 "4695": "【心】（도무지\n종잡을 수가 없군……）【終】",
 "4696": "【心】（차라리 그 서장을 【終】【注】사용【終】【心】해서\n보여 볼까）【終】",
 "4697": "……그러고 보니……",
 "4698": "아까는 진중에\n계시지 않았던 것 같은데요.",
 "4699": "어디 가셨습니까？",
 "4700": "……내가 어디 있었는지\n그대에게 말할 필요가 있나？",
 "4701": "지장이 없으시다면\n부탁드립니다.",
 "4702": "아니……그다지 필요 없을지도\n모르겠습니다.",
 "4703": "그렇다면 말하지 않겠네.",
 "4704": "아, 아니, 죄송합니다！",
 "4705": "필요합니다.\n들려주십시오！",
 "4706": "그런가……。",
 "4707": "숨길 만한 일도 아니지.",
 "4708": "전선의 도요히사에게\n【注】불려 갔던【終】 것이네.",
 "4709": "급한 용무가 있다고 해서\n말이지.",
 "4710": "【心】（급한 용무？）【終】",
 "4711": "【心】（설마 이 【終】【注】배신 승낙 서장【終】【心】과\n무슨 관계가……）【終】",
 "4712": "도요히사 공은 어떤 용무로\n당신을 불렀습니까？",
 "4713": "……도요히사의 용무가 뭔지\n그대에게 말할 필요가 있나？",
 "4714": "나도 모르니 말일세.",
 "4715": "도요히사 녀석, 나를\n불러 놓고서는,",
 "4716": "상황이 바뀌었으니 지금은\n진으로 돌아가라고 해 왔네.",
 "4717": "（주군……방금 거랑 비슷한\n얘기 어디서 들은 것 같지\n않아？）",
 "4718": "（그런가？）",
 "4719": "（아이 참……！머리 부딪쳐서\n잊어버린 거야？）",
 "4720": "（봐, 【注】도요히사 님의 오해를\n풀었을 때【終】 얘기야）",
 "4721": "（그렇다……비슷하다……。\n분명 그때는――）",
 "4722": "무얼 소곤거리는가？",
 "4723": "할 말이 있으면\n하면 될 것이네.",
 "4724": "알겠습니다.",
 "4725": "요시히로 공, 확인하게 해\n주십시오.",
 "4726": "도요히사 공과 당신은――",
 "4727": "도요히사 공과 당신은\n만나지 않았다, 그렇지요？",
 "4728": "그렇네.",
 "4729": "내가 방금\n말한 그대로일세.",
 "4730": "그래서 무엇을 확인했는가？",
 "4731": "……어라？\n그러고 보니……。",
 "4732": "주군……아무 생각 없이\n질문했지.",
 "4733": "확인하고 싶은 걸 제대로\n생각하고 나서 질문해.",
 "4734": "요시히로 공……",
 "4735": "도요히사 공과 당신은\n직접 만났다……그렇지요？",
 "4736": "……어디를 어떻게 해석하면\n그리 되는가？",
 "4737": "주군……뭘 확인해야 하는지\n알고 있어？",
 "4738": "요시히로 님이 정말로 도요히사\n님에게 불려 갔는지……",
 "4739": "그걸 확인하는 거 아니야？",
 "4740": "그, 그렇군.",
 "4741": "도요히사 공과 당신은 직접\n얼굴을 마주하지 않았지요？",
 "4742": "분명 나는 도요히사의 【言】얼굴을\n보지 못했네【終】.",
 "4743": "나는 도요히사의 사자에게\n불려 나갔고……",
 "4744": "전선의 병사에게서 「진으로\n돌아가라」는 전언을 받았지.",
 "4745": "역시 그랬군요……。",
 "4746": "말씀 감사합니다.",
 "4747": "이건……。",
 "4748": "아아, 누군가가 시마즈대를\n모함하려 하고 있다.",
 "4749": "그건 확실하다.",
 "4750": "그럼\n【注】고바야카와 님한테【終】 가서,",
 "4751": "시마즈대를 믿을 수 있다고\n전하자.",
 "4752": "그렇군.\n이걸로 움직여 줄 것이다.",
 "4753": "역시 오르막길은 힘들다……。",
 "4754": "기다려 줘, 다마……。",
 "4755": "에엣, 또 숨차？",
 "4756": "아이 참……。",
 "4757": "주군은 천천히 와도 돼.",
 "4758": "나 먼저 고바야카와 님한테……",
 "4759": "기다려！",
 "4760": "잠깐, 당신！",
 "4761": "주군！　방금 그 닌자, 봤어？",
 "4762": "예전에 시마즈대 진지 뒤에서\n본 닌자랑 닮았어.",
 "4763": "왜 이런 곳에\n있었던 걸까？",
 "4764": "적 닌자가 근처에 있다면,",
 "4765": "고바야카와 공에게도\n알리는 게 좋겠군.",
 "4766": "………………그래서\n고바야카와 공은 어디 있지？",
 "4767": "그러고 보니……。",
 "4768": "어쩔래？\n근처엔 없는 것 같은데……。",
 "4769": "……먼저 【注】요시쓰구에게【終】\n돌아가자.",
 "4770": "요시쓰구의 의견도 들어 보고\n싶다.",
 "4771": "고바야카와대의 진이다.",
 "4772": "대다이묘답게 훌륭한 진을\n산꼭대기에 차렸다.",
 "4773": "왜 낫일까？",
 "4774": "적을 베어 넘긴다……는\n뜻이 담겨 있다고 한다.",
 "4775": "흐응……。",
 "4776": "말장난만 하는 줄 알았더니\n의외로 박식하네.",
 "4777": "【心】（……순순히 기뻐할 수가\n없다）【終】",
 "4778": "기슭의 모습이\n잘 보이겠군.",
 "4779": "이 울타리, 더 작게……。",
 "4780": "아～, 미안하다.",
 "4781": "해자가 있다.",
 "4782": "갓 판 해자로군.",
 "4783": "방금 건 실패였군.",
 "4784": "시마즈를 믿을 수 있는 이유",
 "4785": "도요히사 필체의 수수께끼",
 "4786": "도요히사가 칠칠치 못해서",
 "4787": "요시히로가 치우는 걸 잊어서",
 "4788": "일부러 발견하게 하려고",
 "4789": "자, 요시쓰구는 어디에……。",
 "4790": "미쓰나리로군？",
 "4791": "기다리고 있었다.",
 "4792": "왜 그러나……\n무슨 일이 있었나？",
 "4793": "내 예상보다\n싸움의 흐름이 빠르다.",
 "4794": "곧 나는 성가신 적을\n상대하게 될 것이다.",
 "4795": "네 정보가 의지가 된다.",
 "4796": "잡은 증거를 【注】사용【終】해서\n내게 보여 다오.",
 "4797": "내 눈은 빛을 잃었다.되도록\n자세한 설명을 부탁한다.",
 "4798": "아아, 물론이다.",
 "4799": "어수선한 분위기에\n휩싸여 있다."
}